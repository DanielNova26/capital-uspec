# Correo / Gmail OAuth personal. Configurar estos valores como secretos del backend.
GMAIL_OAUTH_CLIENT_ID=""
GMAIL_OAUTH_CLIENT_SECRET=""
# Debe coincidir exactamente con el URI autorizado en Google Cloud.
GMAIL_OAUTH_REDIRECT_URI="https://us-central1-TU_PROYECTO.cloudfunctions.net/correoGmailCallback"

# Correo / Microsoft 365 (Exchange Online) OAuth delegado.
# La aplicación debe admitir "Cuentas de cualquier directorio organizacional".
# El backend utiliza la autoridad multiinquilino /organizations; no requiere
# fijar un tenant porque cada buzón conserva el de su organización de origen.
MICROSOFT_OAUTH_CLIENT_ID=""
MICROSOFT_OAUTH_CLIENT_SECRET=""
# Debe coincidir exactamente con el URI Web registrado en Microsoft Entra.
MICROSOFT_OAUTH_REDIRECT_URI="https://us-central1-TU_PROYECTO.cloudfunctions.net/correoMicrosoftCallback"
# Generar 32 bytes base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CORREO_TOKEN_ENCRYPTION_KEY=""

# WhatsApp OpenWA. La base debe incluir /api, por ejemplo https://openwa.midominio.com/api
# Las variables WHATSAPP_* se conservan como respaldo de migración hasta que
# cada empresa guarde su configuración desde Administración > WhatsApp.
WHATSAPP_PROVIDER="openwa"
WHATSAPP_API_BASE_URL=""
WHATSAPP_API_KEY=""
WHATSAPP_SESSION_ID=""
WHATSAPP_DEFAULT_COUNTRY_CODE="57"
# Clave exclusiva recomendada para cifrar la API key almacenada en Firestore.
# Si queda vacía, se usa CORREO_TOKEN_ENCRYPTION_KEY.
WHATSAPP_CONFIG_ENCRYPTION_KEY=""
