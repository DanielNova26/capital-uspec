rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null
        && request.auth.token.authVersion == 2
        && request.auth.token.userDocId is string;
    }

    function currentUserPath() {
      return /databases/$(database)/documents/TBL_USUARIOS/$(request.auth.token.userDocId);
    }

    function currentUser() {
      return get(currentUserPath()).data;
    }

    // Espejo de `isDeveloperUser` en lib/utils/user_company.dart. La app
    // reconoce al desarrollador también por un `roleId` que TERMINA en
    // `_desarrollador` (el real es `EMPRESA_001_rutas_desarrollador`, y su
    // `role` es `rutas_desarrollador`, que no está en la lista corta). Sin
    // esto la app lo trataba como desarrollador y las reglas no: Admin le
    // decía "permission-denied" al cambiar un rol (11 sep 2026).
    function esRolDeDesarrollo(valor) {
      return valor is string
        && (valor in ['desarrollador', 'developer', 'superadmin', 'administrador_sistema']
          || valor.matches('.*_(desarrollador|developer)$'));
    }

    // `let` y no seis `currentUser()`: cada llamada cuenta como expresiones
    // evaluadas y las reglas tienen un tope de 1000 por petición. Con las
    // llamadas repetidas el emulador ya avisaba "maximum of 1000 expressions".
    // La cuenta apagada va al final: quien no es desarrollador no llega ahí.
    function isDeveloper() {
      let u = currentUser();
      return isSignedIn()
        && (
          ('desarrollador' in u && u.desarrollador == true)
          || ('developer' in u && u.developer == true)
          || ('role' in u && esRolDeDesarrollo(u.role))
          || ('rol' in u && esRolDeDesarrollo(u.rol))
          || ('roleKey' in u && esRolDeDesarrollo(u.roleKey))
          || ('roleId' in u && esRolDeDesarrollo(u.roleId))
        )
        && !cuentaInhabilitada(u);
    }

    // Desarrollo de la raíz actuando sobre [empresaId], para las reglas que
    // no pasan por `belongsToCompany`: tampoco entra a una empresa donde está
    // inhabilitado (en la app, AccessGuard lo comprueba antes que el rol).
    function isDeveloperFor(empresaId) {
      return isDeveloper() && habilitadaEn(currentUser(), empresaId);
    }

    // ── Personal inhabilitado (28 sep 2026) ───────────────────────────────
    // Espejo de `personaHabilitadaEn` en lib/utils/user_company.dart y de
    // functions/src/acceso.ts. La app ya no deja entrar a un inhabilitado,
    // pero con la sesión abierta (o una app vieja, sin el vigilante) seguía
    // leyendo y escribiendo los datos de la empresa directo en Firestore.
    // Solo cuentan los textos: un valor que no es texto se lee como vacío.
    function estadoTexto(valor) {
      return valor is string ? valor.trim().lower() : '';
    }

    // Cuenta apagada para toda la app: `activo: false` (Administración) o un
    // `estado` global (en registros viejos, `status`) distinto de activo.
    function cuentaInhabilitada(u) {
      let estado = estadoTexto(u.get('estado', ''));
      let global = estado != '' ? estado : estadoTexto(u.get('status', ''));
      return u.get('activo', true) == false
        || !(global in ['', 'activo', 'active']);
    }

    // Apagada en [empresaId]: por un traslado (`activo: false` en el bloque
    // de la empresa) o por Talento Humano (`estadoLaboral`, o si no hay,
    // `estado`, igual a inactivo).
    function apagadaEnEmpresa(u, empresaId) {
      let detalle = u.get('empresasDetalle', {});
      let bloque = detalle is map ? detalle.get(empresaId, {}) : {};
      let b = bloque is map ? bloque : {};
      let laboral = estadoTexto(b.get('estadoLaboral', ''));
      return b.get('activo', true) == false
        || (laboral != '' ? laboral : estadoTexto(b.get('estado', ''))) == 'inactivo';
    }

    // Sin empresa (una escritura que no la trae) solo se mira la cuenta.
    function habilitadaEn(u, empresaId) {
      return !cuentaInhabilitada(u)
        && (!(empresaId is string) || !apagadaEnEmpresa(u, empresaId));
    }

    // Una consulta de un módulo debe venir filtrada por empresa. Firestore
    // evalúa esta condición contra cada documento devuelto, por lo que una
    // consulta sin ese filtro falla en lugar de filtrar datos en el servidor.
    // Pertenecer no basta: quien está inhabilitado en la empresa, o tiene la
    // cuenta apagada, no entra a sus datos, aunque sea desarrollador. Va al
    // final porque es lo más largo, y el rechazo de una empresa ajena no
    // llega hasta ahí.
    function belongsToCompany(empresaId) {
      let u = currentUser();
      return isSignedIn()
        && empresaId is string
        && empresaId.size() > 0
        && (
          ('empresas' in u && u.empresas is list && empresaId in u.empresas)
          || ('empresasDetalle' in u && u.empresasDetalle is map && empresaId in u.empresasDetalle)
          || ('empresaId' in u && u.empresaId == empresaId)
          || ('empresa' in u && u.empresa == empresaId)
          || isDeveloper()
        )
        && habilitadaEn(u, empresaId);
    }

    function interventoriaRolePath(empresaId) {
      return /databases/$(database)/documents/TBL_INTERVENTORIA_ROLES/$(empresaId + '_' + request.auth.token.userDocId);
    }

    function hasInterventoriaRole(empresaId, allowedRoles) {
      return belongsToCompany(empresaId)
        && exists(interventoriaRolePath(empresaId))
        && get(interventoriaRolePath(empresaId)).data.rol in allowedRoles;
    }

    function interventoriaConfigPath(empresaId) {
      return /databases/$(database)/documents/TBL_INTERVENTORIA_CONFIG/$(empresaId);
    }

    // Las empresas sin configuración conservan el flujo histórico. Cuando
    // Administración asigna programas y actas, el servidor exige que cada
    // acta nueva use una de esas plantillas; ocultarla en la UI no bastaría.
    function tipoActaInterventoriaPermitido(empresaId, data) {
      let path = interventoriaConfigPath(empresaId);
      return !exists(path)
        || !('tiposActaHabilitados' in get(path).data)
        || (
          get(path).data.tiposActaHabilitados is list
          && 'tipoActa' in data
          && data.tipoActa is string
          && data.tipoActa in get(path).data.tiposActaHabilitados
        );
    }

    function conservaTipoActaInterventoria(antes, despues) {
      return (
          !('tipoActa' in antes)
          && !('tipoActa' in despues)
        ) || (
          'tipoActa' in antes
          && 'tipoActa' in despues
          && antes.tipoActa == despues.tipoActa
        );
    }

    function visitasRolePath(empresaId) {
      return /databases/$(database)/documents/TBL_VISITAS_ROLES/$(empresaId + '_' + request.auth.token.userDocId);
    }

    // El rol sin volver a mirar la empresa: solo para usar DESPUÉS de un
    // `belongsToCompany` de la misma empresa. Cada `belongsToCompany` cuesta
    // expresiones (28 sep 2026: además mira si la persona está habilitada) y
    // `administraVisitasArea` llegaba a evaluarlo cuatro veces.
    function rolVisitasEn(empresaId, allowedRoles) {
      return exists(visitasRolePath(empresaId))
        && get(visitasRolePath(empresaId)).data.rol in allowedRoles;
    }

    function hasVisitasRole(empresaId, allowedRoles) {
      return belongsToCompany(empresaId)
        && rolVisitasEn(empresaId, allowedRoles);
    }

    // Las funciones que terminan en `En` no vuelven a mirar la empresa: se
    // usan dentro de una regla que ya pasó por `belongsToCompany`.
    function administraVisitasEn(empresaId) {
      return isDeveloper() || isDeveloperIn(empresaId)
        || rolVisitasEn(empresaId, ['jefe', 'gerencia'])
        || esGerenciaPorFicha(empresaId);
    }

    function administraVisitas(empresaId) {
      return belongsToCompany(empresaId) && administraVisitasEn(empresaId);
    }

    // Gerencia (26 sep 2026): "es el jefe de todos, puede ver absolutamente
    // todo y hacer todos los formatos". En Visitas tiene el alcance de
    // Desarrollo: todas las áreas y el maestro de ubicaciones. El rol lo da
    // Desarrollo; Gerencia no se nombra a sí misma ni a otra Gerencia.
    // 27 sep 2026: también por la ficha, sin rol asignado. Quien tiene cargo
    // de Gerencia ("Gerencia", "Gerente general"…) o el rol de la app
    // gerencia / gerente es Gerencia en Visitas. Espejo de
    // `resolverRolVisitas` y `VisitasService.cargoDeFicha`: el cargo es el
    // primero con texto entre cargoNombre y cargo de la empresa, y luego los
    // de la raíz. Va siempre al final de los `||`: es lo más caro y las
    // reglas tienen un tope de 1000 expresiones por petición.
    function gerenciaVisitasEn(empresaId) {
      return rolVisitasEn(empresaId, ['gerencia'])
        || esGerenciaPorFicha(empresaId);
    }

    function esGerenciaVisitas(empresaId) {
      return belongsToCompany(empresaId) && gerenciaVisitasEn(empresaId);
    }

    function esCargoGerencia(valor) {
      return valor is string
        && valor.trim().lower().matches('(gerente|gerencia).*');
    }

    function primerTexto(a, b) {
      return a is string && a.trim().size() > 0 ? a : b;
    }

    // El cargo de la raíz solo cuenta si la raíz es de esta empresa (la
    // principal, o no hay principal escrita). Espejo de `raizEsDeEmpresa`
    // en lib/utils/user_company.dart: ser Gerente en una razón social no da
    // Gerencia en Visitas de la otra.
    function raizEsDeEmpresa(u, empresaId) {
      return u.get('empresaId', '') == empresaId
        || u.get('empresaId', '') == '';
    }

    function esGerenciaPorFicha(empresaId) {
      let u = currentUser();
      let d = u.get('empresasDetalle', {}).get(empresaId, {});
      let cargoRaiz = raizEsDeEmpresa(u, empresaId)
        ? primerTexto(u.get('cargoNombre', ''), u.get('cargo', ''))
        : '';
      return esCargoGerencia(primerTexto(d.get('cargoNombre', ''),
          primerTexto(d.get('cargo', ''), cargoRaiz)))
        || d.get('roleKey', '') in ['gerencia', 'gerente']
        || u.get('roleKey', '') in ['gerencia', 'gerente']
        || u.get('role', '') in ['gerencia', 'gerente'];
    }

    function areaVisitasUsuario(empresaId, userId) {
      let path = /databases/$(database)/documents/TBL_VISITAS_ROLES/$(empresaId + '_' + userId);
      return exists(path) && 'areaId' in get(path).data
        ? get(path).data.areaId : '';
    }

    function administraVisitasAreaEn(empresaId, areaId) {
      return isDeveloper() || isDeveloperIn(empresaId)
        || (areaId is string && areaId.size() > 0
          && rolVisitasEn(empresaId, ['jefe'])
          && areaVisitasUsuario(empresaId, request.auth.token.userDocId) == areaId)
        || gerenciaVisitasEn(empresaId);
    }

    function administraVisitasArea(empresaId, areaId) {
      return belongsToCompany(empresaId)
        && administraVisitasAreaEn(empresaId, areaId);
    }

    // Administra (Desarrollo, jefe, Gerencia) o tiene cualquier otro rol.
    // El rol (un get) antes que Desarrollo y Gerencia por ficha (~60
    // expresiones cada uno): el profesional no paga lo que no le toca.
    function participaEnVisitas(empresaId) {
      return belongsToCompany(empresaId)
        && (rolVisitasEn(empresaId,
            ['jefe', 'gerencia', 'profesional', 'consulta', 'firmante'])
          || isDeveloper() || isDeveloperIn(empresaId)
          || esGerenciaPorFicha(empresaId));
    }

    // Rol del módulo de Planillas de Pago para la empresa activa.
    //
    // Vive en el propio usuario (`empresasDetalle[empresa].rolPlanillas`, o
    // `rolPlanillas` en la raíz), que es donde lo lee la aplicación.
    //
    // 28 sep 2026 (contrato de Admin): el nivel de la empresa manda, también
    // vacío (se lo quitaron: no se recupera la raíz), y la raíz solo cuenta
    // si es de esta empresa (la principal). Antes daba el rol de la raíz en
    // cualquier empresa y fallaba si la ficha no tenía `empresasDetalle`.
    function planillasRole(empresaId) {
      let u = currentUser();
      let detalle = u.get('empresasDetalle', {});
      let bloque = detalle is map ? detalle.get(empresaId, {}) : {};
      let propio = bloque is map ? bloque.get('rolPlanillas', null) : null;
      let raiz = u.get('rolPlanillas', '');
      return isSignedIn() && propio is string
        ? propio
        : (raizEsDeEmpresa(u, empresaId) && raiz is string ? raiz : '');
    }

    // Desarrollador marcado DENTRO de la empresa (`empresasDetalle[e].roleKey`
    // o `roleId` terminado en `_desarrollador`), que es como lo reconoce la
    // aplicación. `isDeveloper()` solo mira la raíz del usuario, así que a
    // quien esté marcado por empresa el servidor le deniega aunque la pantalla
    // le enseñe el botón.
    //
    // Cada acceso va precedido de un `in`: en las reglas, leer un campo que no
    // existe lanza error, y el `&&` se detiene antes de llegar ahí.
    function isDeveloperIn(empresaId) {
      let u = currentUser();
      return isSignedIn()
        && 'empresasDetalle' in u
        && u.empresasDetalle is map
        && empresaId in u.empresasDetalle
        && u.empresasDetalle[empresaId] is map
        && (
          ('roleKey' in u.empresasDetalle[empresaId]
            && esRolDeDesarrollo(u.empresasDetalle[empresaId].roleKey))
          || ('roleId' in u.empresasDetalle[empresaId]
            && esRolDeDesarrollo(u.empresasDetalle[empresaId].roleId))
        )
        && habilitadaEn(u, empresaId);
    }

    function hasPlanillasRole(empresaId, allowedRoles) {
      return belongsToCompany(empresaId)
        && (
          isDeveloper()
          || isDeveloperIn(empresaId)
          || planillasRole(empresaId) in allowedRoles
        );
    }

    function correoRolePath(empresaId) {
      return /databases/$(database)/documents/TBL_CORREO_ROLES/$(empresaId + '_' + request.auth.token.userDocId);
    }

    // ── Roles configurables por módulo (28 sep 2026, trabajo de Codex) ─────
    // Espejo de `userHasApp(u, 'admindashboard', empresaId)` en
    // lib/utils/user_company.dart: con módulos por empresa solo cuenta la
    // lista de la empresa (o la raíz si es la principal y no hay lista
    // propia); sin esa marca, la raíz y la de la empresa.
    function tieneAppAdminEn(empresaId) {
      let u = currentUser();
      let detalle = u.get('empresasDetalle', {});
      let bloque = detalle is map ? detalle.get(empresaId, {}) : {};
      let propias = bloque is map ? bloque.get('apps', null) : null;
      let raiz = u.get('apps', []);
      let admin = ['admindashboard', 'admin'];
      return u.get('appsPorEmpresa', false) == true
        ? (propias is list
          ? propias.hasAny(admin)
          : (raizEsDeEmpresa(u, empresaId) && raiz is list && raiz.hasAny(admin)))
        : ((raiz is list && raiz.hasAny(admin))
          || (propias is list && propias.hasAny(admin)));
    }

    // Administrador de Correspondencia por su asignación canónica. Sin mirar
    // la empresa: se usa después de un `belongsToCompany`.
    function esAdminCorreoEn(empresaId) {
      return exists(correoRolePath(empresaId))
        && get(correoRolePath(empresaId)).data.rol in [
          'administrador', 'admin', 'manager', 'gestor', 'superadmin',
          'desarrollador', 'developer'
        ];
    }

    // Quién crea, edita y asigna roles de módulo: igual que
    // `canManageModuleRoles` del cliente (Desarrollo, o la app Admin en la
    // empresa) y, para los de Correspondencia, su administrador del módulo.
    function gestionaRolesDeModulo(empresaId, moduleId) {
      return belongsToCompany(empresaId)
        && (tieneAppAdminEn(empresaId)
          || (moduleId == 'correodashboard' && esAdminCorreoEn(empresaId))
          || isDeveloper() || isDeveloperIn(empresaId));
    }

    function esRolDeModulo(data) {
      return data.get('type', '') == 'module_role';
    }

    // Contrato de Codex para `TBL_ROLES/{empresaId}_mod_{módulo}_{nombre}`.
    function rolDeModuloValido(docId, data) {
      return data.get('empresaId', '') is string
        && data.empresaId.size() > 0
        && docId.size() > data.empresaId.size() + 5
        && docId[0:data.empresaId.size() + 5] == data.empresaId + '_mod_'
        && data.get('moduleId', '') in ['correodashboard',
          'planillaspagodashboard', 'bibliotecadocumentaldashboard',
          'tareasdashboard']
        && data.get('enabled', null) is bool
        && data.get('revision', null) is int && data.revision >= 1
        && data.get('nombre', '') is string
        && data.nombre.size() > 0 && data.nombre.size() <= 120;
    }

    // Asignación canónica de Correspondencia que escribe Admin: su id es
    // `{empresa}_{usuario}` y el nivel es uno de los cuatro del módulo.
    function asignacionCorreoValida(docId, data) {
      return data.get('empresaId', '') is string
        && data.get('usuarioId', '') is string
        && docId == data.empresaId + '_' + data.usuarioId
        && data.get('rol', '') in ['visor', 'operador', 'clasificador',
          'administrador'];
    }

    function isCorreoAdmin(empresaId) {
      return belongsToCompany(empresaId)
        && exists(correoRolePath(empresaId))
        && get(correoRolePath(empresaId)).data.rol in [
          'administrador', 'admin', 'manager', 'gestor', 'superadmin',
          'desarrollador', 'developer'
        ];
    }

    // Credenciales, intentos y retos de recuperación son exclusivamente del
    // backend. Nunca se exponen al cliente, ni siquiera a administradores.
    match /TBL_AUTH_CREDENTIALS/{document=**} {
      allow read, write: if false;
    }
    match /TBL_AUTH_LOGIN_ATTEMPTS/{document=**} {
      allow read, write: if false;
    }
    match /TBL_AUTH_RECOVERY_CHALLENGES/{document=**} {
      allow read, write: if false;
    }
    match /TBL_AUTH_ADMIN_AUDIT/{document=**} {
      allow read, write: if false;
    }

    // ── Nutrición (28 sep 2026) ───────────────────────────────────────────
    // Pacientes, valoraciones, patologías e historial son datos de salud y
    // solo pedían sesión: cualquiera, de cualquier empresa, los leía y
    // escribía. Ahora cada documento es de su empresa (y de nadie
    // inhabilitado en ella) y no cambia de empresa. `get` de un id que no
    // existe responde vacío: la app pregunta por la firma, el paciente o la
    // plantilla antes de crearlos.
    //
    // No se exige tener el módulo asignado: la lista de módulos vive en la
    // ficha del usuario, que todavía puede escribir cualquiera (P0 de
    // Seguridad transversal). Las citas las consulta el calendario de
    // Inicio de todo el personal.
    function nutricionDeSuEmpresa() {
      return request.method == 'create'
        ? belongsToCompany(request.resource.data.empresaId)
        : belongsToCompany(resource.data.empresaId)
          && (request.method != 'update'
            || request.resource.data.empresaId == resource.data.empresaId);
    }

    match /TBL_PACIENTES/{docId} {
      allow get: if resource == null || nutricionDeSuEmpresa();
      allow list, create, update, delete: if nutricionDeSuEmpresa();
    }
    match /TBL_VALORACIONES_NUTRICION/{docId} {
      allow get: if resource == null || nutricionDeSuEmpresa();
      allow list, create, update, delete: if nutricionDeSuEmpresa();
    }
    match /TBL_MEDICIONES_NUTRICION/{docId} {
      allow get: if resource == null || nutricionDeSuEmpresa();
      allow list, create, update, delete: if nutricionDeSuEmpresa();
    }
    match /TBL_PATOLOGIAS/{docId} {
      allow get: if resource == null || nutricionDeSuEmpresa();
      allow list, create, update, delete: if nutricionDeSuEmpresa();
    }
    match /TBL_DIETAS/{docId} {
      allow get: if resource == null || nutricionDeSuEmpresa();
      allow list, create, update, delete: if nutricionDeSuEmpresa();
    }
    match /TBL_ASIGNACIONES_DIETA/{docId} {
      allow get: if resource == null || nutricionDeSuEmpresa();
      allow list, create, update, delete: if nutricionDeSuEmpresa();
    }
    match /TBL_CARNETS_NUTRICION/{docId} {
      allow get: if resource == null || nutricionDeSuEmpresa();
      allow list, create, update, delete: if nutricionDeSuEmpresa();
    }
    match /TBL_MENUS/{docId} {
      allow get: if resource == null || nutricionDeSuEmpresa();
      allow list, create, update, delete: if nutricionDeSuEmpresa();
    }
    match /TBL_DERIVACIONES_NUTRICION/{docId} {
      allow get: if resource == null || nutricionDeSuEmpresa();
      allow list, create, update, delete: if nutricionDeSuEmpresa();
    }
    match /TBL_ALERTAS_NUTRICION/{docId} {
      allow get: if resource == null || nutricionDeSuEmpresa();
      allow list, create, update, delete: if nutricionDeSuEmpresa();
    }
    match /TBL_FIRMAS/{docId} {
      allow get: if resource == null || nutricionDeSuEmpresa();
      allow list, create, update, delete: if nutricionDeSuEmpresa();
    }
    match /TBL_EVIDENCIAS_NUTRICION/{docId} {
      allow get: if resource == null || nutricionDeSuEmpresa();
      allow list, create, update, delete: if nutricionDeSuEmpresa();
    }
    match /TBL_PLANTILLAS_MENUS/{docId} {
      allow get: if resource == null || nutricionDeSuEmpresa();
      allow list, create, update, delete: if nutricionDeSuEmpresa();
    }
    match /TBL_INGREDIENTES/{docId} {
      allow get: if resource == null || nutricionDeSuEmpresa();
      allow list, create, update, delete: if nutricionDeSuEmpresa();
    }
    match /TBL_DIRECTORIO_NUTRICION/{docId} {
      allow get: if resource == null || nutricionDeSuEmpresa();
      allow list, create, update, delete: if nutricionDeSuEmpresa();
    }
    match /TBL_CITAS_NUTRICION/{docId} {
      allow get: if resource == null || nutricionDeSuEmpresa();
      allow list, create, update, delete: if nutricionDeSuEmpresa();
    }

    // Historial del paciente: `{empresa}-{paciente}/registros`. La consulta
    // no filtra por empresa (lee los últimos 20 del paciente), así que la
    // empresa sale del id: los códigos de empresa no llevan guion
    // (`codigoEmpresaDesdeNombre`). Se agrega y no se reescribe.
    match /TBL_HISTORIAL_NUTRICION/{historialId}/registros/{registroId} {
      allow read: if belongsToCompany(historialId.split('-')[0]);
      allow create: if belongsToCompany(historialId.split('-')[0])
        && request.resource.data.empresaId == historialId.split('-')[0];
      allow update, delete: if false;
    }

    // Las credenciales de WhatsApp se administran exclusivamente mediante
    // Cloud Functions. Ni siquiera un cliente autenticado puede leer el
    // ciphertext ni alterar la URL, sesión o módulos habilitados.
    // Los listados conservan su colección histórica para no romper reglas de
    // Correo, pero sólo Administración puede modificarlos mediante Functions.
    match /TBL_CORREO_LISTADOS/{document=**} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Los enlaces Token DIAN y su auditoria solo se exponen mediante
    // Cloud Functions. Esto impide que un cliente lea incluso el ciphertext.
    match /TBL_DIAN_TOKENS/{document=**} {
      allow read, write: if false;
    }
    match /TBL_DIAN_TOKEN_ACCESOS/{document=**} {
      allow read, write: if false;
    }
    match /TBL_DIAN_TOKEN_CONFIG/{document=**} {
      allow read, write: if false;
    }

    // Las eliminaciones de Interventoría requieren una solicitud y aprobación
    // en Cloud Functions. El cliente puede crear/editar, pero nunca borrar.
    // `get` de un documento que NO existe: `resource` es nulo y la regla de
    // pertenencia falla con error, que Firestore convierte en denegado. El
    // registro de un acta lee su id nuevo dentro de una transacción para no
    // crearla dos veces, y con esa regla ningún registrador pudo guardar
    // actas desde el 11 sep 2026 (probado en interventoria_visitas.rules.js).
    // Leer un id inexistente no expone nada: solo dice que no existe.
    match /TBL_INTERVENTORIA_VISITAS/{docId} {
      allow get: if resource == null || belongsToCompany(resource.data.empresaId);
      allow list: if belongsToCompany(resource.data.empresaId);
      allow create: if belongsToCompany(request.resource.data.empresaId)
        && tipoActaInterventoriaPermitido(
          request.resource.data.empresaId,
          request.resource.data
        );
      allow update: if resource.data.empresaId == request.resource.data.empresaId
        && belongsToCompany(resource.data.empresaId)
        && (
          conservaTipoActaInterventoria(
            resource.data,
            request.resource.data
          )
          || tipoActaInterventoriaPermitido(
            request.resource.data.empresaId,
            request.resource.data
          )
        );
      allow delete: if false;
    }
    match /TBL_INTERVENTORIA_HALLAZGOS/{docId} {
      allow get: if resource == null || belongsToCompany(resource.data.empresaId);
      allow list: if belongsToCompany(resource.data.empresaId);
      allow create: if belongsToCompany(request.resource.data.empresaId);
      allow update: if resource.data.empresaId == request.resource.data.empresaId
        && belongsToCompany(resource.data.empresaId);
      // Guardar la revisión de un acta sincroniza sus hallazgos: crea los
      // nuevos y BORRA los que ya no tienen observación y nunca tuvieron
      // tarea. Con `delete: if false` ese batch entero fallaba y el borrador
      // no se guardaba ("permission-denied", 11 sep 2026). Solo se abre ese
      // caso: un hallazgo con tarea asignada sigue sin poderse borrar desde
      // el cliente (lo borra la función de eliminación con su aprobación).
      allow delete: if belongsToCompany(resource.data.empresaId)
        && 'fuente' in resource.data && resource.data.fuente == 'acta'
        && (!('tareaId' in resource.data) || resource.data.tareaId == '');
    }
    match /TBL_INTERVENTORIA_SOLICITUDES_ELIMINACION/{docId} {
      allow read: if belongsToCompany(resource.data.empresaId);
      allow write: if false;
    }

    // El módulo de visitas comparte empresa, pero cada profesional solo puede
    // responder sus propias visitas. Las asignaciones y formatos pertenecen
    // al jefe; el rol no se puede autoasignar usando el fallback general.
    // `get` de un doc que no existe: `resource` es null y evaluar
    // `resource.data` niega la lectura entera. La app pregunta por id si la
    // persona tiene rol, si existe el formato SST o la ubicación del
    // subcentro, y con la regla anterior recibía permission-denied cuando
    // la respuesta era "no existe" (21 sep 2026, "no me quiere cargar").
    // Mismo arreglo que Interventoría el 11 sep.
    match /TBL_VISITAS_ROLES/{docId} {
      allow get: if resource == null
        || (belongsToCompany(resource.data.empresaId)
          && (resource.data.userId == request.auth.token.userDocId
            || administraVisitasEn(resource.data.empresaId)));
      allow list: if belongsToCompany(resource.data.empresaId)
        && (resource.data.userId == request.auth.token.userDocId
          || administraVisitasEn(resource.data.empresaId));
      allow create: if belongsToCompany(request.resource.data.empresaId)
        && docId == request.resource.data.empresaId + '_' + request.resource.data.userId
        && request.resource.data.rol in ['jefe', 'profesional', 'consulta', 'firmante', 'gerencia']
        && request.resource.data.areaId is string
        && (isDeveloper() || isDeveloperIn(request.resource.data.empresaId)
          || (request.resource.data.rol == 'profesional'
            && administraVisitasAreaEn(request.resource.data.empresaId,
              request.resource.data.areaId))
          || (request.resource.data.rol != 'gerencia'
            && request.resource.data.userId != request.auth.token.userDocId
            && gerenciaVisitasEn(request.resource.data.empresaId)));
      allow update: if resource.data.empresaId == request.resource.data.empresaId
        && resource.data.userId == request.resource.data.userId
        && belongsToCompany(resource.data.empresaId)
        && request.resource.data.rol in ['jefe', 'profesional', 'consulta', 'firmante', 'gerencia']
        && request.resource.data.areaId is string
        && (isDeveloper() || isDeveloperIn(resource.data.empresaId)
          || (resource.data.rol == 'profesional'
            && request.resource.data.rol == 'profesional'
            && resource.data.areaId == request.resource.data.areaId
            && resource.data.userId != request.auth.token.userDocId
            && administraVisitasAreaEn(resource.data.empresaId,
              resource.data.areaId))
          || (resource.data.rol != 'gerencia'
            && request.resource.data.rol != 'gerencia'
            && resource.data.userId != request.auth.token.userDocId
            && gerenciaVisitasEn(resource.data.empresaId)));
      allow delete: if belongsToCompany(resource.data.empresaId)
        && (isDeveloper() || isDeveloperIn(resource.data.empresaId)
          || (resource.data.rol == 'profesional'
            && resource.data.userId != request.auth.token.userDocId
            && administraVisitasAreaEn(resource.data.empresaId,
              resource.data.areaId))
          || (resource.data.rol != 'gerencia'
            && resource.data.userId != request.auth.token.userDocId
            && gerenciaVisitasEn(resource.data.empresaId)));
    }

    // Grupos de profesionales con sus establecimientos (25 sep 2026). Los
    // arma el jefe de cada área para su área; no se cambian de área (se
    // borra y se crea otro), así un jefe no se lleva el grupo de otro.
    match /TBL_VISITAS_GRUPOS/{docId} {
      allow get: if resource == null
        || participaEnVisitas(resource.data.empresaId);
      allow list: if participaEnVisitas(resource.data.empresaId);
      allow create: if administraVisitasArea(request.resource.data.empresaId,
          request.resource.data.areaId);
      allow update: if resource.data.empresaId == request.resource.data.empresaId
        && resource.data.areaId == request.resource.data.areaId
        && administraVisitasArea(resource.data.empresaId, resource.data.areaId);
      allow delete: if administraVisitasArea(resource.data.empresaId,
          resource.data.areaId);
    }

    match /TBL_VISITAS_FORMATOS/{docId} {
      allow get: if resource == null
        || participaEnVisitas(resource.data.empresaId);
      // Jefe y profesional (los de todos los días) primero: los chequeos de
      // Desarrollo y Gerencia cuestan ~60 expresiones cada uno (28 sep 2026).
      allow list: if belongsToCompany(resource.data.empresaId)
        && ((rolVisitasEn(resource.data.empresaId, ['jefe', 'profesional'])
            && resource.data.areaId == areaVisitasUsuario(
              resource.data.empresaId, request.auth.token.userDocId))
          || rolVisitasEn(resource.data.empresaId, ['consulta', 'gerencia'])
          || isDeveloper() || isDeveloperIn(resource.data.empresaId)
          || esGerenciaPorFicha(resource.data.empresaId));
      allow create: if administraVisitasArea(request.resource.data.empresaId,
          request.resource.data.areaId);
      // 28 sep 2026: un formato se puede pasar a otro departamento ("SST /
      // HSE" no es un departamento: el de SST lo lleva Talento Humano). Hay
      // que administrar los dos, así que en la práctica solo Desarrollo y
      // Gerencia lo mueven; el jefe sigue en el suyo.
      allow update: if resource.data.empresaId == request.resource.data.empresaId
        && administraVisitasArea(resource.data.empresaId, resource.data.areaId)
        && (resource.data.areaId == request.resource.data.areaId
          || administraVisitasAreaEn(resource.data.empresaId,
            request.resource.data.areaId));
      allow delete: if false;
    }

    // El firmante del establecimiento (25 sep 2026) lee y firma solo las
    // visitas donde el profesional lo designó (`firmanteEstablecimientoId`).
    // 28 sep 2026: el profesional (sus propias visitas) va PRIMERO y por su
    // lado. Iba al final, después de Desarrollo, jefe y Gerencia: a él se le
    // evaluaba todo eso y la consulta de "Mis visitas" pasaba el tope de 1000
    // expresiones (`belongsToCompany` cuesta ~125 y cada chequeo de
    // administrador ~60), así que Firestore la negaba con permission-denied.
    // Lo barato primero: el dueño de la visita, su rol y luego la empresa.
    match /TBL_VISITAS/{docId} {
      allow get: if resource == null
        || esVisitaPropiaDelProfesional()
        || (belongsToCompany(resource.data.empresaId)
          && (esFirmanteDeVisita()
            || administraVisitasAreaEn(resource.data.empresaId, resource.data.areaId)
            || rolVisitasEn(resource.data.empresaId, ['consulta'])));
      allow list: if esVisitaPropiaDelProfesional()
        || (belongsToCompany(resource.data.empresaId)
          && (esFirmanteDeVisita()
            || administraVisitasAreaEn(resource.data.empresaId, resource.data.areaId)
            || rolVisitasEn(resource.data.empresaId, ['consulta'])));
      allow create: if administraVisitasArea(request.resource.data.empresaId,
          request.resource.data.areaId)
        && request.resource.data.asignadoPorId == request.auth.token.userDocId
        && request.resource.data.estado == 'programada'
        && asignacionVisitaValida();
      // 17 sep 2026: reprogramar, encabezado del formato al iniciar, tablas y
      // firmas mientras está en curso. Las firmas van con la visita en curso
      // y NO en el cierre: el cierre solo cambia estado, fin y resultado, así
      // una firma nunca se estampa "al cerrar" sin que el profesional la
      // haya visto antes.
      // 28 sep 2026: la visita se programa sin formato y el profesional lo
      // fija al iniciarla; se inicia y se cierra el día programado; el
      // profesional ya no reprograma: pide el cambio de fecha y el jefe lo
      // aprueba o lo rechaza.
      allow update: if resource.data.empresaId == request.resource.data.empresaId
        && resource.data.profesionalId == request.resource.data.profesionalId
        // La empresa se mira una vez aquí y no en cada rama: cada
        // `belongsToCompany` cuesta expresiones y las reglas tienen un tope
        // de 1000 por petición (28 sep 2026).
        && belongsToCompany(resource.data.empresaId)
        // Lo barato primero (estado, dueño): los roles hacen get() y cuentan
        // contra el tope; con el orden anterior un rechazo llegaba al límite.
        && (
          // El profesional con su propia visita va primero (28 sep 2026):
          // es el caso de todos los días y así no paga los chequeos de
          // administrador, que lo llevaban al tope de expresiones.
          (resource.data.profesionalId == request.auth.token.userDocId
            && rolVisitasEn(resource.data.empresaId, ['profesional'])
            && (
              ((resource.data.estado == 'programada'
                  || resource.data.estado == 'en_curso')
                && esSolicitudFechaDelProfesional())
              || (resource.data.estado == 'programada'
                && request.resource.data.estado == 'en_curso'
                && enElDiaDeLaVisita()
                && request.resource.data.get('formatoId', '') != ''
                && (request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['estado', 'inicio', 'responsableEstablecimiento',
                      'ciudad', 'cargoProfesional', 'updatedAt'])
                  || (resource.data.get('formatoId', '') == ''
                    && request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['estado', 'inicio', 'responsableEstablecimiento',
                        'ciudad', 'cargoProfesional', 'formatoId',
                        'formatoNombre', 'formatoAsignado', 'updatedAt'])
                    && formatoDeVisitaValido(request.resource.data))))
              || (resource.data.estado == 'en_curso'
                && request.resource.data.estado == 'en_curso'
                && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['respuestas', 'tablas', 'observacionGeneral',
                    'responsableEstablecimiento', 'ciudad', 'cargoProfesional',
                    'firmaProfesional', 'firmaEstablecimiento',
                    'firmanteEstablecimientoId', 'evidenciasAdicionales',
                    'updatedAt'])
                && firmaVisitaSinCambiosDeContenido())
              || (resource.data.estado == 'en_curso'
                && request.resource.data.estado == 'terminada'
                && enElDiaDeLaVisita()
                && request.resource.data.cerradaPor == request.auth.token.userDocId
                && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['estado', 'fin', 'cumplimiento', 'tareasCreadas',
                    'cerradaPor', 'updatedAt']))
            ))
          // Jefe del departamento, Desarrollo o Gerencia.
          || ((
            (resource.data.estado == 'programada'
              && (
                (request.resource.data.estado == 'cancelada'
                  && request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['estado', 'motivoCancelacion', 'updatedAt']))
                || esReprogramacionDeVisita()
                || esRespuestaDeSolicitudFecha()
              ))
            || (resource.data.estado == 'en_curso'
              && (esRespuestaDeSolicitudFecha()
                || esAprobacionDeFechaEnCurso()))
          )
            && administraVisitasAreaEn(resource.data.empresaId, resource.data.areaId))
          // El firmante designado estampa su firma y nada más, con la
          // visita en curso y sin firma previa del establecimiento.
          || (resource.data.estado == 'en_curso'
            && request.resource.data.estado == 'en_curso'
            && esFirmanteDeVisita()
            && (!('firmaEstablecimiento' in resource.data)
              || resource.data.firmaEstablecimiento == null)
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['firmaEstablecimiento', 'updatedAt']))
        );
      allow delete: if false;
    }

    // La visita es del profesional que la pide y él tiene el rol en la
    // empresa. Primero la comparación (gratis), luego su rol (un get) y al
    // final la empresa, que es lo más caro.
    function esVisitaPropiaDelProfesional() {
      return resource.data.profesionalId == request.auth.token.userDocId
        && rolVisitasEn(resource.data.empresaId, ['profesional'])
        && belongsToCompany(resource.data.empresaId);
    }

    function esFirmanteDeVisita() {
      return 'firmanteEstablecimientoId' in resource.data
        && resource.data.firmanteEstablecimientoId is string
        && resource.data.firmanteEstablecimientoId.size() > 0
        && resource.data.firmanteEstablecimientoId == request.auth.token.userDocId;
    }

    // Al programar: el profesional tiene el rol en el departamento de la
    // visita. Desde el 28 sep 2026 va sin formato (lo elige el profesional
    // al iniciar); una app vieja que todavía lo mande sigue pasando si la
    // copia coincide con el formato guardado.
    function asignacionVisitaValida() {
      let v = request.resource.data;
      let profesional = /databases/$(database)/documents/TBL_VISITAS_ROLES/$(v.empresaId + '_' + v.profesionalId);
      return v.profesionalId is string && v.esPrueba is bool
        && ((v.get('formatoId', '') == '' && v.get('formatoAsignado', null) == null)
          || formatoDeVisitaValido(v))
        && ((exists(profesional)
          && get(profesional).data.rol == 'profesional'
          && areaVisitasUsuario(v.empresaId, v.profesionalId) == v.areaId)
          || (v.esPrueba && v.profesionalId == request.auth.token.userDocId));
    }

    // La copia del formato que lleva la visita es la del formato guardado,
    // de su empresa y de su departamento, y vigente (un borrador solo en
    // pruebas).
    function formatoDeVisitaValido(v) {
      let formato = /databases/$(database)/documents/TBL_VISITAS_FORMATOS/$(v.formatoId);
      return v.formatoId is string && v.formatoId.size() > 0
        && v.formatoAsignado is map
        && exists(formato)
        && get(formato).data.empresaId == v.empresaId
        && get(formato).data.estado != 'retirado'
        && v.formatoAsignado.empresaId == v.empresaId
        && v.areaId == get(formato).data.areaId
        && v.formatoAsignado.areaId == v.areaId
        && v.formatoAsignado.version == get(formato).data.version
        && v.formatoAsignado.items == get(formato).data.items
        && v.formatoAsignado.partes == get(formato).data.partes
        && v.formatoAsignado.tablas == get(formato).data.tablas
        && (v.get('esPrueba', false) == true || get(formato).data.estado == 'vigente');
    }

    // La visita se inicia y se cierra el día programado (28 sep 2026: "debe
    // terminarse el mismo día"). `fechaProgramada` es la medianoche local del
    // día, así que el día va de ahí a 24 horas después. Las pruebas no.
    function enElDiaDeLaVisita() {
      return resource.data.get('esPrueba', false) == true
        || (request.time >= resource.data.fechaProgramada
          && request.time < resource.data.fechaProgramada + duration.value(1, 'd'));
    }

    // El profesional pide el cambio de fecha: solo escribe la solicitud,
    // pendiente y a su nombre, y no si ya hay otra esperando respuesta.
    function esSolicitudFechaDelProfesional() {
      let s = request.resource.data.get('solicitudCambioFecha', null);
      return request.resource.data.estado == resource.data.estado
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['solicitudCambioFecha', 'updatedAt'])
        && s is map
        && s.get('estado', '') == 'pendiente'
        && s.get('porId', '') == request.auth.token.userDocId
        && s.get('fecha', null) is timestamp
        && resource.data.get('solicitudCambioFecha', {}).get('estado', '') != 'pendiente';
    }

    // El jefe la rechaza (o la responde) sin mover nada más.
    function esRespuestaDeSolicitudFecha() {
      return request.resource.data.estado == resource.data.estado
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['solicitudCambioFecha', 'updatedAt'])
        && resource.data.get('solicitudCambioFecha', {}).get('estado', '') == 'pendiente';
    }

    // El jefe aprueba el cambio de una visita que se inició y no se cerró
    // ese día: vuelve a programada en la fecha nueva, sin inicio ni firmas;
    // las respuestas se conservan.
    function esAprobacionDeFechaEnCurso() {
      return request.resource.data.estado == 'programada'
        && resource.data.get('solicitudCambioFecha', {}).get('estado', '') == 'pendiente'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['estado', 'fechaProgramada', 'reprogramaciones',
            'solicitudCambioFecha', 'inicio', 'firmaProfesional',
            'firmaEstablecimiento', 'firmanteEstablecimientoId', 'updatedAt'])
        && request.resource.data.get('inicio', null) == null
        && request.resource.data.get('firmaProfesional', null) == null
        && request.resource.data.get('firmaEstablecimiento', null) == null;
    }

    // La primera firma solo se agrega cuando ya se guardó el contenido.
    // Desde entonces se puede añadir la otra firma, pero no reescribir el
    // acta ni sustituir una firma existente.
    function firmaVisitaSinCambiosDeContenido() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let firmada = ('firmaProfesional' in resource.data
          && resource.data.firmaProfesional != null)
        || ('firmaEstablecimiento' in resource.data
          && resource.data.firmaEstablecimiento != null);
      let firmaEstPendiente = !('firmaEstablecimiento' in resource.data)
        || resource.data.firmaEstablecimiento == null;
      // Con el contenido firmado solo se agregan firmas; mientras falte la
      // del establecimiento se puede cambiar a quién se le pide (25 sep 2026).
      return firmada
        ? (changed.hasOnly(['firmaProfesional', 'firmaEstablecimiento', 'updatedAt'])
            || (firmaEstPendiente
              && changed.hasOnly(['firmanteEstablecimientoId',
                'responsableEstablecimiento', 'updatedAt'])))
          && (!('firmaProfesional' in resource.data)
            || resource.data.firmaProfesional == null
            || request.resource.data.firmaProfesional == resource.data.firmaProfesional)
          && (!('firmaEstablecimiento' in resource.data)
            || resource.data.firmaEstablecimiento == null
            || request.resource.data.firmaEstablecimiento == resource.data.firmaEstablecimiento)
        : (!changed.hasAny(['firmaProfesional', 'firmaEstablecimiento'])
          || changed.hasOnly(['firmaProfesional', 'firmaEstablecimiento', 'updatedAt']));
    }

    // Reprogramar solo mueve la fecha y añade al historial; el estado sigue
    // en 'programada'. Si el profesional había pedido el cambio, queda
    // resuelto en la misma escritura.
    function esReprogramacionDeVisita() {
      return request.resource.data.estado == 'programada'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['fechaProgramada', 'reprogramaciones',
            'solicitudCambioFecha', 'updatedAt']);
    }

    // Maestro de ubicaciones de los establecimientos: lo lee cualquiera
    // que participe en Visitas (el profesional lo necesita para iniciar),
    // lo escriben Desarrollo y Gerencia (26 sep 2026). Ni los profesionales
    // ni los jefes de área: es lo que decide si una visita se puede iniciar.
    match /TBL_VISITAS_UBICACIONES/{docId} {
      allow get: if resource == null
        || participaEnVisitas(resource.data.empresaId);
      allow list: if participaEnVisitas(resource.data.empresaId);
      allow create: if belongsToCompany(request.resource.data.empresaId)
        && (isDeveloper() || isDeveloperIn(request.resource.data.empresaId)
          || esGerenciaVisitas(request.resource.data.empresaId));
      allow update: if resource.data.empresaId == request.resource.data.empresaId
        && (isDeveloperFor(resource.data.empresaId)
          || isDeveloperIn(resource.data.empresaId)
          || esGerenciaVisitas(resource.data.empresaId));
      allow delete: if isDeveloperFor(resource.data.empresaId)
        || isDeveloperIn(resource.data.empresaId)
        || esGerenciaVisitas(resource.data.empresaId);
    }

    // La colección de roles no puede quedar en el fallback general: de otro
    // modo un usuario autenticado podría ascenderse a sí mismo. La primera
    // asignación de administrador la hace Desarrollo; después administra el
    // rol admin_interventoria de esa empresa.
    // `isDeveloperIn` además de `isDeveloper`: el desarrollador real está
    // marcado dentro de `empresasDetalle[empresa]` y no en la raíz, y sin esto
    // Administración le decía "permission-denied" al cambiar un rol
    // (11 sep 2026). Probado en functions/test/interventoria_roles.rules.js.
    function administraInterventoria(empresaId) {
      return isDeveloperFor(empresaId)
        || isDeveloperIn(empresaId)
        || hasInterventoriaRole(empresaId, ['admin_interventoria']);
    }

    match /TBL_INTERVENTORIA_ROLES/{docId} {
      allow read: if belongsToCompany(resource.data.empresaId);
      allow create: if administraInterventoria(request.resource.data.empresaId);
      allow update: if resource.data.empresaId == request.resource.data.empresaId
        && administraInterventoria(resource.data.empresaId);
      allow delete: if administraInterventoria(resource.data.empresaId);
    }

    // La matriz de responsables cambia quién recibe tareas reales. Solo la
    // administra el rol funcional del módulo; el resto conserva lectura.
    match /TBL_INTERVENTORIA_CONFIG/{docId} {
      allow read: if belongsToCompany(docId);
      allow create, update: if administraInterventoria(docId);
      allow delete: if false;
    }

    // ── Maestro de datos bancarios de beneficiarios de pago ──────────────
    //
    // Son DOS colecciones y no dos campos porque Firestore no tiene seguridad
    // por campo: una regla decide si se lee el documento entero. Si Talento
    // Humano pudiera leer el documento para ver el banco, leería el número de
    // cuenta con él, y el enmascarado de la pantalla no lo impediría — basta
    // con abrir la consola.
    //
    // Aquí va todo MENOS el número: nombre, banco, tipo y forma de pago.
    //
    // Hoy solo entra Tesorería, porque el maestro se usa para pagos a
    // proveedores. Cuando Talento Humano gestione la nómina desde su propio
    // módulo, darles acceso será añadir 'talento_humano' a ESTA lista y a
    // ninguna otra: podrán ver y corregir el banco y seguirán sin poder leer el
    // número. Esa es toda la razón de que sean dos colecciones y no dos campos,
    // y por eso el corte se hace ahora aunque el segundo lector no exista
    // todavía: hacerlo después sería una migración.
    match /TBL_PAGOS_BENEFICIARIOS/{docId} {
      // `hasPlanillasRole` ya mira la empresa (y si la persona está habilitada).
      allow read: if hasPlanillasRole(resource.data.empresaId, [
          'tesoreria', 'admin_doc', 'desarrollador'
        ]);
      allow create, update: if hasPlanillasRole(request.resource.data.empresaId, [
          'tesoreria', 'admin_doc', 'desarrollador'
        ])
        // El número de cuenta no puede colarse aquí ni por descuido ni a
        // propósito: si se admitiera, quedaría legible para Talento Humano y
        // el corte entre las dos colecciones no serviría de nada.
        && !('numeroCuenta' in request.resource.data);
      allow delete: if hasPlanillasRole(resource.data.empresaId, [
        'tesoreria', 'admin_doc', 'desarrollador'
      ]);
    }

    // Y aquí, solo el número de cuenta. Tesorería y la administración
    // documental. Talento Humano NO entra: no le hace falta para su trabajo, y
    // un dato que no se necesita no se expone.
    match /TBL_PAGOS_BENEFICIARIOS_CUENTA/{docId} {
      allow read: if hasPlanillasRole(resource.data.empresaId, [
          'tesoreria', 'admin_doc', 'desarrollador'
        ]);
      allow create, update: if hasPlanillasRole(request.resource.data.empresaId, [
          'tesoreria', 'admin_doc', 'desarrollador'
        ]);
      allow delete: if hasPlanillasRole(resource.data.empresaId, [
        'tesoreria', 'admin_doc', 'desarrollador'
      ]);
    }

    match /TBL_CORREO_ROLES/{docId} {
      // Mismo caso: quien no tiene rol asignado lee un documento inexistente.
      allow get: if resource == null || belongsToCompany(resource.data.empresaId);
      allow list: if belongsToCompany(resource.data.empresaId);
      // 28 sep 2026: también Admin de la empresa (Admin > Apps, roles y
      // permisos > Correo y Correspondencia), con el contrato validado.
      allow create: if isDeveloperFor(request.resource.data.get('empresaId', null))
        || isCorreoAdmin(request.resource.data.empresaId)
        || (asignacionCorreoValida(docId, request.resource.data)
          && gestionaRolesDeModulo(request.resource.data.empresaId, 'correodashboard'));
      allow update: if resource.data.empresaId == request.resource.data.empresaId
        && (isDeveloperFor(resource.data.empresaId)
          || isCorreoAdmin(resource.data.empresaId)
          || (asignacionCorreoValida(docId, request.resource.data)
            && gestionaRolesDeModulo(resource.data.empresaId, 'correodashboard')));
      allow delete: if isDeveloperFor(resource.data.get('empresaId', null))
        || isCorreoAdmin(resource.data.empresaId);
    }

    // Roles (28 sep 2026). Hasta hoy los cubría la regla general. Los perfiles
    // generales siguen igual (cualquier sesión, como antes); los roles
    // configurables por módulo solo los crea, edita o borra quien los
    // administra en su empresa, y con el contrato de Codex. Un perfil general
    // no se puede convertir en rol de módulo (ni al revés) para saltarse esto.
    match /TBL_ROLES/{docId} {
      allow read: if isSignedIn();
      allow create: if esRolDeModulo(request.resource.data)
        ? (rolDeModuloValido(docId, request.resource.data)
          && gestionaRolesDeModulo(request.resource.data.empresaId,
            request.resource.data.moduleId))
        : isSignedIn();
      allow update: if (esRolDeModulo(resource.data)
          || esRolDeModulo(request.resource.data))
        ? (esRolDeModulo(resource.data) && esRolDeModulo(request.resource.data)
          && resource.data.empresaId == request.resource.data.empresaId
          && resource.data.moduleId == request.resource.data.moduleId
          && rolDeModuloValido(docId, request.resource.data)
          && gestionaRolesDeModulo(resource.data.empresaId, resource.data.moduleId))
        : isSignedIn();
      allow delete: if esRolDeModulo(resource.data)
        ? gestionaRolesDeModulo(resource.data.empresaId, resource.data.moduleId)
        : isSignedIn();
    }

    match /TBL_GD_TIPOS_DOCUMENTALES/{docId} {
      allow read: if belongsToCompany(resource.data.empresaId);
      allow create: if isDeveloperFor(request.resource.data.get('empresaId', null))
        || isCorreoAdmin(request.resource.data.empresaId);
      allow update: if resource.data.empresaId == request.resource.data.empresaId
        && (isDeveloperFor(resource.data.empresaId)
          || isCorreoAdmin(resource.data.empresaId));
      allow delete: if false;
    }

    // La declaración con soporte se valida y registra únicamente en Functions.
    match /TBL_GD_EXPEDIENTES/{docId} {
      allow read, delete: if belongsToCompany(resource.data.empresaId);
      allow create: if belongsToCompany(request.resource.data.empresaId)
        && !request.resource.data.keys().hasAny([
        'respuestaExternaRegistrada', 'respuestaExternaRegistradaPor',
        'respuestaExternaRegistradaAt', 'soportesRespuestaExterna'
      ]);
      allow update: if resource.data.empresaId == request.resource.data.empresaId
        && belongsToCompany(resource.data.empresaId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'respuestaExternaRegistrada', 'respuestaExternaRegistradaPor',
          'respuestaExternaRegistradaAt', 'soportesRespuestaExterna'
        ]);
    }

    match /TBL_GD_EXPEDIENTES_EVENTOS/{docId} {
      allow read: if belongsToCompany(resource.data.empresaId);
      allow create: if belongsToCompany(request.resource.data.empresaId);
      allow update, delete: if false;
    }

    match /TBL_GD_COLABORACION/{docId} {
      allow read: if belongsToCompany(resource.data.empresaId);
      allow create: if belongsToCompany(request.resource.data.empresaId);
      allow update: if resource.data.empresaId == request.resource.data.empresaId
        && belongsToCompany(resource.data.empresaId);
      allow delete: if false;
    }

    match /TBL_GD_VINCULOS/{docId} {
      allow read: if belongsToCompany(resource.data.empresaId);
      allow create: if belongsToCompany(request.resource.data.empresaId);
      allow update: if resource.data.empresaId == request.resource.data.empresaId
        && belongsToCompany(resource.data.empresaId);
      allow delete: if belongsToCompany(resource.data.empresaId);
    }

    // Contadores y códigos internos se escriben exclusivamente en Functions.
    match /TBL_GD_CONTADORES/{docId} {
      allow read, write: if false;
    }

    // ── Rutas (28 sep 2026) ───────────────────────────────────────────────
    // Estaba entero en la regla general: cualquiera con sesión, de cualquier
    // empresa, podía darse el rol de administrador, leer las claves de Google
    // y TomTom del estudio de movilidad o la ubicación en vivo de los
    // conductores. Ahora va por empresa y por rol.
    //
    // Roles en `TBL_RUTAS_ROLES/{empresa}_{usuario}` (el id que escriben
    // Administración y `RutasService.guardarRol`): conductor, calidad, admin,
    // admin_calidad y desarrollador, el perfil que prueba todos. Espejo de
    // `RutasDashboardScreen`: el desarrollador de la app entra a todo.
    //
    // Lo que no es sensible (rutas, establecimientos, placas, configuración,
    // asignaciones y la lista de roles) lo lee cualquiera de la empresa:
    // Administración carga los roles de todos los módulos y Talento Humano
    // cierra las asignaciones de quien inhabilita.
    function rolRutas(empresaId) {
      let path = /databases/$(database)/documents/TBL_RUTAS_ROLES/$(empresaId + '_' + request.auth.token.userDocId);
      return exists(path) ? estadoTexto(get(path).data.get('rol', '')) : '';
    }

    function rutasConRol(empresaId, roles) {
      return belongsToCompany(empresaId)
        && (rolRutas(empresaId) in roles
          || isDeveloper() || isDeveloperIn(empresaId));
    }

    function participaEnRutas(empresaId) {
      return rutasConRol(empresaId, ['conductor', 'calidad', 'admin',
        'admin_calidad', 'desarrollador', 'developer']);
    }

    function administraRutas(empresaId) {
      return rutasConRol(empresaId,
        ['admin', 'admin_calidad', 'desarrollador', 'developer']);
    }

    function revisaRutas(empresaId) {
      return rutasConRol(empresaId,
        ['calidad', 'admin_calidad', 'desarrollador', 'developer']);
    }

    function conduceRutas(empresaId) {
      return rutasConRol(empresaId, ['conductor', 'desarrollador', 'developer']);
    }

    // Borrar evidencias y limpiar el historial: solo el perfil de desarrollo.
    function desarrolloRutas(empresaId) {
      return rutasConRol(empresaId, ['desarrollador', 'developer']);
    }

    // Desarrollo asigna cualquier rol. El administrador de Rutas asigna los
    // demás, a otras personas: no se cambia a sí mismo ni da o quita el
    // perfil de desarrollador. [antes] y [despues] son el rol que tenía y el
    // que queda (iguales al crear o borrar): la empresa se mira una sola vez.
    function asignaRolRutas(empresaId, userId, antes, despues) {
      return belongsToCompany(empresaId)
        && ((userId != request.auth.token.userDocId
            && !(antes in ['desarrollador', 'developer'])
            && !(despues in ['desarrollador', 'developer'])
            && rolRutas(empresaId) in ['admin', 'admin_calidad'])
          || isDeveloper() || isDeveloperIn(empresaId));
    }

    function empresaSeConserva() {
      return resource.data.empresaId == request.resource.data.empresaId;
    }

    match /TBL_RUTAS_ROLES/{docId} {
      allow get: if resource == null || belongsToCompany(resource.data.empresaId);
      allow list: if belongsToCompany(resource.data.empresaId);
      allow create: if docId == request.resource.data.empresaId + '_'
          + request.resource.data.userId
        && request.resource.data.rol in ['conductor', 'calidad', 'admin',
          'admin_calidad', 'desarrollador']
        && asignaRolRutas(request.resource.data.empresaId,
          request.resource.data.userId, request.resource.data.rol,
          request.resource.data.rol);
      allow update: if empresaSeConserva()
        && resource.data.get('userId', '') == request.resource.data.userId
        && request.resource.data.rol in ['conductor', 'calidad', 'admin',
          'admin_calidad', 'desarrollador']
        && asignaRolRutas(resource.data.empresaId, request.resource.data.userId,
          resource.data.get('rol', ''), request.resource.data.rol);
      allow delete: if asignaRolRutas(resource.data.empresaId,
        resource.data.get('userId', ''), resource.data.get('rol', ''),
        resource.data.get('rol', ''));
    }

    // Catálogos de Administración de Rutas. `get` de un id que no existe:
    // la importación desde Excel pregunta por el id antes de crearlo.
    match /TBL_RUTAS/{docId} {
      allow get: if resource == null || belongsToCompany(resource.data.empresaId);
      allow list: if belongsToCompany(resource.data.empresaId);
      allow create: if administraRutas(request.resource.data.empresaId);
      allow update: if empresaSeConserva()
        && administraRutas(resource.data.empresaId);
      allow delete: if administraRutas(resource.data.empresaId);
    }

    match /TBL_RUTAS_ESTABLECIMIENTOS/{docId} {
      allow get: if resource == null || belongsToCompany(resource.data.empresaId);
      allow list: if belongsToCompany(resource.data.empresaId);
      allow create: if administraRutas(request.resource.data.empresaId);
      allow update: if empresaSeConserva()
        && administraRutas(resource.data.empresaId);
      allow delete: if administraRutas(resource.data.empresaId);
    }

    match /TBL_RUTAS_PLACAS/{docId} {
      allow get: if resource == null || belongsToCompany(resource.data.empresaId);
      allow list: if belongsToCompany(resource.data.empresaId);
      allow create: if administraRutas(request.resource.data.empresaId);
      allow update: if empresaSeConserva()
        && administraRutas(resource.data.empresaId);
      allow delete: if false;
    }

    // Configuración (docId = empresa). La crea con valores por defecto quien
    // habilita el módulo en Administración; la cambia Administración de Rutas.
    match /TBL_RUTAS_CONFIG/{empresaId} {
      allow get: if resource == null || belongsToCompany(empresaId);
      allow create: if belongsToCompany(empresaId)
        && request.resource.data.empresaId == empresaId;
      allow update: if request.resource.data.empresaId == empresaId
        && administraRutas(empresaId);
      allow delete: if false;
    }

    // Asignaciones: las abre y releva Administración de Rutas. Talento
    // Humano, al inhabilitar a alguien, cierra su asignación o retira al
    // ayudante (`PersonnelStatusService.changeStatus`); quien lo hace no
    // tiene por qué tener rol en Rutas, así que ese cierre, y solo ese, lo
    // puede escribir cualquiera de la empresa. El histórico no se borra.
    function cierreDeAsignacionPorRetiro() {
      let cambios = request.resource.data.diff(resource.data).affectedKeys();
      let d = request.resource.data;
      return (d.activa == false
          && d.get('cerradaPor', '') == 'inhabilitacion_talento_humano'
          && cambios.hasOnly(['activa', 'vigenteHasta', 'cerradaPor',
            'cerradaCedula']))
        || (d.get('ayudanteCedula', '') == ''
          && d.get('ayudanteRetiradoPor', '') == 'inhabilitacion_talento_humano'
          && cambios.hasOnly(['ayudanteCedula', 'ayudanteNombre',
            'ayudanteRetiradoPor', 'ayudanteRetiradoAt']));
    }

    match /TBL_RUTAS_ASIGNACIONES/{docId} {
      allow get: if resource == null || belongsToCompany(resource.data.empresaId);
      allow list: if belongsToCompany(resource.data.empresaId);
      allow create: if administraRutas(request.resource.data.empresaId);
      allow update: if empresaSeConserva()
        && ((cierreDeAsignacionPorRetiro()
            && belongsToCompany(resource.data.empresaId))
          || administraRutas(resource.data.empresaId));
      allow delete: if false;
    }

    // Evidencias: fotos y ubicación de la entrega. Las ve quien tiene un rol
    // en Rutas. El conductor sube la suya a su nombre, y solo repite la que
    // Calidad rechazó; Calidad aprueba o rechaza sin tocar la foto.
    function evidenciaDelConductor() {
      return request.resource.data.estado == 'pendiente'
        && request.resource.data.createdBy == request.auth.token.userDocId;
    }

    function revisionDeEvidencia() {
      return request.resource.data.estado in ['aprobada', 'rechazada']
        && request.resource.data.revisadoPor == request.auth.token.userDocId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['estado', 'revisadoPor', 'revisadoEn', 'motivoRechazo']);
    }

    match /TBL_RUTAS_EVIDENCIAS/{docId} {
      allow get: if resource == null || participaEnRutas(resource.data.empresaId);
      allow list: if participaEnRutas(resource.data.empresaId);
      allow create: if evidenciaDelConductor()
        && conduceRutas(request.resource.data.empresaId);
      allow update: if empresaSeConserva()
        && ((resource.data.estado == 'rechazada'
            && evidenciaDelConductor()
            && conduceRutas(resource.data.empresaId))
          || (revisionDeEvidencia() && revisaRutas(resource.data.empresaId)));
      allow delete: if desarrolloRutas(resource.data.empresaId);
    }

    // Lo mantiene la Cloud Function `rutasResumenEvidencia`.
    match /TBL_RUTAS_RESUMEN_DIARIO/{docId} {
      allow get: if resource == null || participaEnRutas(resource.data.empresaId);
      allow list: if participaEnRutas(resource.data.empresaId);
      allow create, update: if false;
      allow delete: if desarrolloRutas(resource.data.empresaId);
    }

    // Ubicación en vivo de cada conductor: la ve el centro de control
    // (Administración de Rutas) y cada quien la suya. Se escribe solo la
    // propia, en `{empresa}_{usuario}`.
    match /TBL_RUTAS_UBICACIONES/{docId} {
      allow get: if resource == null
        || (resource.data.userId == request.auth.token.userDocId
          && belongsToCompany(resource.data.empresaId))
        || administraRutas(resource.data.empresaId);
      allow list: if administraRutas(resource.data.empresaId);
      allow create, update: if request.resource.data.userId == request.auth.token.userDocId
        && docId == request.resource.data.empresaId + '_'
          + request.auth.token.userDocId
        && (resource == null || empresaSeConserva())
        && participaEnRutas(request.resource.data.empresaId);
      allow delete: if false;
    }

    // Estudio de movilidad: la configuración guarda las claves de Google y
    // TomTom. Todo es de Administración de Rutas; las mediciones y corridas
    // las escribe la Cloud Function.
    match /TBL_RUTAS_MOV_CONFIG/{empresaId} {
      allow get: if resource == null || administraRutas(empresaId);
      allow create, update: if request.resource.data.empresaId == empresaId
        && administraRutas(empresaId);
      allow delete: if false;
    }

    match /TBL_RUTAS_MOV_HORARIOS/{docId} {
      allow get: if resource == null || administraRutas(resource.data.empresaId);
      allow list: if administraRutas(resource.data.empresaId);
      allow create: if administraRutas(request.resource.data.empresaId);
      allow update: if empresaSeConserva()
        && administraRutas(resource.data.empresaId);
      allow delete: if administraRutas(resource.data.empresaId);
    }

    match /TBL_RUTAS_MOV_MEDICIONES/{docId} {
      allow get: if resource == null || administraRutas(resource.data.empresaId);
      allow list: if administraRutas(resource.data.empresaId);
      allow create, update: if false;
      allow delete: if administraRutas(resource.data.empresaId);
    }

    match /TBL_RUTAS_MOV_RUNS/{docId} {
      allow get: if resource == null || administraRutas(resource.data.empresaId);
      allow list: if administraRutas(resource.data.empresaId);
      allow create, update: if false;
      allow delete: if administraRutas(resource.data.empresaId);
    }

    // Todo lo que no tiene regla propia. Las colecciones con regla propia se
    // excluyen aquí: si no, esta regla las volvería a abrir (Firestore deja
    // pasar si CUALQUIER regla que coincide lo permite). Una lista con `in`
    // y no una cadena de `!=`: cuesta una sola expresión.
    match /{collection}/{document=**} {
      allow read, write: if isSignedIn()
        && !(collection in [
          'TBL_WHATSAPP_CONFIG',
          'TBL_CORREO_LISTADOS',
          'TBL_GD_EXPEDIENTES',
          'TBL_INTERVENTORIA_VISITAS',
          'TBL_INTERVENTORIA_HALLAZGOS',
          'TBL_INTERVENTORIA_ROLES',
          'TBL_INTERVENTORIA_CONFIG',
          'TBL_INTERVENTORIA_SOLICITUDES_ELIMINACION',
          'TBL_VISITAS',
          'TBL_VISITAS_FORMATOS',
          'TBL_VISITAS_ROLES',
          'TBL_VISITAS_UBICACIONES',
          'TBL_VISITAS_GRUPOS',
          'TBL_CORREO_ROLES',
          'TBL_ROLES',
          'TBL_GD_TIPOS_DOCUMENTALES',
          'TBL_GD_EXPEDIENTES_EVENTOS',
          'TBL_GD_COLABORACION',
          'TBL_GD_VINCULOS',
          'TBL_GD_CONTADORES',
          'TBL_DIAN_TOKENS',
          'TBL_DIAN_TOKEN_ACCESOS',
          'TBL_DIAN_TOKEN_CONFIG',
          'TBL_AUTH_CREDENTIALS',
          'TBL_AUTH_LOGIN_ATTEMPTS',
          'TBL_AUTH_RECOVERY_CHALLENGES',
          'TBL_AUTH_ADMIN_AUDIT',
          'TBL_PAGOS_BENEFICIARIOS',
          'TBL_PAGOS_BENEFICIARIOS_CUENTA',
          'TBL_RUTAS',
          'TBL_RUTAS_ROLES',
          'TBL_RUTAS_ESTABLECIMIENTOS',
          'TBL_RUTAS_PLACAS',
          'TBL_RUTAS_CONFIG',
          'TBL_RUTAS_ASIGNACIONES',
          'TBL_RUTAS_EVIDENCIAS',
          'TBL_RUTAS_RESUMEN_DIARIO',
          'TBL_RUTAS_UBICACIONES',
          'TBL_RUTAS_MOV_CONFIG',
          'TBL_RUTAS_MOV_HORARIOS',
          'TBL_RUTAS_MOV_MEDICIONES',
          'TBL_RUTAS_MOV_RUNS',
          'TBL_PACIENTES',
          'TBL_VALORACIONES_NUTRICION',
          'TBL_MEDICIONES_NUTRICION',
          'TBL_PATOLOGIAS',
          'TBL_DIETAS',
          'TBL_ASIGNACIONES_DIETA',
          'TBL_CARNETS_NUTRICION',
          'TBL_MENUS',
          'TBL_DERIVACIONES_NUTRICION',
          'TBL_ALERTAS_NUTRICION',
          'TBL_FIRMAS',
          'TBL_EVIDENCIAS_NUTRICION',
          'TBL_PLANTILLAS_MENUS',
          'TBL_INGREDIENTES',
          'TBL_DIRECTORIO_NUTRICION',
          'TBL_CITAS_NUTRICION',
          'TBL_HISTORIAL_NUTRICION'
        ]);
    }
  }
}
