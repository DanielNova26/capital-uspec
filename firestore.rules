rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null
        && request.auth.token.authVersion == 2
        && request.auth.token.userDocId is string;
    }

    function currentUserPath() {
      return /databases/$(database)/documents/TBL_USUARIOS/$(request.auth.token.userDocId);
    }

    function currentUser() {
      return get(currentUserPath()).data;
    }

    // Espejo de `isDeveloperUser` en lib/utils/user_company.dart. La app
    // reconoce al desarrollador también por un `roleId` que TERMINA en
    // `_desarrollador` (el real es `EMPRESA_001_rutas_desarrollador`, y su
    // `role` es `rutas_desarrollador`, que no está en la lista corta). Sin
    // esto la app lo trataba como desarrollador y las reglas no: Admin le
    // decía "permission-denied" al cambiar un rol (11 sep 2026).
    //
    // Una sola expresión regular (`matches` compara la cadena completa): la
    // lista corta y el sufijo `_desarrollador`/`_developer`.
    function esRolDeDesarrollo(valor) {
      return valor is string
        && valor.matches('desarrollador|developer|superadmin|administrador_sistema|.*_(desarrollador|developer)');
    }

    // Marcas de Desarrollo en la ficha raíz, sin mirar sesión ni cuenta: lo
    // comparten `isDeveloper` y `belongsToCompany`, que ya las comprueban.
    // `'campo' in u &&` primero: sin el campo se descarta con una sola
    // expresión (tope de 1000 por petición).
    function marcaDesarrollo(u) {
      return ('desarrollador' in u && u.desarrollador == true)
        || ('developer' in u && u.developer == true)
        || ('role' in u && esRolDeDesarrollo(u.role))
        || ('rol' in u && esRolDeDesarrollo(u.rol))
        || ('roleKey' in u && esRolDeDesarrollo(u.roleKey))
        || ('roleId' in u && esRolDeDesarrollo(u.roleId));
    }

    // `let` y no seis `currentUser()`: cada llamada cuenta como expresiones
    // evaluadas y las reglas tienen un tope de 1000 por petición. Con las
    // llamadas repetidas el emulador ya avisaba "maximum of 1000 expressions".
    // La cuenta apagada va al final: quien no es desarrollador no llega ahí.
    function isDeveloper() {
      let u = currentUser();
      return isSignedIn() && marcaDesarrollo(u) && !cuentaInhabilitada(u);
    }

    // Desarrollo de la raíz actuando sobre [empresaId], para las reglas que
    // no pasan por `belongsToCompany`: tampoco entra a una empresa donde está
    // inhabilitado (en la app, AccessGuard lo comprueba antes que el rol).
    function isDeveloperFor(empresaId) {
      return isDeveloper() && habilitadaEn(currentUser(), empresaId);
    }

    // ── Personal inhabilitado (28 sep 2026) ───────────────────────────────
    // Espejo de `personaHabilitadaEn` en lib/utils/user_company.dart y de
    // functions/src/acceso.ts. La app ya no deja entrar a un inhabilitado,
    // pero con la sesión abierta (o una app vieja, sin el vigilante) seguía
    // leyendo y escribiendo los datos de la empresa directo en Firestore.
    // Solo cuentan los textos: un valor que no es texto se lee como vacío.
    function estadoTexto(valor) {
      return valor is string ? valor.trim().lower() : '';
    }

    // Cuenta apagada para toda la app: `activo: false` (Administración) o un
    // `estado` global (en registros viejos, `status`) distinto de activo.
    function cuentaInhabilitada(u) {
      let estado = estadoTexto(u.get('estado', ''));
      let global = estado != '' ? estado : estadoTexto(u.get('status', ''));
      return u.get('activo', true) == false
        || !(global in ['', 'activo', 'active']);
    }

    // Apagada en [empresaId]: por un traslado (`activo: false` en el bloque
    // de la empresa) o por Talento Humano (`estadoLaboral`, o si no hay,
    // `estado`, igual a inactivo).
    function apagadaEnEmpresa(u, empresaId) {
      let detalle = u.get('empresasDetalle', {});
      let bloque = detalle is map ? detalle.get(empresaId, {}) : {};
      let b = bloque is map ? bloque : {};
      let laboral = estadoTexto(b.get('estadoLaboral', ''));
      return b.get('activo', true) == false
        || (laboral != '' ? laboral : estadoTexto(b.get('estado', ''))) == 'inactivo';
    }

    // Sin empresa (una escritura que no la trae) solo se mira la cuenta.
    function habilitadaEn(u, empresaId) {
      return !cuentaInhabilitada(u)
        && (!(empresaId is string) || !apagadaEnEmpresa(u, empresaId));
    }

    // Una consulta de un módulo debe venir filtrada por empresa. Firestore
    // evalúa esta condición contra cada documento devuelto, por lo que una
    // consulta sin ese filtro falla en lugar de filtrar datos en el servidor.
    // Pertenecer no basta: quien está inhabilitado en la empresa, o tiene la
    // cuenta apagada, no entra a sus datos, aunque sea desarrollador. Va al
    // final porque es lo más largo, y el rechazo de una empresa ajena no
    // llega hasta ahí.
    //
    // Mismo resultado que `(pertenece || isDeveloper()) && habilitadaEn(u,
    // empresaId)`, sin repetir la sesión ni la cuenta apagada que esas dos ya
    // comprobaban (6 oct 2026).
    function belongsToCompany(empresaId) {
      let u = currentUser();
      return isSignedIn()
        && empresaId is string
        && empresaId.size() > 0
        && (
          ('empresas' in u && u.empresas is list && empresaId in u.empresas)
          || ('empresasDetalle' in u && u.empresasDetalle is map && empresaId in u.empresasDetalle)
          || ('empresaId' in u && u.empresaId == empresaId)
          || ('empresa' in u && u.empresa == empresaId)
          || marcaDesarrollo(u)
        )
        && !cuentaInhabilitada(u)
        && !apagadaEnEmpresa(u, empresaId);
    }

    // Una actualización no cambia el documento de empresa.
    function empresaSeConserva() {
      return resource.data.empresaId == request.resource.data.empresaId;
    }

    function interventoriaRolePath(empresaId) {
      return /databases/$(database)/documents/TBL_INTERVENTORIA_ROLES/$(empresaId + '_' + request.auth.token.userDocId);
    }

    function hasInterventoriaRole(empresaId, allowedRoles) {
      return belongsToCompany(empresaId)
        && exists(interventoriaRolePath(empresaId))
        && get(interventoriaRolePath(empresaId)).data.rol in allowedRoles;
    }

    function interventoriaConfigPath(empresaId) {
      return /databases/$(database)/documents/TBL_INTERVENTORIA_CONFIG/$(empresaId);
    }

    // Las empresas sin configuración conservan el flujo histórico. Cuando
    // Administración asigna programas y actas, el servidor exige que cada
    // acta nueva use una de esas plantillas; ocultarla en la UI no bastaría.
    function tipoActaInterventoriaPermitido(empresaId, data) {
      let path = interventoriaConfigPath(empresaId);
      return !exists(path)
        || !('tiposActaHabilitados' in get(path).data)
        || (
          get(path).data.tiposActaHabilitados is list
          && 'tipoActa' in data
          && data.tipoActa is string
          && data.tipoActa in get(path).data.tiposActaHabilitados
        );
    }

    function conservaTipoActaInterventoria(antes, despues) {
      return (
          !('tipoActa' in antes)
          && !('tipoActa' in despues)
        ) || (
          'tipoActa' in antes
          && 'tipoActa' in despues
          && antes.tipoActa == despues.tipoActa
        );
    }

    function visitasRolePath(empresaId) {
      return /databases/$(database)/documents/TBL_VISITAS_ROLES/$(empresaId + '_' + request.auth.token.userDocId);
    }

    // El rol sin volver a mirar la empresa: solo para usar DESPUÉS de un
    // `belongsToCompany` de la misma empresa. Cada `belongsToCompany` cuesta
    // expresiones (28 sep 2026: además mira si la persona está habilitada) y
    // `administraVisitasArea` llegaba a evaluarlo cuatro veces.
    function rolVisitasEn(empresaId, allowedRoles) {
      return exists(visitasRolePath(empresaId))
        && get(visitasRolePath(empresaId)).data.rol in allowedRoles;
    }

    // Las funciones que terminan en `En` no vuelven a mirar la empresa: se
    // usan dentro de una regla que ya pasó por `belongsToCompany`.
    function administraVisitasEn(empresaId) {
      return isDeveloper() || isDeveloperIn(empresaId)
        || rolVisitasEn(empresaId, ['jefe', 'gerencia'])
        || esGerenciaPorFicha(empresaId);
    }

    // Gerencia (26 sep 2026): "es el jefe de todos, puede ver absolutamente
    // todo y hacer todos los formatos". En Visitas tiene el alcance de
    // Desarrollo: todas las áreas y el maestro de ubicaciones. El rol lo da
    // Desarrollo; Gerencia no se nombra a sí misma ni a otra Gerencia.
    // 27 sep 2026: también por la ficha, sin rol asignado. Quien tiene cargo
    // de Gerencia ("Gerencia", "Gerente general"…) o el rol de la app
    // gerencia / gerente es Gerencia en Visitas. Espejo de
    // `resolverRolVisitas` y `VisitasService.cargoDeFicha`: el cargo es el
    // primero con texto entre cargoNombre y cargo de la empresa, y luego los
    // de la raíz. Va siempre al final de los `||`: es lo más caro y las
    // reglas tienen un tope de 1000 expresiones por petición.
    function gerenciaVisitasEn(empresaId) {
      return rolVisitasEn(empresaId, ['gerencia'])
        || esGerenciaPorFicha(empresaId);
    }

    function esGerenciaVisitas(empresaId) {
      return belongsToCompany(empresaId) && gerenciaVisitasEn(empresaId);
    }

    function esCargoGerencia(valor) {
      return valor is string
        && valor.trim().lower().matches('(gerente|gerencia).*');
    }

    function primerTexto(a, b) {
      return a is string && a.trim().size() > 0 ? a : b;
    }

    // El cargo de la raíz solo cuenta si la raíz es de esta empresa (la
    // principal, o no hay principal escrita). Espejo de `raizEsDeEmpresa`
    // en lib/utils/user_company.dart: ser Gerente en una razón social no da
    // Gerencia en Visitas de la otra.
    function raizEsDeEmpresa(u, empresaId) {
      return u.get('empresaId', '') == empresaId
        || u.get('empresaId', '') == '';
    }

    function esGerenciaPorFicha(empresaId) {
      let u = currentUser();
      let d = u.get('empresasDetalle', {}).get(empresaId, {});
      let cargoRaiz = raizEsDeEmpresa(u, empresaId)
        ? primerTexto(u.get('cargoNombre', ''), u.get('cargo', ''))
        : '';
      return esCargoGerencia(primerTexto(d.get('cargoNombre', ''),
          primerTexto(d.get('cargo', ''), cargoRaiz)))
        || d.get('roleKey', '') in ['gerencia', 'gerente']
        || (raizEsDeEmpresa(u, empresaId)
          && (u.get('roleKey', '') in ['gerencia', 'gerente']
            || u.get('role', '') in ['gerencia', 'gerente']));
    }

    function areaVisitasUsuario(empresaId, userId) {
      let path = /databases/$(database)/documents/TBL_VISITAS_ROLES/$(empresaId + '_' + userId);
      return exists(path) && 'areaId' in get(path).data
        ? get(path).data.areaId : '';
    }

    function administraVisitasAreaEn(empresaId, areaId) {
      return isDeveloper() || isDeveloperIn(empresaId)
        || (areaId is string && areaId.size() > 0
          && rolVisitasEn(empresaId, ['jefe'])
          && areaVisitasUsuario(empresaId, request.auth.token.userDocId) == areaId)
        || gerenciaVisitasEn(empresaId);
    }

    function administraVisitasArea(empresaId, areaId) {
      return belongsToCompany(empresaId)
        && administraVisitasAreaEn(empresaId, areaId);
    }

    // Administra (Desarrollo, jefe, Gerencia) o tiene cualquier otro rol.
    // El rol (un get) antes que Desarrollo y Gerencia por ficha (~60
    // expresiones cada uno): el profesional no paga lo que no le toca.
    function participaEnVisitas(empresaId) {
      return belongsToCompany(empresaId)
        && (rolVisitasEn(empresaId,
            ['jefe', 'gerencia', 'profesional', 'consulta', 'firmante', 'coordinador'])
          || isDeveloper() || isDeveloperIn(empresaId)
          || esGerenciaPorFicha(empresaId));
    }

    // Rol del módulo de Planillas de Pago para la empresa activa.
    //
    // Vive en el propio usuario (`empresasDetalle[empresa].rolPlanillas`, o
    // `rolPlanillas` en la raíz), que es donde lo lee la aplicación.
    //
    // 28 sep 2026 (contrato de Admin): el nivel de la empresa manda, también
    // vacío (se lo quitaron: no se recupera la raíz), y la raíz solo cuenta
    // si es de esta empresa (la principal). Antes daba el rol de la raíz en
    // cualquier empresa y fallaba si la ficha no tenía `empresasDetalle`.
    function planillasRole(empresaId) {
      let u = currentUser();
      let detalle = u.get('empresasDetalle', {});
      let bloque = detalle is map ? detalle.get(empresaId, {}) : {};
      let propio = bloque is map ? bloque.get('rolPlanillas', null) : null;
      let raiz = u.get('rolPlanillas', '');
      return isSignedIn() && propio is string
        ? propio
        : (raizEsDeEmpresa(u, empresaId) && raiz is string ? raiz : '');
    }

    // Desarrollador marcado DENTRO de la empresa (`empresasDetalle[e].roleKey`
    // o `roleId` terminado en `_desarrollador`), que es como lo reconoce la
    // aplicación. `isDeveloper()` solo mira la raíz del usuario, así que a
    // quien esté marcado por empresa el servidor le deniega aunque la pantalla
    // le enseñe el botón.
    //
    // Cada acceso va precedido de un `in`: en las reglas, leer un campo que no
    // existe lanza error, y el `&&` se detiene antes de llegar ahí.
    function isDeveloperIn(empresaId) {
      let u = currentUser();
      return isSignedIn()
        && 'empresasDetalle' in u
        && u.empresasDetalle is map
        && empresaId in u.empresasDetalle
        && u.empresasDetalle[empresaId] is map
        && (
          ('roleKey' in u.empresasDetalle[empresaId]
            && esRolDeDesarrollo(u.empresasDetalle[empresaId].roleKey))
          || ('roleId' in u.empresasDetalle[empresaId]
            && esRolDeDesarrollo(u.empresasDetalle[empresaId].roleId))
        )
        && habilitadaEn(u, empresaId);
    }

    function hasPlanillasRole(empresaId, allowedRoles) {
      return belongsToCompany(empresaId)
        && (
          isDeveloper()
          || isDeveloperIn(empresaId)
          || planillasRole(empresaId) in allowedRoles
        );
    }

    function correoRolePath(empresaId) {
      return /databases/$(database)/documents/TBL_CORREO_ROLES/$(empresaId + '_' + request.auth.token.userDocId);
    }

    // ── Roles configurables por módulo (28 sep 2026, trabajo de Codex) ─────
    // Espejo de `userHasApp(u, app, empresaId)` en
    // lib/utils/user_company.dart: con módulos por empresa solo cuenta la
    // lista de la empresa (o la raíz si es la principal y no hay lista
    // propia); sin esa marca, la raíz y la de la empresa.
    // Una sola función para todas las apps (6 oct 2026: antes había una
    // copia por app; con esa versión Google dejó de compilar las reglas).
    // [tareas] es true en Tareas y sus módulos de origen, donde cuenta la
    // marca "No opera en To-Do" de Talento Humano (4 oct 2026; espejo de
    // `soloTalentoHumanoEn`): con ella la persona no usa esos módulos en la
    // empresa aunque conserve alguno en la lista.
    function tieneAppsEn(empresaId, apps, tareas) {
      let u = currentUser();
      let detalle = u.get('empresasDetalle', {});
      let bloque = detalle is map ? detalle.get(empresaId, {}) : {};
      let propias = bloque is map ? bloque.get('apps', null) : null;
      let raiz = u.get('apps', []);
      return !(tareas && bloque is map && bloque.get('soloTalentoHumano', false) == true)
        && (u.get('appsPorEmpresa', false) == true
          ? (propias is list ? propias.hasAny(apps)
            : (raizEsDeEmpresa(u, empresaId) && raiz is list && raiz.hasAny(apps)))
          : ((raiz is list && raiz.hasAny(apps))
            || (propias is list && propias.hasAny(apps))));
    }

    function tieneAppAdminEn(empresaId) {
      return tieneAppsEn(empresaId, ['admindashboard', 'admin'], false);
    }

    // Mismo contrato de empresa activa para la app de Correo. El rol interno
    // determina las acciones del módulo; la consulta de avisos exige acceso
    // efectivo a la app incluso si existe una asignación histórica de rol.
    function tieneAppCorreoEn(empresaId) {
      return tieneAppsEn(empresaId, ['correodashboard', 'correo'], false);
    }

    function tieneAppTokensDianEn(empresaId) {
      return tieneAppsEn(empresaId, ['tokensdiandashboard', 'tokensdian', 'tokens'], false);
    }

    function tieneAppTalentoEn(empresaId) {
      return tieneAppsEn(empresaId, ['talentohumanodashboard', 'talentohumano', 'talento'], false);
    }

    function tieneAppNutricionEn(empresaId) {
      return tieneAppsEn(empresaId, ['nutriciondashboard', 'nutricion'], false);
    }

    // Administrador de Correspondencia por su asignación canónica. Sin mirar
    // la empresa: se usa después de un `belongsToCompany`.
    function esAdminCorreoEn(empresaId) {
      return exists(correoRolePath(empresaId))
        && get(correoRolePath(empresaId)).data.rol in [
          'administrador', 'admin', 'manager', 'gestor', 'superadmin',
          'desarrollador', 'developer'
        ];
    }

    // Rol de la persona en la tabla de un módulo (`{tabla}/{empresa}_{yo}`),
    // en minúsculas; vacío si no tiene.
    function rolEnTabla(coleccion, empresaId) {
      let path = /databases/$(database)/documents/$(coleccion)/$(empresaId + '_' + request.auth.token.userDocId);
      return exists(path) ? estadoTexto(get(path).data.get('rol', '')) : '';
    }

    // Administrador de Compras, Rutas, Interventoría o Visitas (Gerencia) por
    // su asignación en la tabla del módulo (29 sep 2026, roles configurables
    // con tabla propia).
    // Sin mirar la empresa: va después de un `belongsToCompany`.
    function adminDeModuloTablaEn(empresaId, moduleId) {
      return (moduleId == 'comprasdashboard' && esAdminComprasEn(empresaId))
        || (moduleId == 'rutasdashboard'
          && rolEnTabla('TBL_RUTAS_ROLES', empresaId) in ['admin', 'admin_calidad'])
        || (moduleId == 'interventoriadashboard'
          && rolEnTabla('TBL_INTERVENTORIA_ROLES', empresaId) == 'admin_interventoria')
        || (moduleId == 'visitasdashboard'
          && rolEnTabla('TBL_VISITAS_ROLES', empresaId) == 'gerencia')
        || (moduleId == 'tokensdiandashboard'
          && tieneAppTokensDianEn(empresaId)
          && rolEnTabla('TBL_DIAN_TOKEN_ROLES', empresaId) == 'administrador')
        || (moduleId == 'talentohumanodashboard'
          && tieneAppTalentoEn(empresaId)
          && rolEnTabla('TBL_TALENTO_HUMANO_ROLES', empresaId) == 'administrador')
        || (moduleId == 'nutriciondashboard'
          && tieneAppNutricionEn(empresaId)
          && rolEnTabla('TBL_NUTRICION_ROLES', empresaId) == 'administrador');
    }

    // Quién crea, edita y asigna roles de módulo: igual que
    // `canManageModuleRoles` del cliente (Desarrollo, o la app Admin en la
    // empresa) y, para los de Correspondencia, su administrador del módulo.
    function esAdminComprasEn(empresaId) {
      let rolePath = comprasRolePath(empresaId);
      return tieneAppComprasEn(empresaId) && exists(rolePath)
        && get(rolePath).data.get('empresaId', '') == empresaId
        && get(rolePath).data.get('userId', '') == request.auth.token.userDocId
        && get(rolePath).data.get('rol', '') == 'admin';
    }

    function comprasRolePath(empresaId) {
      return /databases/$(database)/documents/TBL_COMPRAS_ROLES/$(empresaId + '_' + request.auth.token.userDocId);
    }

    function tieneAppComprasEn(empresaId) {
      return tieneAppsEn(empresaId, ['comprasdashboard', 'compras'], false);
    }

    // La compatibilidad anterior termina individualmente al materializar su rol.
    // Consultas, desconocido y app retirada no pueden escribir por la regla general.
    function comprasEscrituraEn(empresaId, niveles) {
      let path = comprasRolePath(empresaId);
      return belongsToCompany(empresaId) && ((tieneAppComprasEn(empresaId)
          && (!exists(path) || (
          get(path).data.get('empresaId', '') == empresaId
          && get(path).data.get('userId', '') == request.auth.token.userDocId
          && get(path).data.get('rol', '') in niveles)))
        || tieneAppAdminEn(empresaId) || isDeveloper() || isDeveloperIn(empresaId));
    }

    function gestionaRolesDeModulo(empresaId, moduleId) {
      return belongsToCompany(empresaId)
        && (tieneAppAdminEn(empresaId)
          || (moduleId == 'correodashboard' && esAdminCorreoEn(empresaId))
          || adminDeModuloTablaEn(empresaId, moduleId)
          || isDeveloper() || isDeveloperIn(empresaId));
    }

    // Asignación en la tabla de un módulo (Compras, Rutas, Interventoría):
    // Admin de la empresa o Desarrollo a cualquiera; el administrador del
    // módulo a los demás, no a sí mismo (igual que el cliente).
    function asignaEnTablaDeModulo(empresaId, userId, moduleId) {
      return belongsToCompany(empresaId)
        && (tieneAppAdminEn(empresaId)
          || (userId != request.auth.token.userDocId
            && adminDeModuloTablaEn(empresaId, moduleId))
          || isDeveloper() || isDeveloperIn(empresaId));
    }

    // Contrato de la asignación en una tabla de módulo: id
    // `{empresa}_{usuario}` y un nivel conocido (vacío = rol inactivo en
    // Rutas e Interventoría).
    function asignacionDeTablaValida(docId, data, niveles) {
      return data.get('empresaId', '') is string
        && data.get('userId', '') is string
        && data.userId.size() > 0
        && docId == data.empresaId + '_' + data.userId
        && data.get('rol', '') in niveles;
    }

    function esRolDeModulo(data) {
      return data.get('type', '') == 'module_role';
    }

    // Contrato de Codex para `TBL_ROLES/{empresaId}_mod_{módulo}_{nombre}`.
    function rolDeModuloValido(docId, data) {
      return data.get('empresaId', '') is string
        && data.empresaId.size() > 0
        && docId.size() > data.empresaId.size() + 5
        && docId[0:data.empresaId.size() + 5] == data.empresaId + '_mod_'
        && data.get('moduleId', '') in ['correodashboard',
          'planillaspagodashboard', 'bibliotecadocumentaldashboard',
          'tareasdashboard', 'comprasdashboard', 'rutasdashboard',
          'interventoriadashboard', 'visitasdashboard',
          'tokensdiandashboard', 'talentohumanodashboard',
          'nutriciondashboard', 'facturaciondashboard',
          'gerenciadashboard']
        && (nivelesDeModulo(data.moduleId).size() == 0
          || data.get('baseRole', '') in nivelesDeModulo(data.moduleId))
        && data.get('enabled', null) is bool
        && data.get('revision', null) is int && data.revision >= 1
        && data.get('nombre', '') is string
        && data.nombre.size() > 0 && data.nombre.size() <= 120;
    }

    // Asignación canónica de Correspondencia que escribe Admin: su id es
    // `{empresa}_{usuario}` y el nivel es uno de los cuatro del módulo.
    function asignacionCorreoValida(docId, data) {
      return data.get('empresaId', '') is string
        && data.get('usuarioId', '') is string
        && docId == data.empresaId + '_' + data.usuarioId
        && data.get('rol', '') in ['visor', 'operador', 'clasificador',
          'administrador'];
    }

    function isCorreoAdmin(empresaId) {
      return belongsToCompany(empresaId)
        && exists(correoRolePath(empresaId))
        && get(correoRolePath(empresaId)).data.rol in [
          'administrador', 'admin', 'manager', 'gestor', 'superadmin',
          'desarrollador', 'developer'
        ];
    }

    // Credenciales, intentos y retos de recuperación son exclusivamente del
    // backend. Nunca se exponen al cliente, ni siquiera a administradores.
    // `TBL_AUTH_CREDENTIALS`, `TBL_AUTH_LOGIN_ATTEMPTS`,
    // `TBL_AUTH_RECOVERY_CHALLENGES`, `TBL_AUTH_ADMIN_AUDIT`: cerradas al
    // cliente.
    // Sin `match` propio: la regla general las excluye y ninguna otra las
    // abre (6 oct 2026, reglas más compactas).

    // Registro de ingresos (29 sep 2026): cada quien agrega el suyo al
    // entrar, con su equipo; lo lee Admin de esa empresa o Desarrollo. Antes
    // estaba en la regla general: cualquiera veía y borraba los ingresos (y
    // los equipos) de todas las empresas. Nadie lo edita ni lo borra.
    match /TBL_LOGIN_SESIONES/{sesionId} {
      allow read: if isDeveloperFor(resource.data.get('empresaId', ''))
        || (belongsToCompany(resource.data.get('empresaId', ''))
          && tieneAppAdminEn(resource.data.empresaId));
      allow create: if isSignedIn()
        && request.resource.data.get('userId', '')
          == request.auth.token.userDocId
        && request.resource.data.get('empresaId', '') is string
        && request.resource.data.empresaId.size() > 0;
      allow update, delete: if false;
    }

    // La auditoría de envíos contiene identificadores de Meta y errores de
    // entrega. Solo Admin de esa empresa o Desarrollo la consulta; el servidor
    // registra y concilia los eventos. Los estados crudos son solo del servidor.
    match /TBL_WHATSAPP_AUDITORIA/{auditId} {
      allow read: if isDeveloperFor(resource.data.get('empresaId', ''))
        || (belongsToCompany(resource.data.get('empresaId', ''))
          && tieneAppAdminEn(resource.data.empresaId));
      allow write: if false;
    }
    // `TBL_WHATSAPP_META_ESTADOS`: cerrada al cliente.
    // Sin `match` propio: la regla general la excluye y ninguna otra la
    // abre (6 oct 2026, reglas más compactas).

    // Contiene teléfonos, contenido del aviso y errores del proveedor. Correo
    // y Admin solo lo consultan en su empresa; Functions crea y actualiza.
    match /TBL_CORREO_ALERTAS/{alertId} {
      allow read: if isDeveloperFor(resource.data.get('empresaId', ''))
        || (belongsToCompany(resource.data.get('empresaId', ''))
          && (tieneAppAdminEn(resource.data.empresaId)
            || tieneAppCorreoEn(resource.data.empresaId)));
      allow write: if false;
    }

    // ── Nutrición (28 sep 2026) ───────────────────────────────────────────
    // Pacientes, valoraciones, patologías e historial son datos de salud y
    // solo pedían sesión: cualquiera, de cualquier empresa, los leía y
    // escribía. Ahora cada documento es de su empresa (y de nadie
    // inhabilitado en ella) y no cambia de empresa. `get` de un id que no
    // existe responde vacío: la app pregunta por la firma, el paciente o la
    // plantilla antes de crearlos.
    //
    // No se exige tener el módulo asignado: la lista de módulos vive en la
    // ficha del usuario, que todavía puede escribir cualquiera (P0 de
    // Seguridad transversal). Las citas las consulta el calendario de
    // Inicio de todo el personal. La regla es `documentoDeSuEmpresa`.
    // Documento de una sola empresa: se lee, crea, cambia y borra solo en la
    // propia (y por nadie inhabilitado en ella), y no cambia de empresa.
    // Nutrición y Compras.
    function documentoDeSuEmpresa() {
      return request.method == 'create'
        ? belongsToCompany(request.resource.data.empresaId)
        : belongsToCompany(resource.data.empresaId)
          && (request.method != 'update'
            || request.resource.data.empresaId == resource.data.empresaId);
    }

    // Las quince colecciones de Nutrición con el mismo contrato van en un
    // solo `match` (6 oct 2026, antes quince copias de la misma regla). Las
    // lee quien tiene un nivel del módulo; las de menús las escribe el nivel
    // de menús y las demás (clínicas) el clínico.
    // `matches` compara el nombre completo (ver `esColeccionCompras`).
    function esColeccionNutricion(collection) {
      return collection.matches('TBL_(PACIENTES|VALORACIONES_NUTRICION'
        + '|MEDICIONES_NUTRICION|PATOLOGIAS|ASIGNACIONES_DIETA'
        + '|CARNETS_NUTRICION|DERIVACIONES_NUTRICION|ALERTAS_NUTRICION|FIRMAS'
        + '|EVIDENCIAS_NUTRICION|DIRECTORIO_NUTRICION'
        + '|DIETAS|MENUS|PLANTILLAS_MENUS|INGREDIENTES)');
    }

    function nutricionEscribe(collection, empresaId) {
      return collection.matches('TBL_(DIETAS|MENUS|PLANTILLAS_MENUS|INGREDIENTES)')
        ? nutricionEscribeMenus(empresaId) : nutricionEscribeClinica(empresaId);
    }
    // Su `match` está al final, con las colecciones agrupadas.

    match /TBL_CITAS_NUTRICION/{docId} {
      allow get: if resource == null || documentoDeSuEmpresa();
      allow list: if documentoDeSuEmpresa();
      allow create: if documentoDeSuEmpresa() && nutricionEscribeClinica(request.resource.data.empresaId);
      allow update, delete: if documentoDeSuEmpresa() && nutricionEscribeClinica(resource.data.empresaId);
    }
    // Evaluaciones diagnósticas del paciente (29 sep 2026): son datos de
    // salud y seguían en la regla general, legibles desde cualquier empresa.
    // Su regla es `esColeccionDeSuEmpresa`, junto a Facturación.

    // Historial del paciente: `{empresa}-{paciente}/registros`. La consulta
    // no filtra por empresa (lee los últimos 20 del paciente), así que la
    // empresa sale del id: los códigos de empresa no llevan guion
    // (`codigoEmpresaDesdeNombre`). Se agrega y no se reescribe.
    match /TBL_HISTORIAL_NUTRICION/{historialId}/registros/{registroId} {
      allow read: if nutricionLee(historialId.split('-')[0]);
      allow create: if belongsToCompany(historialId.split('-')[0])
        && request.resource.data.empresaId == historialId.split('-')[0]
        && nutricionEscribeClinica(historialId.split('-')[0]);
      allow update, delete: if false;
    }

    // Las credenciales de WhatsApp se administran exclusivamente mediante
    // Cloud Functions. Ni siquiera un cliente autenticado puede leer el
    // ciphertext ni alterar la URL, sesión o módulos habilitados.
    // Los listados conservan su colección histórica para no romper reglas de
    // Correo, pero sólo Administración puede modificarlos mediante Functions.
    // Los filtros son configuración de Admin, no un editor operativo de Correo.
    // El acceso por la regla general queda excluido al final del archivo.
    function configuraFiltrosCorreo(empresaId) {
      return belongsToCompany(empresaId)
        && (tieneAppAdminEn(empresaId) || isDeveloper()
          || isDeveloperIn(empresaId));
    }

    match /TBL_CORREO_REGLAS/{docId} {
      allow get: if resource == null || belongsToCompany(resource.data.empresaId);
      allow list: if belongsToCompany(resource.data.empresaId);
      allow create: if configuraFiltrosCorreo(request.resource.data.empresaId);
      allow update: if empresaSeConserva()
        && configuraFiltrosCorreo(resource.data.empresaId);
      allow delete: if configuraFiltrosCorreo(resource.data.empresaId);
    }

    match /TBL_CORREO_LISTADOS/{document=**} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Los enlaces Token DIAN y su auditoria solo se exponen mediante
    // Cloud Functions. Esto impide que un cliente lea incluso el ciphertext.
    // `TBL_DIAN_TOKENS`, `TBL_DIAN_TOKEN_ACCESOS`, `TBL_DIAN_TOKEN_CONFIG`:
    // cerradas al cliente.
    // Sin `match` propio: la regla general las excluye y ninguna otra las
    // abre (6 oct 2026, reglas más compactas).
    // El nivel operativo de Tokens DIAN (fuera de los tokens cifrados),
    // Talento Humano y Nutrición vive en la tabla del módulo. Admin de la
    // empresa o del módulo lo asigna a otros; nunca se autoasigna. Las tres
    // tablas tienen el mismo contrato y van en un solo `match` (6 oct 2026).
    function esTablaDeRoles(collection) {
      return collection.matches(
        'TBL_(DIAN_TOKEN_ROLES|TALENTO_HUMANO_ROLES|NUTRICION_ROLES)');
    }

    function moduloDeTablaDeRoles(collection) {
      return collection == 'TBL_DIAN_TOKEN_ROLES' ? 'tokensdiandashboard'
        : (collection == 'TBL_TALENTO_HUMANO_ROLES' ? 'talentohumanodashboard'
          : 'nutriciondashboard');
    }

    // Niveles de los módulos con tabla de roles; son también los roles base
    // válidos de sus roles configurables (`rolDeModuloValido`).
    function nivelesDeModulo(moduleId) {
      return moduleId == 'tokensdiandashboard'
        ? ['consulta','operador','administrador']
        : (moduleId == 'talentohumanodashboard'
          ? ['consulta','solicitante','reclutador','gestor','administrador']
          : (moduleId == 'nutriciondashboard'
            ? ['consulta','clinico','menus','coordinador','administrador']
            : (moduleId == 'comprasdashboard'
              ? ['admin','calidad','compras','bodega','consultas'] : [])));
    }
    // Su `match` está al final, con las colecciones agrupadas.

    function nivelNutricionEn(empresaId) {
      let rolePath = /databases/$(database)/documents/TBL_NUTRICION_ROLES/$(empresaId + '_' + request.auth.token.userDocId);
      return !belongsToCompany(empresaId) ? ''
        : (isDeveloper() || isDeveloperIn(empresaId)
            || tieneAppAdminEn(empresaId)) ? 'administrador'
        : !tieneAppNutricionEn(empresaId) ? ''
        : exists(rolePath) ? estadoTexto(get(rolePath).data.get('rol', ''))
            : 'administrador';
    }

    function nutricionLee(empresaId) {
      return nivelNutricionEn(empresaId) in
        ['consulta','clinico','menus','coordinador','administrador'];
    }

    function nutricionEscribeClinica(empresaId) {
      return nivelNutricionEn(empresaId) in
        ['clinico','coordinador','administrador'];
    }

    function nutricionEscribeMenus(empresaId) {
      return nivelNutricionEn(empresaId) in
        ['menus','coordinador','administrador'];
    }

    // Acceso efectivo al trabajo de Talento Humano. Una app histórica sin
    // fila canónica conserva sus capacidades hasta la consolidación manual.
    function nivelTalentoEn(empresaId) {
      let rolePath = /databases/$(database)/documents/TBL_TALENTO_HUMANO_ROLES/$(empresaId + '_' + request.auth.token.userDocId);
      return !belongsToCompany(empresaId) ? ''
        : (isDeveloper() || isDeveloperIn(empresaId)
            || tieneAppAdminEn(empresaId)) ? 'administrador'
        : !tieneAppTalentoEn(empresaId) ? ''
        : exists(rolePath) ? estadoTexto(get(rolePath).data.get('rol', ''))
            : 'administrador';
    }

    match /TBL_TH_REQUERIMIENTOS_PERSONAL/{docId} {
      allow get: if resource == null || nivelTalentoEn(resource.data.empresaId) in
        ['consulta','solicitante','reclutador','gestor','administrador'];
      allow list: if nivelTalentoEn(resource.data.empresaId) in
        ['consulta','solicitante','reclutador','gestor','administrador'];
      allow create: if nivelTalentoEn(request.resource.data.empresaId) in
        ['solicitante','reclutador','gestor','administrador']
        && (nivelTalentoEn(request.resource.data.empresaId) != 'solicitante'
          || (request.resource.data.get('creadoPor', '') == request.auth.token.userDocId
            && request.resource.data.get('etapa', '') == 'solicitado'
            && request.resource.data.get('contratados', []) == []
            && request.resource.data.get('candidatos', []) == []));
      allow update: if empresaSeConserva()
        && (nivelTalentoEn(resource.data.empresaId) in
            ['reclutador','gestor','administrador']
          || (nivelTalentoEn(resource.data.empresaId) == 'solicitante'
            && resource.data.get('creadoPor', '') == request.auth.token.userDocId
            && request.resource.data.get('creadoPor', '') == resource.data.get('creadoPor', '')
            && request.resource.data.get('etapa', '') == resource.data.get('etapa', '')
            && request.resource.data.get('contratados', []) == resource.data.get('contratados', [])
            && request.resource.data.get('candidatos', []) == resource.data.get('candidatos', [])));
      allow delete: if nivelTalentoEn(resource.data.empresaId) in
        ['gestor','administrador'];
    }

    match /TBL_LLAMADOS_ATENCION/{docId} {
      allow get, list: if nivelTalentoEn(resource.data.empresaId) in
        ['gestor','administrador'];
      allow create: if nivelTalentoEn(request.resource.data.empresaId) in
        ['gestor','administrador'];
      allow update: if empresaSeConserva()
        && nivelTalentoEn(resource.data.empresaId) in ['gestor','administrador'];
      allow delete: if false;
    }

    match /TBL_HISTORIAL_LLAMADOS_ATENCION/{docId} {
      allow get, list: if nivelTalentoEn(resource.data.empresaId) in
        ['gestor','administrador'];
      allow create: if nivelTalentoEn(request.resource.data.empresaId) in
        ['gestor','administrador'];
      allow update, delete: if false;
    }

    // Las eliminaciones de Interventoría requieren una solicitud y aprobación
    // en Cloud Functions. El cliente puede crear/editar, pero nunca borrar.
    // `get` de un documento que NO existe: `resource` es nulo y la regla de
    // pertenencia falla con error, que Firestore convierte en denegado. El
    // registro de un acta lee su id nuevo dentro de una transacción para no
    // crearla dos veces, y con esa regla ningún registrador pudo guardar
    // actas desde el 11 sep 2026 (probado en interventoria_visitas.rules.js).
    // Leer un id inexistente no expone nada: solo dice que no existe.
    match /TBL_INTERVENTORIA_VISITAS/{docId} {
      allow get: if resource == null || belongsToCompany(resource.data.empresaId);
      allow list: if belongsToCompany(resource.data.empresaId);
      allow create: if belongsToCompany(request.resource.data.empresaId)
        && tipoActaInterventoriaPermitido(
          request.resource.data.empresaId,
          request.resource.data
        );
      allow update: if empresaSeConserva()
        && belongsToCompany(resource.data.empresaId)
        && (
          conservaTipoActaInterventoria(
            resource.data,
            request.resource.data
          )
          || tipoActaInterventoriaPermitido(
            request.resource.data.empresaId,
            request.resource.data
          )
        );
      allow delete: if false;
    }
    match /TBL_INTERVENTORIA_HALLAZGOS/{docId} {
      allow get: if resource == null || belongsToCompany(resource.data.empresaId);
      allow list: if belongsToCompany(resource.data.empresaId);
      allow create: if belongsToCompany(request.resource.data.empresaId);
      allow update: if empresaSeConserva()
        && belongsToCompany(resource.data.empresaId);
      // Guardar la revisión de un acta sincroniza sus hallazgos: crea los
      // nuevos y BORRA los que ya no tienen observación y nunca tuvieron
      // tarea. Con `delete: if false` ese batch entero fallaba y el borrador
      // no se guardaba ("permission-denied", 11 sep 2026). Solo se abre ese
      // caso: un hallazgo con tarea asignada sigue sin poderse borrar desde
      // el cliente (lo borra la función de eliminación con su aprobación).
      allow delete: if belongsToCompany(resource.data.empresaId)
        && 'fuente' in resource.data && resource.data.fuente == 'acta'
        && (!('tareaId' in resource.data) || resource.data.tareaId == '');
    }
    match /TBL_INTERVENTORIA_SOLICITUDES_ELIMINACION/{docId} {
      allow read: if belongsToCompany(resource.data.empresaId);
      allow write: if false;
    }

    // Expedientes K2 y su historial: solo el callable comprueba Calidad/Gerencia/Desarrollo,
    // acceso activo y responsable ACTUAL de la tarea antes de cada operación.
    // `TBL_INTERVENTORIA_PLANES`, `TBL_INTERVENTORIA_PLAN_ITEMS`: cerradas al
    // cliente.
    // Sin `match` propio: la regla general las excluye y ninguna otra las
    // abre (6 oct 2026, reglas más compactas).

    // Concepto higiénico sanitario (28 sep 2026): el acta de la autoridad de
    // salud con establecimiento, fecha, puntaje y concepto. La ve la empresa;
    // la registran y corrigen los roles con escritura del módulo
    // (`kInterventoriaRolesEscritura`) y la borran administración, gerencia y
    // Desarrollo. Espejo de `validarConceptoSanitario` en el modelo.
    function registraConceptoSanitario(empresaId) {
      return isDeveloperFor(empresaId) || isDeveloperIn(empresaId)
        || (belongsToCompany(empresaId)
          && rolEnTabla('TBL_INTERVENTORIA_ROLES', empresaId) in [
            'admin_interventoria', 'registrador_interventoria',
            'revisor_interventoria', 'gerente_interventoria',
            'directivo_interventoria']);
    }

    function conceptoSanitarioValido(d) {
      return d.get('centroCostoId', '') is string
        && d.centroCostoId.size() > 0
        && d.get('fecha', null) is timestamp
        && d.get('puntaje', -1) is number
        && d.puntaje >= 0 && d.puntaje <= 100
        && d.get('concepto', '') in ['FAVORABLE',
          'FAVORABLE_CON_REQUERIMIENTOS', 'DESFAVORABLE'];
    }

    match /TBL_INTERVENTORIA_CONCEPTOS_SANITARIOS/{docId} {
      allow get: if resource == null || belongsToCompany(resource.data.empresaId);
      allow list: if belongsToCompany(resource.data.empresaId);
      allow create: if registraConceptoSanitario(request.resource.data.empresaId)
        && conceptoSanitarioValido(request.resource.data);
      allow update: if empresaSeConserva()
        && registraConceptoSanitario(resource.data.empresaId)
        && conceptoSanitarioValido(request.resource.data);
      allow delete: if isDeveloperFor(resource.data.empresaId)
        || isDeveloperIn(resource.data.empresaId)
        || (belongsToCompany(resource.data.empresaId)
          && rolEnTabla('TBL_INTERVENTORIA_ROLES', resource.data.empresaId)
            in ['admin_interventoria', 'gerente_interventoria']);
    }

    // El módulo de visitas comparte empresa, pero cada profesional solo puede
    // responder sus propias visitas. Las asignaciones y formatos pertenecen
    // al jefe; el rol no se puede autoasignar usando el fallback general.
    // `get` de un doc que no existe: `resource` es null y evaluar
    // `resource.data` niega la lectura entera. La app pregunta por id si la
    // persona tiene rol, si existe el formato SST o la ubicación del
    // subcentro, y con la regla anterior recibía permission-denied cuando
    // la respuesta era "no existe" (21 sep 2026, "no me quiere cargar").
    // Mismo arreglo que Interventoría el 11 sep.
    // 29 sep 2026 (roles configurables): Admin de la empresa también lee y
    // asigna, sin dar ni quitar Gerencia (eso sigue siendo de Desarrollo), y
    // un rol inactivo deja el rol vacío (sin rol). Admin va justo después de
    // Desarrollo: al final, detrás de Jefe y Gerencia, se pasaba del tope de
    // 1000 expresiones.
    match /TBL_VISITAS_ROLES/{docId} {
      allow get: if resource == null
        || (belongsToCompany(resource.data.empresaId)
          && (resource.data.userId == request.auth.token.userDocId
            || administraVisitasEn(resource.data.empresaId)
            || tieneAppAdminEn(resource.data.empresaId)));
      allow list: if belongsToCompany(resource.data.empresaId)
        && (resource.data.userId == request.auth.token.userDocId
          || administraVisitasEn(resource.data.empresaId)
          || tieneAppAdminEn(resource.data.empresaId));
      allow create: if belongsToCompany(request.resource.data.empresaId)
        && docId == request.resource.data.empresaId + '_' + request.resource.data.userId
        && request.resource.data.rol in ['', 'jefe', 'profesional', 'consulta', 'firmante', 'coordinador', 'gerencia']
        && request.resource.data.areaId is string
        && (isDeveloper() || isDeveloperIn(request.resource.data.empresaId)
          || (request.resource.data.rol != 'gerencia'
            && tieneAppAdminEn(request.resource.data.empresaId))
          || (request.resource.data.rol == 'profesional'
            && administraVisitasAreaEn(request.resource.data.empresaId,
              request.resource.data.areaId))
          || (request.resource.data.rol != 'gerencia'
            && request.resource.data.userId != request.auth.token.userDocId
            && gerenciaVisitasEn(request.resource.data.empresaId)));
      allow update: if empresaSeConserva()
        && resource.data.userId == request.resource.data.userId
        && belongsToCompany(resource.data.empresaId)
        && request.resource.data.rol in ['', 'jefe', 'profesional', 'consulta', 'firmante', 'coordinador', 'gerencia']
        && request.resource.data.areaId is string
        && (isDeveloper() || isDeveloperIn(resource.data.empresaId)
          || (resource.data.rol != 'gerencia'
            && request.resource.data.rol != 'gerencia'
            && tieneAppAdminEn(resource.data.empresaId))
          || (resource.data.rol == 'profesional'
            && request.resource.data.rol == 'profesional'
            && resource.data.areaId == request.resource.data.areaId
            && resource.data.userId != request.auth.token.userDocId
            && administraVisitasAreaEn(resource.data.empresaId,
              resource.data.areaId))
          || (resource.data.rol != 'gerencia'
            && request.resource.data.rol != 'gerencia'
            && resource.data.userId != request.auth.token.userDocId
            && gerenciaVisitasEn(resource.data.empresaId)));
      allow delete: if belongsToCompany(resource.data.empresaId)
        && (isDeveloper() || isDeveloperIn(resource.data.empresaId)
          || (resource.data.rol != 'gerencia'
            && tieneAppAdminEn(resource.data.empresaId))
          || (resource.data.rol == 'profesional'
            && resource.data.userId != request.auth.token.userDocId
            && administraVisitasAreaEn(resource.data.empresaId,
              resource.data.areaId))
          || (resource.data.rol != 'gerencia'
            && resource.data.userId != request.auth.token.userDocId
            && gerenciaVisitasEn(resource.data.empresaId)));
    }

    // Grupos de profesionales con sus establecimientos (25 sep 2026). Los
    // arma el jefe de cada área para su área; no se cambian de área (se
    // borra y se crea otro), así un jefe no se lleva el grupo de otro.
    // 8 oct 2026: los grupos son de la EMPRESA (Grupo 6, Grupo 7…), sin
    // departamento: `areaId` queda vacío en los nuevos y solo se conserva en
    // los antiguos. Se arman en Admin › Grupos de trabajo (Administración de
    // la empresa, Gerencia o Desarrollo; el jefe, solo los antiguos de su
    // área) y los
    // consumen Visitas e Interventoría, así que los lee cualquiera de la
    // empresa: solo contienen ids de personas y de establecimientos.
    match /TBL_VISITAS_GRUPOS/{docId} {
      allow get: if resource == null
        || belongsToCompany(resource.data.empresaId);
      allow list: if belongsToCompany(resource.data.empresaId);
      allow create: if administraVisitasArea(request.resource.data.empresaId,
          request.resource.data.get('areaId', ''))
        || (belongsToCompany(request.resource.data.empresaId)
          && tieneAppAdminEn(request.resource.data.empresaId));
      allow update: if empresaSeConserva()
        && resource.data.get('areaId', '') == request.resource.data.get('areaId', '')
        && (administraVisitasArea(resource.data.empresaId, resource.data.get('areaId', ''))
          || (belongsToCompany(resource.data.empresaId)
            && tieneAppAdminEn(resource.data.empresaId)));
      allow delete: if administraVisitasArea(resource.data.empresaId,
          resource.data.get('areaId', ''))
        || (belongsToCompany(resource.data.empresaId)
          && tieneAppAdminEn(resource.data.empresaId));
    }

    match /TBL_VISITAS_FORMATOS/{docId} {
      allow get: if resource == null
        || participaEnVisitas(resource.data.empresaId);
      // Jefe y profesional (los de todos los días) primero: los chequeos de
      // Desarrollo y Gerencia cuestan ~60 expresiones cada uno (28 sep 2026).
      allow list: if belongsToCompany(resource.data.empresaId)
        && ((rolVisitasEn(resource.data.empresaId, ['jefe', 'profesional'])
            && resource.data.areaId == areaVisitasUsuario(
              resource.data.empresaId, request.auth.token.userDocId))
          || rolVisitasEn(resource.data.empresaId, ['consulta', 'gerencia'])
          || isDeveloper() || isDeveloperIn(resource.data.empresaId)
          || esGerenciaPorFicha(resource.data.empresaId));
      allow create: if administraVisitasArea(request.resource.data.empresaId,
          request.resource.data.areaId);
      // 28 sep 2026: un formato se puede pasar a otro departamento ("SST /
      // HSE" no es un departamento: el de SST lo lleva Talento Humano). Hay
      // que administrar los dos, así que en la práctica solo Desarrollo y
      // Gerencia lo mueven; el jefe sigue en el suyo.
      allow update: if empresaSeConserva()
        && administraVisitasArea(resource.data.empresaId, resource.data.areaId)
        && (resource.data.areaId == request.resource.data.areaId
          || administraVisitasAreaEn(resource.data.empresaId,
            request.resource.data.areaId));
      allow delete: if false;
    }

    // El firmante del establecimiento (25 sep 2026) lee y firma solo las
    // visitas donde el profesional lo designó (`firmanteEstablecimientoId`).
    // 28 sep 2026: el profesional (sus propias visitas) va PRIMERO y por su
    // lado. Iba al final, después de Desarrollo, jefe y Gerencia: a él se le
    // evaluaba todo eso y la consulta de "Mis visitas" pasaba el tope de 1000
    // expresiones (`belongsToCompany` cuesta ~125 y cada chequeo de
    // administrador ~60), así que Firestore la negaba con permission-denied.
    // Lo barato primero: el dueño de la visita, su rol y luego la empresa.
    match /TBL_VISITAS/{docId} {
      allow get: if resource == null
        || esVisitaPropiaDelProfesional()
        || (belongsToCompany(resource.data.empresaId)
          && (esFirmanteDeVisita()
            || esCoordinadorDeVisita()
            || administraVisitasAreaEn(resource.data.empresaId, resource.data.areaId)
            || rolVisitasEn(resource.data.empresaId, ['consulta'])));
      allow list: if esVisitaPropiaDelProfesional()
        || (belongsToCompany(resource.data.empresaId)
          && (esFirmanteDeVisita()
            || esCoordinadorDeVisita()
            || administraVisitasAreaEn(resource.data.empresaId, resource.data.areaId)
            || rolVisitasEn(resource.data.empresaId, ['consulta'])));
      // `numero` es el consecutivo por empresa que asigna el servidor
      // (`visitasAsignarNumero`, 5 oct 2026): la app no lo trae al crear y
      // ninguna actualización de abajo lo deja tocar.
      allow create: if !request.resource.data.keys().hasAny(['numero'])
        && administraVisitasArea(request.resource.data.empresaId,
          request.resource.data.areaId)
        && request.resource.data.asignadoPorId == request.auth.token.userDocId
        && request.resource.data.estado == 'programada'
        && asignacionVisitaValida();
      // 17 sep 2026: reprogramar, encabezado del formato al iniciar, tablas y
      // firmas mientras está en curso. Las firmas van con la visita en curso
      // y NO en el cierre: el cierre solo cambia estado, fin y resultado, así
      // una firma nunca se estampa "al cerrar" sin que el profesional la
      // haya visto antes.
      // 28 sep 2026: la visita se programa sin formato y el profesional lo
      // fija al iniciarla; se inicia y se cierra el día programado; el
      // profesional ya no reprograma: pide el cambio de fecha y el jefe lo
      // aprueba o lo rechaza.
      allow update: if empresaSeConserva()
        && resource.data.profesionalId == request.resource.data.profesionalId
        // La empresa se mira una vez aquí y no en cada rama: cada
        // `belongsToCompany` cuesta expresiones y las reglas tienen un tope
        // de 1000 por petición (28 sep 2026).
        && belongsToCompany(resource.data.empresaId)
        // Lo barato primero (estado, dueño): los roles hacen get() y cuentan
        // contra el tope; con el orden anterior un rechazo llegaba al límite.
        && (
          // El profesional con su propia visita va primero (28 sep 2026):
          // es el caso de todos los días y así no paga los chequeos de
          // administrador, que lo llevaban al tope de expresiones.
          (resource.data.profesionalId == request.auth.token.userDocId
            && rolVisitasEn(resource.data.empresaId, ['profesional'])
            && (
              ((resource.data.estado == 'programada'
                  || resource.data.estado == 'en_curso')
                && esSolicitudFechaDelProfesional())
              || (resource.data.estado == 'programada'
                && request.resource.data.estado == 'en_curso'
                && enElDiaDeLaVisita()
                && request.resource.data.get('formatoId', '') != ''
                && (request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['estado', 'inicio', 'responsableEstablecimiento',
                      'ciudad', 'cargoProfesional', 'updatedAt'])
                  || (resource.data.get('formatoId', '') == ''
                    && request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['estado', 'inicio', 'responsableEstablecimiento',
                        'ciudad', 'cargoProfesional', 'formatoId',
                        'formatoNombre', 'formatoAsignado', 'updatedAt'])
                    && formatoDeVisitaValido(request.resource.data))))
              || (resource.data.estado == 'en_curso'
                && request.resource.data.estado == 'en_curso'
                && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['respuestas', 'tablas', 'observacionGeneral',
                    'responsableEstablecimiento', 'ciudad', 'cargoProfesional',
                    'firmaProfesional', 'firmaEstablecimiento',
                    'firmanteEstablecimientoId', 'evidenciasAdicionales',
                    'updatedAt'])
                && firmaVisitaSinCambiosDeContenido())
              || (resource.data.estado == 'en_curso'
                && request.resource.data.estado == 'terminada'
                && enElDiaDeLaVisita()
                && request.resource.data.cerradaPor == request.auth.token.userDocId
                && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['estado', 'fin', 'cumplimiento', 'tareasCreadas',
                    'cerradaPor', 'updatedAt']))
            ))
          // Jefe del departamento, Desarrollo o Gerencia.
          || ((
            (resource.data.estado == 'programada'
              && (
                (request.resource.data.estado == 'cancelada'
                  && request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['estado', 'motivoCancelacion', 'updatedAt']))
                || esReprogramacionDeVisita()
                || esRespuestaDeSolicitudFecha()
              ))
            || (resource.data.estado == 'en_curso'
              && (esRespuestaDeSolicitudFecha()
                || esAprobacionDeFechaEnCurso()))
          )
            && administraVisitasAreaEn(resource.data.empresaId, resource.data.areaId))
          // El firmante designado estampa su firma y nada más, con la
          // visita en curso y sin firma previa del establecimiento.
          || (resource.data.estado == 'en_curso'
            && request.resource.data.estado == 'en_curso'
            && esFirmanteDeVisita()
            && (!('firmaEstablecimiento' in resource.data)
              || resource.data.firmaEstablecimiento == null)
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['firmaEstablecimiento', 'updatedAt']))
        );
      allow delete: if false;
    }

    // Coordinador (8 oct 2026): lee solo las visitas que lo nombran en
    // `coordinadorIds`, campo que escribe el servidor desde los grupos
    // (`visitasCoordinadores`). Nunca escribe.
    function esCoordinadorDeVisita() {
      return request.auth.token.userDocId
          in resource.data.get('coordinadorIds', [])
        && rolVisitasEn(resource.data.empresaId, ['coordinador']);
    }

    // La visita es del profesional que la pide y él tiene el rol en la
    // empresa. Primero la comparación (gratis), luego su rol (un get) y al
    // final la empresa, que es lo más caro.
    function esVisitaPropiaDelProfesional() {
      return resource.data.profesionalId == request.auth.token.userDocId
        && rolVisitasEn(resource.data.empresaId, ['profesional'])
        && belongsToCompany(resource.data.empresaId);
    }

    function esFirmanteDeVisita() {
      return 'firmanteEstablecimientoId' in resource.data
        && resource.data.firmanteEstablecimientoId is string
        && resource.data.firmanteEstablecimientoId.size() > 0
        && resource.data.firmanteEstablecimientoId == request.auth.token.userDocId;
    }

    // Al programar: el profesional tiene el rol en el departamento de la
    // visita. Desde el 28 sep 2026 va sin formato (lo elige el profesional
    // al iniciar); una app vieja que todavía lo mande sigue pasando si la
    // copia coincide con el formato guardado.
    function asignacionVisitaValida() {
      let v = request.resource.data;
      let profesional = /databases/$(database)/documents/TBL_VISITAS_ROLES/$(v.empresaId + '_' + v.profesionalId);
      return v.profesionalId is string && v.esPrueba is bool
        && ((v.get('formatoId', '') == '' && v.get('formatoAsignado', null) == null)
          || formatoDeVisitaValido(v))
        && ((exists(profesional)
          && get(profesional).data.rol == 'profesional'
          && areaVisitasUsuario(v.empresaId, v.profesionalId) == v.areaId)
          || (v.esPrueba && v.profesionalId == request.auth.token.userDocId));
    }

    // La copia del formato que lleva la visita es la del formato guardado,
    // de su empresa y de su departamento, y vigente (un borrador solo en
    // pruebas).
    function formatoDeVisitaValido(v) {
      let formato = /databases/$(database)/documents/TBL_VISITAS_FORMATOS/$(v.formatoId);
      return v.formatoId is string && v.formatoId.size() > 0
        && v.formatoAsignado is map
        && exists(formato)
        && get(formato).data.empresaId == v.empresaId
        && get(formato).data.estado != 'retirado'
        && v.formatoAsignado.empresaId == v.empresaId
        && v.areaId == get(formato).data.areaId
        && v.formatoAsignado.areaId == v.areaId
        && v.formatoAsignado.version == get(formato).data.version
        && v.formatoAsignado.items == get(formato).data.items
        && v.formatoAsignado.partes == get(formato).data.partes
        && v.formatoAsignado.tablas == get(formato).data.tablas
        && (v.get('esPrueba', false) == true || get(formato).data.estado == 'vigente');
    }

    // La visita se inicia y se cierra el día programado (28 sep 2026: "debe
    // terminarse el mismo día"). `fechaProgramada` es la medianoche local del
    // día, así que el día va de ahí a 24 horas después. Las pruebas no.
    function enElDiaDeLaVisita() {
      return resource.data.get('esPrueba', false) == true
        || (request.time >= resource.data.fechaProgramada
          && request.time < resource.data.fechaProgramada + duration.value(1, 'd'));
    }

    // El profesional pide el cambio de fecha: solo escribe la solicitud,
    // pendiente y a su nombre, y no si ya hay otra esperando respuesta.
    function esSolicitudFechaDelProfesional() {
      let s = request.resource.data.get('solicitudCambioFecha', null);
      return request.resource.data.estado == resource.data.estado
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['solicitudCambioFecha', 'updatedAt'])
        && s is map
        && s.get('estado', '') == 'pendiente'
        && s.get('porId', '') == request.auth.token.userDocId
        && s.get('fecha', null) is timestamp
        && resource.data.get('solicitudCambioFecha', {}).get('estado', '') != 'pendiente';
    }

    // El jefe la rechaza (o la responde) sin mover nada más.
    function esRespuestaDeSolicitudFecha() {
      return request.resource.data.estado == resource.data.estado
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['solicitudCambioFecha', 'updatedAt'])
        && resource.data.get('solicitudCambioFecha', {}).get('estado', '') == 'pendiente';
    }

    // El jefe aprueba el cambio de una visita que se inició y no se cerró
    // ese día: vuelve a programada en la fecha nueva, sin inicio ni firmas;
    // las respuestas se conservan.
    function esAprobacionDeFechaEnCurso() {
      return request.resource.data.estado == 'programada'
        && resource.data.get('solicitudCambioFecha', {}).get('estado', '') == 'pendiente'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['estado', 'fechaProgramada', 'reprogramaciones',
            'solicitudCambioFecha', 'inicio', 'firmaProfesional',
            'firmaEstablecimiento', 'firmanteEstablecimientoId', 'updatedAt'])
        && request.resource.data.get('inicio', null) == null
        && request.resource.data.get('firmaProfesional', null) == null
        && request.resource.data.get('firmaEstablecimiento', null) == null;
    }

    // La primera firma solo se agrega cuando ya se guardó el contenido.
    // Desde entonces se puede añadir la otra firma, pero no reescribir el
    // acta ni sustituir una firma existente.
    function firmaVisitaSinCambiosDeContenido() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let firmada = ('firmaProfesional' in resource.data
          && resource.data.firmaProfesional != null)
        || ('firmaEstablecimiento' in resource.data
          && resource.data.firmaEstablecimiento != null);
      let firmaEstPendiente = !('firmaEstablecimiento' in resource.data)
        || resource.data.firmaEstablecimiento == null;
      // Con el contenido firmado solo se agregan firmas; mientras falte la
      // del establecimiento se puede cambiar a quién se le pide (25 sep 2026).
      return firmada
        ? (changed.hasOnly(['firmaProfesional', 'firmaEstablecimiento', 'updatedAt'])
            || (firmaEstPendiente
              && changed.hasOnly(['firmanteEstablecimientoId',
                'responsableEstablecimiento', 'updatedAt'])))
          && (!('firmaProfesional' in resource.data)
            || resource.data.firmaProfesional == null
            || request.resource.data.firmaProfesional == resource.data.firmaProfesional)
          && (!('firmaEstablecimiento' in resource.data)
            || resource.data.firmaEstablecimiento == null
            || request.resource.data.firmaEstablecimiento == resource.data.firmaEstablecimiento)
        : (!changed.hasAny(['firmaProfesional', 'firmaEstablecimiento'])
          || changed.hasOnly(['firmaProfesional', 'firmaEstablecimiento', 'updatedAt']));
    }

    // Reprogramar solo mueve la fecha y añade al historial; el estado sigue
    // en 'programada'. Si el profesional había pedido el cambio, queda
    // resuelto en la misma escritura.
    // 1 oct 2026: una visita que no se cumplió (ya pasó su día) solo se
    // mueve si el profesional pidió la reasignación: así queda el registro
    // del incumplimiento. Mismo criterio que `visitaIncumplida` en la app.
    function esReprogramacionDeVisita() {
      return request.resource.data.estado == 'programada'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['fechaProgramada', 'reprogramaciones',
            'solicitudCambioFecha', 'updatedAt'])
        && (resource.data.get('esPrueba', false) == true
          || request.time < resource.data.fechaProgramada + duration.value(1, 'd')
          || resource.data.get('solicitudCambioFecha', {}).get('estado', '') == 'pendiente');
    }

    // Maestro de ubicaciones de los establecimientos: lo lee cualquiera
    // que participe en Visitas (el profesional lo necesita para iniciar),
    // lo escriben Desarrollo y Gerencia (26 sep 2026). Ni los profesionales
    // ni los jefes de área: es lo que decide si una visita se puede iniciar.
    // 1 oct 2026: el maestro completo solo lo listan quienes programan o lo
    // administran (Desarrollo, Gerencia y jefes). El profesional ya no tiene
    // el "¿Dónde estoy?" que lo listaba entero: lee por id la referencia de
    // SU establecimiento al iniciar y al cerrar.
    match /TBL_VISITAS_UBICACIONES/{docId} {
      allow get: if resource == null
        || participaEnVisitas(resource.data.empresaId);
      allow list: if belongsToCompany(resource.data.empresaId)
        && administraVisitasEn(resource.data.empresaId);
      allow create: if belongsToCompany(request.resource.data.empresaId)
        && (isDeveloper() || isDeveloperIn(request.resource.data.empresaId)
          || esGerenciaVisitas(request.resource.data.empresaId));
      allow update: if empresaSeConserva()
        && (isDeveloperFor(resource.data.empresaId)
          || isDeveloperIn(resource.data.empresaId)
          || esGerenciaVisitas(resource.data.empresaId));
      allow delete: if isDeveloperFor(resource.data.empresaId)
        || isDeveloperIn(resource.data.empresaId)
        || esGerenciaVisitas(resource.data.empresaId);
    }

    // Establecimientos propios de Visitas (5 oct 2026): los que se visitan y
    // no son centros de costo (no los ve Interventoría). Se administran en
    // Admin › Maestros por módulo › Visitas: los escriben Desarrollo, Admin
    // de la empresa y Gerencia de Visitas. Los lee quien participa en
    // Visitas (jefes para programar y armar grupos) y Admin. El id es
    // `{empresa}_est_{nombre}` y es el `centroId` con que se programan; no se
    // borran (las visitas y los grupos los nombran), se inactivan.
    match /TBL_VISITAS_ESTABLECIMIENTOS/{docId} {
      allow get: if resource == null
        || leeEstablecimientosVisitas(resource.data.empresaId);
      allow list: if leeEstablecimientosVisitas(resource.data.empresaId);
      allow create: if establecimientoVisitasValido(docId, request.resource.data)
        && belongsToCompany(request.resource.data.empresaId)
        && editaEstablecimientosVisitasEn(request.resource.data.empresaId);
      allow update: if empresaSeConserva()
        && resource.data.centroId == request.resource.data.centroId
        && establecimientoVisitasValido(docId, request.resource.data)
        && belongsToCompany(resource.data.empresaId)
        && editaEstablecimientosVisitasEn(resource.data.empresaId);
      allow delete: if false;
    }

    function establecimientoVisitasValido(docId, d) {
      return d.empresaId is string && d.empresaId.size() > 0
        && docId.matches('^' + d.empresaId + '_est_[a-z0-9_]+$')
        && d.centroId == docId
        && d.nombre is string
        && d.nombre.trim().size() >= 2 && d.nombre.size() <= 120
        && d.get('ciudad', '') is string && d.get('ciudad', '').size() <= 80
        && d.enabled is bool;
    }

    // `participaEnVisitas` o Admin, siempre de la misma empresa:
    // `tieneAppAdminEn` solo mira la app, no la empresa.
    function leeEstablecimientosVisitas(empresaId) {
      return belongsToCompany(empresaId)
        && (rolVisitasEn(empresaId,
            ['jefe', 'gerencia', 'profesional', 'consulta', 'firmante', 'coordinador'])
          || tieneAppAdminEn(empresaId)
          || isDeveloper() || isDeveloperIn(empresaId)
          || esGerenciaPorFicha(empresaId));
    }

    // Sin volver a mirar la empresa: va después de un `belongsToCompany`.
    function editaEstablecimientosVisitasEn(empresaId) {
      return isDeveloper() || isDeveloperIn(empresaId)
        || tieneAppAdminEn(empresaId)
        || gerenciaVisitasEn(empresaId);
    }

    // La colección de roles no puede quedar en el fallback general: de otro
    // modo un usuario autenticado podría ascenderse a sí mismo. La primera
    // asignación de administrador la hace Desarrollo; después administra el
    // rol admin_interventoria de esa empresa.
    // `isDeveloperIn` además de `isDeveloper`: el desarrollador real está
    // marcado dentro de `empresasDetalle[empresa]` y no en la raíz, y sin esto
    // Administración le decía "permission-denied" al cambiar un rol
    // (11 sep 2026). Probado en functions/test/interventoria_roles.rules.js.
    function administraInterventoria(empresaId) {
      return isDeveloperFor(empresaId)
        || isDeveloperIn(empresaId)
        || hasInterventoriaRole(empresaId, ['admin_interventoria'])
        || (hasInterventoriaRole(empresaId, ['gerente_interventoria'])
          && tieneAppsEn(empresaId, ['interventoriadashboard', 'interventoria'], false));
    }

    // 29 sep 2026: el módulo pregunta primero por `{empresa}_{usuario}`, que
    // puede no existir (responde vacío), y Admin de la empresa asigna con el
    // contrato validado (roles configurables).
    match /TBL_INTERVENTORIA_ROLES/{docId} {
      allow get: if resource == null || belongsToCompany(resource.data.empresaId);
      allow list: if belongsToCompany(resource.data.empresaId);
      allow create: if gestionaRolesInterventoria(request.resource.data.empresaId,
        asignacionDeTablaValida(docId, request.resource.data,
          nivelesInterventoria()));
      allow update: if empresaSeConserva()
        && gestionaRolesInterventoria(resource.data.empresaId,
          asignacionDeTablaValida(docId, request.resource.data,
            nivelesInterventoria()));
      allow delete: if gestionaRolesInterventoria(resource.data.empresaId, true);
    }

    // Quién escribe roles de Interventoría: su administrador y Desarrollo,
    // como siempre, y Admin de la empresa con el contrato validado. La
    // empresa se mira una sola vez (tope de expresiones).
    function gestionaRolesInterventoria(empresaId, contratoValido) {
      return belongsToCompany(empresaId)
        && (rolEnTabla('TBL_INTERVENTORIA_ROLES', empresaId) == 'admin_interventoria'
          || (contratoValido && tieneAppAdminEn(empresaId))
          || isDeveloper() || isDeveloperIn(empresaId));
    }

    function nivelesInterventoria() {
      return ['', 'admin_interventoria', 'registrador_interventoria',
        'revisor_interventoria', 'calidad_interventoria',
        'gerente_interventoria', 'directivo_interventoria'];
    }

    // La matriz de responsables cambia quién recibe tareas reales. Solo la
    // administra el rol funcional del módulo; el resto conserva lectura.
    match /TBL_INTERVENTORIA_CONFIG/{docId} {
      allow read: if belongsToCompany(docId);
      allow create, update: if administraInterventoria(docId);
      allow delete: if false;
    }

    // ── Maestro de datos bancarios de beneficiarios de pago ──────────────
    //
    // Son DOS colecciones y no dos campos porque Firestore no tiene seguridad
    // por campo: una regla decide si se lee el documento entero. Si Talento
    // Humano pudiera leer el documento para ver el banco, leería el número de
    // cuenta con él, y el enmascarado de la pantalla no lo impediría — basta
    // con abrir la consola.
    //
    // Aquí va todo MENOS el número: nombre, banco, tipo y forma de pago.
    //
    // Hoy solo entra Tesorería, porque el maestro se usa para pagos a
    // proveedores. Cuando Talento Humano gestione la nómina desde su propio
    // módulo, darles acceso será añadir 'talento_humano' a ESTA lista y a
    // ninguna otra: podrán ver y corregir el banco y seguirán sin poder leer el
    // número. Esa es toda la razón de que sean dos colecciones y no dos campos,
    // y por eso el corte se hace ahora aunque el segundo lector no exista
    // todavía: hacerlo después sería una migración.
    // `hasPlanillasRole` ya mira la empresa (y si la persona está habilitada).
    function gestionaPagos(empresaId) {
      return hasPlanillasRole(empresaId, ['tesoreria', 'admin_doc', 'desarrollador']);
    }

    match /TBL_PAGOS_BENEFICIARIOS/{docId} {
      allow read: if gestionaPagos(resource.data.empresaId);
      allow create, update: if gestionaPagos(request.resource.data.empresaId)
        // El número de cuenta no puede colarse aquí ni por descuido ni a
        // propósito: si se admitiera, quedaría legible para Talento Humano y
        // el corte entre las dos colecciones no serviría de nada.
        && !('numeroCuenta' in request.resource.data);
      allow delete: if gestionaPagos(resource.data.empresaId);
    }

    // Y aquí, solo el número de cuenta. Tesorería y la administración
    // documental. Talento Humano NO entra: no le hace falta para su trabajo, y
    // un dato que no se necesita no se expone.
    match /TBL_PAGOS_BENEFICIARIOS_CUENTA/{docId} {
      allow read, delete: if gestionaPagos(resource.data.empresaId);
      allow create, update: if gestionaPagos(request.resource.data.empresaId);
    }

    match /TBL_CORREO_ROLES/{docId} {
      // Mismo caso: quien no tiene rol asignado lee un documento inexistente.
      allow get: if resource == null || belongsToCompany(resource.data.empresaId);
      allow list: if belongsToCompany(resource.data.empresaId);
      // 28 sep 2026: también Admin de la empresa (Admin > Apps, roles y
      // permisos > Correo y Correspondencia), con el contrato validado.
      allow create: if isDeveloperFor(request.resource.data.get('empresaId', null))
        || isCorreoAdmin(request.resource.data.empresaId)
        || (asignacionCorreoValida(docId, request.resource.data)
          && gestionaRolesDeModulo(request.resource.data.empresaId, 'correodashboard'));
      allow update: if empresaSeConserva()
        && (isDeveloperFor(resource.data.empresaId)
          || isCorreoAdmin(resource.data.empresaId)
          || (asignacionCorreoValida(docId, request.resource.data)
            && gestionaRolesDeModulo(resource.data.empresaId, 'correodashboard')));
      allow delete: if isDeveloperFor(resource.data.get('empresaId', null))
        || isCorreoAdmin(resource.data.empresaId);
    }

    // Roles (28 sep 2026). Hasta hoy los cubría la regla general. Los perfiles
    // generales siguen igual (cualquier sesión, como antes); los roles
    // configurables por módulo solo los crea, edita o borra quien los
    // administra en su empresa, y con el contrato de Codex. Un perfil general
    // no se puede convertir en rol de módulo (ni al revés) para saltarse esto.
    function asignacionComprasValida(docId, data) {
      return data.get('empresaId', '') is string && data.get('userId', '') is string
        && data.empresaId.size() > 0 && data.userId.size() > 0
        && docId == data.empresaId + '_' + data.userId
        && data.get('rol', '') in ['admin','calidad','compras','bodega','consultas'];
    }
    match /TBL_COMPRAS_ROLES/{docId} {
      allow get: if isSignedIn() && (resource == null || belongsToCompany(resource.data.empresaId));
      allow list: if belongsToCompany(resource.data.empresaId);
      allow create: if asignacionComprasValida(docId,request.resource.data)
        && asignaEnTablaDeModulo(request.resource.data.empresaId, request.resource.data.userId, 'comprasdashboard');
      allow update: if empresaSeConserva()
        && asignacionComprasValida(docId,request.resource.data)
        && asignaEnTablaDeModulo(resource.data.empresaId, request.resource.data.userId, 'comprasdashboard');
      // Revocar escribe Consultas o retira app/habilitación; borrar resucita
      // asignaciones históricas o el cargo y no es una revocación completa.
      allow delete: if false;
    }

    // `matches` compara el nombre completo. Una expresión regular y no una
    // lista con `in`: cada elemento de una lista cuenta como una expresión
    // contra el tope de 1000, y la regla general mira este grupo.
    function esColeccionCompras(collection) {
      return collection.matches('TBL_COMPRAS_(PRODUCTOS|PROVEEDORES|MARCAS'
        + '|RECEPCIONES|APROBACIONES|FICHAS_TECNICAS|BODEGAS|GRUPOS'
        + '|REQ_DOCUMENTOS|ABASTECIMIENTO|ABASTECIMIENTO_REPORTES'
        + '|AUDITORIA_DOCUMENTOS)');
    }
    // Primera fase: aislamiento por empresa compatible con los niveles por
    // cargo pendientes de consolidación. La escritura por nivel se audita
    // después de materializar todas las asignaciones anteriores. Su `match`
    // está al final, con las colecciones agrupadas.

    // Período de consumo de Abastecimiento (30 sep 2026): configuración de
    // la empresa en Admin › Maestros por módulo › Compras. Espejo de
    // PeriodoConsumoConfig (lib/compras/abastecimiento_periodo.dart): un
    // ciclo de 1 a 62 días desde una fecha 'yyyy-MM-dd' o el mes calendario.
    function periodoConsumoValido(data) {
      let p = data.get('abastecimientoPeriodo', null);
      return p == null || (p is map && (
        (p.keys().hasOnly(['modo']) && p.get('modo', '') == 'mensual')
        || (p.keys().hasOnly(['modo', 'inicioReferencia', 'duracionDias'])
          && p.get('modo', '') == 'ciclo'
          && p.get('inicioReferencia', '') is string
          && p.inicioReferencia.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && p.get('duracionDias', 0) is int
          && p.duracionDias >= 1 && p.duracionDias <= 62)));
    }
    match /TBL_COMPRAS_CONFIG/{empresaId} {
      allow get: if belongsToCompany(empresaId);
      allow list: if belongsToCompany(resource.data.empresaId);
      allow create: if (request.resource.data.keys().hasOnly(['marcaSeq']) && request.resource.data.marcaSeq == 1
          && comprasEscrituraEn(empresaId, ['admin','calidad','compras','bodega']))
        || (gestionaRolesDeModulo(empresaId,'comprasdashboard')
          && periodoConsumoValido(request.resource.data));
      allow update: if (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['marcaSeq'])
          && request.resource.data.marcaSeq == resource.data.get('marcaSeq', 0) + 1
          && comprasEscrituraEn(empresaId, ['admin','calidad','compras','bodega']))
        || (gestionaRolesDeModulo(empresaId,'comprasdashboard')
          && periodoConsumoValido(request.resource.data));
      allow delete: if gestionaRolesDeModulo(empresaId,'comprasdashboard');
    }

    // Bitácora de Admin (Logs): migraciones, limpiezas, cierres,
    // multiempresa. Antes estaba en la regla general y cualquiera la leía,
    // la editaba o la borraba (29 sep 2026). Solo se agrega: nadie la cambia.
    // La crea quien firma la acción, con la hora del servidor; el nombre de
    // la empresa no se exige al crear porque Multiempresa registra con la
    // empresa de referencia de la persona (o '*') en el mismo lote que su
    // cambio, y negar el registro tumbaría el cambio.
    match /TBL_MIGRATIONS_LOGS/{logId} {
      allow read: if isDeveloperFor(resource.data.get('empresaId', ''))
        || (belongsToCompany(resource.data.get('empresaId', ''))
          && tieneAppAdminEn(resource.data.empresaId));
      allow create: if isSignedIn()
        && !cuentaInhabilitada(currentUser())
        && request.resource.data.get('adminUserId', '')
          == request.auth.token.userDocId
        && request.resource.data.get('action', '') is string
        && request.resource.data.action.size() > 0
        && request.resource.data.get('empresaId', '') is string
        && request.resource.data.get('createdAt', null) == request.time;
      allow update, delete: if false;
    }

    match /TBL_ROLES/{docId} {
      allow read: if isSignedIn();
      allow create: if esRolDeModulo(request.resource.data)
        ? (rolDeModuloValido(docId, request.resource.data)
          && gestionaRolesDeModulo(request.resource.data.empresaId,
            request.resource.data.moduleId))
        : isSignedIn();
      allow update: if (esRolDeModulo(resource.data)
          || esRolDeModulo(request.resource.data))
        ? (esRolDeModulo(resource.data) && esRolDeModulo(request.resource.data)
          && empresaSeConserva()
          && resource.data.moduleId == request.resource.data.moduleId
          && rolDeModuloValido(docId, request.resource.data)
          && gestionaRolesDeModulo(resource.data.empresaId, resource.data.moduleId))
        : isSignedIn();
      allow delete: if esRolDeModulo(resource.data)
        ? gestionaRolesDeModulo(resource.data.empresaId, resource.data.moduleId)
        : isSignedIn();
    }

    match /TBL_GD_TIPOS_DOCUMENTALES/{docId} {
      allow read: if belongsToCompany(resource.data.empresaId);
      allow create: if isDeveloperFor(request.resource.data.get('empresaId', null))
        || isCorreoAdmin(request.resource.data.empresaId);
      allow update: if empresaSeConserva()
        && (isDeveloperFor(resource.data.empresaId)
          || isCorreoAdmin(resource.data.empresaId));
      allow delete: if false;
    }

    // La declaración con soporte se valida y registra únicamente en Functions.
    match /TBL_GD_EXPEDIENTES/{docId} {
      allow read, delete: if belongsToCompany(resource.data.empresaId);
      allow create: if belongsToCompany(request.resource.data.empresaId)
        && !request.resource.data.keys().hasAny([
        'respuestaExternaRegistrada', 'respuestaExternaRegistradaPor',
        'respuestaExternaRegistradaAt', 'soportesRespuestaExterna'
      ]);
      allow update: if empresaSeConserva()
        && belongsToCompany(resource.data.empresaId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'respuestaExternaRegistrada', 'respuestaExternaRegistradaPor',
          'respuestaExternaRegistradaAt', 'soportesRespuestaExterna'
        ]);
    }

    match /TBL_GD_EXPEDIENTES_EVENTOS/{docId} {
      allow read: if belongsToCompany(resource.data.empresaId);
      allow create: if belongsToCompany(request.resource.data.empresaId);
      allow update, delete: if false;
    }

    match /TBL_GD_COLABORACION/{docId} {
      allow read: if belongsToCompany(resource.data.empresaId);
      allow create: if belongsToCompany(request.resource.data.empresaId);
      allow update: if empresaSeConserva()
        && belongsToCompany(resource.data.empresaId);
      allow delete: if false;
    }

    match /TBL_GD_VINCULOS/{docId} {
      allow read: if belongsToCompany(resource.data.empresaId);
      allow create: if belongsToCompany(request.resource.data.empresaId);
      allow update: if empresaSeConserva()
        && belongsToCompany(resource.data.empresaId);
      allow delete: if belongsToCompany(resource.data.empresaId);
    }

    // Contadores y códigos internos se escriben exclusivamente en Functions.
    // `TBL_GD_CONTADORES`: cerrada al cliente.
    // Sin `match` propio: la regla general la excluye y ninguna otra la
    // abre (6 oct 2026, reglas más compactas).

    // Consecutivo de tareas por empresa: solo `tareasAsignarNumero` y la
    // incorporación de Admin › Migraciones (Functions) lo leen y escriben.
    // `TBL_TAREAS_CONTADORES`: cerrada al cliente.
    // Sin `match` propio: la regla general la excluye y ninguna otra la
    // abre (6 oct 2026, reglas más compactas).

    // Consecutivo de visitas por empresa (5 oct 2026): solo
    // `visitasAsignarNumero` y la incorporación de Admin › Migraciones.
    // `TBL_VISITAS_CONTADORES`: cerrada al cliente.
    // Sin `match` propio: la regla general la excluye y ninguna otra la
    // abre (6 oct 2026, reglas más compactas).

    // ── Facturación (29 sep 2026) ─────────────────────────────────────────
    // Estaba en la regla general: cualquiera con sesión, de cualquier
    // empresa, leía y cambiaba obligaciones, revisiones y observaciones.
    // Ahora cada documento es de su empresa (`documentoDeSuEmpresa`); la
    // configuración va por el id. El nivel (Gestión, Establecimiento, Visor)
    // vive en la ficha del usuario, que todavía escribe cualquiera (P0): por
    // eso no se exige por acción.
    match /TBL_FAC_CONFIG/{empresaId} {
      allow read, write: if belongsToCompany(empresaId);
    }

    // Las de Facturación y las evaluaciones diagnósticas de Nutrición: solo
    // `documentoDeSuEmpresa`. Un solo `match` (6 oct 2026).
    function esColeccionDeSuEmpresa(collection) {
      return collection.matches('TBL_(FAC_OBLIGACIONES|FAC_ESTABLECIMIENTOS'
        + '|FAC_REVISIONES|FAC_OBSERVACIONES|FAC_AUTORIZACIONES'
        + '|EVALUACIONES_DIAGNOSTICAS)');
    }
    // Su `match` está al final, con las colecciones agrupadas.

    // ── Rutas (28 sep 2026) ───────────────────────────────────────────────
    // Estaba entero en la regla general: cualquiera con sesión, de cualquier
    // empresa, podía darse el rol de administrador, leer las claves de Google
    // y TomTom del estudio de movilidad o la ubicación en vivo de los
    // conductores. Ahora va por empresa y por rol.
    //
    // Roles en `TBL_RUTAS_ROLES/{empresa}_{usuario}` (el id que escriben
    // Administración y `RutasService.guardarRol`): conductor, calidad, admin,
    // admin_calidad y desarrollador, el perfil que prueba todos. Espejo de
    // `RutasDashboardScreen`: el desarrollador de la app entra a todo.
    //
    // Lo que no es sensible (rutas, establecimientos, placas, configuración,
    // asignaciones y la lista de roles) lo lee cualquiera de la empresa:
    // Administración carga los roles de todos los módulos y Talento Humano
    // cierra las asignaciones de quien inhabilita.
    function rolRutas(empresaId) {
      let path = /databases/$(database)/documents/TBL_RUTAS_ROLES/$(empresaId + '_' + request.auth.token.userDocId);
      return exists(path) ? estadoTexto(get(path).data.get('rol', '')) : '';
    }

    function rutasConRol(empresaId, roles) {
      return belongsToCompany(empresaId)
        && (rolRutas(empresaId) in roles
          || isDeveloper() || isDeveloperIn(empresaId));
    }

    function participaEnRutas(empresaId) {
      return rutasConRol(empresaId, ['conductor', 'calidad', 'admin',
        'admin_calidad', 'desarrollador', 'developer']);
    }

    function administraRutas(empresaId) {
      return rutasConRol(empresaId,
        ['admin', 'admin_calidad', 'desarrollador', 'developer']);
    }

    function revisaRutas(empresaId) {
      return rutasConRol(empresaId,
        ['calidad', 'admin_calidad', 'desarrollador', 'developer']);
    }

    function conduceRutas(empresaId) {
      return rutasConRol(empresaId, ['conductor', 'desarrollador', 'developer']);
    }

    // Borrar evidencias y limpiar el historial: solo el perfil de desarrollo.
    function desarrolloRutas(empresaId) {
      return rutasConRol(empresaId, ['desarrollador', 'developer']);
    }

    // Desarrollo asigna cualquier rol. El administrador de Rutas asigna los
    // demás, a otras personas: no se cambia a sí mismo ni da o quita el
    // perfil de desarrollador. [antes] y [despues] son el rol que tenía y el
    // que queda (iguales al crear o borrar): la empresa se mira una sola vez.
    // 29 sep 2026: también Admin de la empresa (roles configurables), sin el
    // perfil de desarrollo.
    function asignaRolRutas(empresaId, userId, antes, despues) {
      return belongsToCompany(empresaId)
        && ((!(antes in ['desarrollador', 'developer'])
            && !(despues in ['desarrollador', 'developer'])
            && (tieneAppAdminEn(empresaId)
              || (userId != request.auth.token.userDocId
                && rolRutas(empresaId) in ['admin', 'admin_calidad'])))
          || isDeveloper() || isDeveloperIn(empresaId));
    }

    match /TBL_RUTAS_ROLES/{docId} {
      allow get: if resource == null || belongsToCompany(resource.data.empresaId);
      allow list: if belongsToCompany(resource.data.empresaId);
      allow create: if docId == request.resource.data.empresaId + '_'
          + request.resource.data.userId
        && request.resource.data.rol in ['', 'conductor', 'calidad', 'admin',
          'admin_calidad', 'desarrollador']
        && asignaRolRutas(request.resource.data.empresaId,
          request.resource.data.userId, request.resource.data.rol,
          request.resource.data.rol);
      allow update: if empresaSeConserva()
        && resource.data.get('userId', '') == request.resource.data.userId
        && request.resource.data.rol in ['', 'conductor', 'calidad', 'admin',
          'admin_calidad', 'desarrollador']
        && asignaRolRutas(resource.data.empresaId, request.resource.data.userId,
          resource.data.get('rol', ''), request.resource.data.rol);
      allow delete: if asignaRolRutas(resource.data.empresaId,
        resource.data.get('userId', ''), resource.data.get('rol', ''),
        resource.data.get('rol', ''));
    }

    // Catálogos de Administración de Rutas. `get` de un id que no existe:
    // la importación desde Excel pregunta por el id antes de crearlo.
    match /TBL_RUTAS/{docId} {
      allow get: if resource == null || belongsToCompany(resource.data.empresaId);
      allow list: if belongsToCompany(resource.data.empresaId);
      allow create: if administraRutas(request.resource.data.empresaId);
      allow update: if empresaSeConserva()
        && administraRutas(resource.data.empresaId);
      allow delete: if administraRutas(resource.data.empresaId);
    }

    match /TBL_RUTAS_ESTABLECIMIENTOS/{docId} {
      allow get: if resource == null || belongsToCompany(resource.data.empresaId);
      allow list: if belongsToCompany(resource.data.empresaId);
      allow create: if administraRutas(request.resource.data.empresaId);
      allow update: if empresaSeConserva()
        && administraRutas(resource.data.empresaId);
      allow delete: if administraRutas(resource.data.empresaId);
    }

    match /TBL_RUTAS_PLACAS/{docId} {
      allow get: if resource == null || belongsToCompany(resource.data.empresaId);
      allow list: if belongsToCompany(resource.data.empresaId);
      allow create: if administraRutas(request.resource.data.empresaId);
      allow update: if empresaSeConserva()
        && administraRutas(resource.data.empresaId);
      allow delete: if false;
    }

    // Configuración (docId = empresa). La crea con valores por defecto quien
    // habilita el módulo en Administración; la cambia Administración de Rutas.
    match /TBL_RUTAS_CONFIG/{empresaId} {
      allow get: if resource == null || belongsToCompany(empresaId);
      allow create: if belongsToCompany(empresaId)
        && request.resource.data.empresaId == empresaId;
      allow update: if request.resource.data.empresaId == empresaId
        && administraRutas(empresaId);
      allow delete: if false;
    }

    // Asignaciones: las abre y releva Administración de Rutas. Talento
    // Humano, al inhabilitar a alguien, cierra su asignación o retira al
    // ayudante (`PersonnelStatusService.changeStatus`); quien lo hace no
    // tiene por qué tener rol en Rutas, así que ese cierre, y solo ese, lo
    // puede escribir cualquiera de la empresa. El histórico no se borra.
    function cierreDeAsignacionPorRetiro() {
      let cambios = request.resource.data.diff(resource.data).affectedKeys();
      let d = request.resource.data;
      return (d.activa == false
          && d.get('cerradaPor', '') == 'inhabilitacion_talento_humano'
          && cambios.hasOnly(['activa', 'vigenteHasta', 'cerradaPor',
            'cerradaCedula']))
        || (d.get('ayudanteCedula', '') == ''
          && d.get('ayudanteRetiradoPor', '') == 'inhabilitacion_talento_humano'
          && cambios.hasOnly(['ayudanteCedula', 'ayudanteNombre',
            'ayudanteRetiradoPor', 'ayudanteRetiradoAt']));
    }

    match /TBL_RUTAS_ASIGNACIONES/{docId} {
      allow get: if resource == null || belongsToCompany(resource.data.empresaId);
      allow list: if belongsToCompany(resource.data.empresaId);
      allow create: if administraRutas(request.resource.data.empresaId);
      allow update: if empresaSeConserva()
        && ((cierreDeAsignacionPorRetiro()
            && belongsToCompany(resource.data.empresaId))
          || administraRutas(resource.data.empresaId));
      allow delete: if false;
    }

    // Evidencias: fotos y ubicación de la entrega. Las ve quien tiene un rol
    // en Rutas. El conductor sube la suya a su nombre, y solo repite la que
    // Calidad rechazó; Calidad aprueba o rechaza sin tocar la foto.
    function evidenciaDelConductor() {
      return request.resource.data.estado == 'pendiente'
        && request.resource.data.createdBy == request.auth.token.userDocId;
    }

    function revisionDeEvidencia() {
      return request.resource.data.estado in ['aprobada', 'rechazada']
        && request.resource.data.revisadoPor == request.auth.token.userDocId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['estado', 'revisadoPor', 'revisadoEn', 'motivoRechazo']);
    }

    match /TBL_RUTAS_EVIDENCIAS/{docId} {
      allow get: if resource == null || participaEnRutas(resource.data.empresaId);
      allow list: if participaEnRutas(resource.data.empresaId);
      allow create: if evidenciaDelConductor()
        && conduceRutas(request.resource.data.empresaId);
      allow update: if empresaSeConserva()
        && ((resource.data.estado == 'rechazada'
            && evidenciaDelConductor()
            && conduceRutas(resource.data.empresaId))
          || (revisionDeEvidencia() && revisaRutas(resource.data.empresaId)));
      allow delete: if desarrolloRutas(resource.data.empresaId);
    }

    // Lo mantiene la Cloud Function `rutasResumenEvidencia`.
    match /TBL_RUTAS_RESUMEN_DIARIO/{docId} {
      allow get: if resource == null || participaEnRutas(resource.data.empresaId);
      allow list: if participaEnRutas(resource.data.empresaId);
      allow create, update: if false;
      allow delete: if desarrolloRutas(resource.data.empresaId);
    }

    // Ubicación en vivo de cada conductor: la ve el centro de control
    // (Administración de Rutas) y cada quien la suya. Se escribe solo la
    // propia, en `{empresa}_{usuario}`.
    match /TBL_RUTAS_UBICACIONES/{docId} {
      allow get: if resource == null
        || (resource.data.userId == request.auth.token.userDocId
          && belongsToCompany(resource.data.empresaId))
        || administraRutas(resource.data.empresaId);
      allow list: if administraRutas(resource.data.empresaId);
      allow create, update: if request.resource.data.userId == request.auth.token.userDocId
        && docId == request.resource.data.empresaId + '_'
          + request.auth.token.userDocId
        && (resource == null || empresaSeConserva())
        && participaEnRutas(request.resource.data.empresaId);
      allow delete: if false;
    }

    // Estudio de movilidad: la configuración guarda las claves de Google y
    // TomTom. Todo es de Administración de Rutas; las mediciones y corridas
    // las escribe la Cloud Function.
    match /TBL_RUTAS_MOV_CONFIG/{empresaId} {
      allow get: if resource == null || administraRutas(empresaId);
      allow create, update: if request.resource.data.empresaId == empresaId
        && administraRutas(empresaId);
      allow delete: if false;
    }

    match /TBL_RUTAS_MOV_HORARIOS/{docId} {
      allow get: if resource == null || administraRutas(resource.data.empresaId);
      allow list: if administraRutas(resource.data.empresaId);
      allow create: if administraRutas(request.resource.data.empresaId);
      allow update: if empresaSeConserva()
        && administraRutas(resource.data.empresaId);
      allow delete: if administraRutas(resource.data.empresaId);
    }

    match /TBL_RUTAS_MOV_MEDICIONES/{docId} {
      allow get: if resource == null || administraRutas(resource.data.empresaId);
      allow list: if administraRutas(resource.data.empresaId);
      allow create, update: if false;
      allow delete: if administraRutas(resource.data.empresaId);
    }

    match /TBL_RUTAS_MOV_RUNS/{docId} {
      allow get: if resource == null || administraRutas(resource.data.empresaId);
      allow list: if administraRutas(resource.data.empresaId);
      allow create, update: if false;
      allow delete: if administraRutas(resource.data.empresaId);
    }

    // ── Tareas: empresa, acceso efectivo y acciones del flujo ─────────────
    // Las subcolecciones son una bitácora: solo se agregan eventos, nunca se
    // modifican ni se borran desde el cliente. El documento raíz conserva la
    // empresa y los participantes; un cambio de responsable valida el destino.
    // "No opera en To-Do" (Talento Humano, 4 oct 2026): `tieneAppsEn` con
    // [tareas] en true.
    function tieneAppTareasEn(empresaId) {
      return tieneAppsEn(empresaId, ['tareasdashboard', 'tareas'], true);
    }

    // Una sola consulta de apps con la lista del módulo de origen (antes
    // cinco funciones casi iguales; 6 oct 2026). Compras y Correo usaban
    // `tieneAppComprasEn`/`tieneAppCorreoEn`, de la misma forma.
    function appsDeOrigenTarea(modulo) {
      return modulo == 'interventoria' ? ['interventoriadashboard', 'interventoria']
        : (modulo == 'compras' ? ['comprasdashboard', 'compras']
        : (modulo == 'facturacion' ? ['facturaciondashboard', 'facturacion']
        : (modulo in ['visita', 'visitas'] ? ['visitasdashboard', 'visitas']
        : (modulo in ['correo', 'gestion_documental'] ? ['correodashboard', 'correo']
        : []))));
    }

    function tieneAppOrigenTareaEn(empresaId, modulo) {
      let apps = appsDeOrigenTarea(modulo);
      return apps.size() > 0 && tieneAppsEn(empresaId, apps, true);
    }

    function puedeVerEquipoTareasEn(empresaId) {
      let u = currentUser();
      let detalle = u.get('empresasDetalle', {});
      let bloque = detalle is map ? detalle.get(empresaId, {}) : {};
      let propio = bloque is map ? bloque.get('puedeVerEquipo', null) : null;
      let raiz = raizEsDeEmpresa(u, empresaId)
        ? u.get('puedeVerEquipo', null) : null;
      let cargo = bloque is map ? bloque.get('cargo', '') : '';
      return propio is bool ? propio
        : (raiz is bool ? raiz
          : (esGerenciaPorFicha(empresaId)
            || (cargo is string && cargo.lower().matches('.*(director|jefe|coordinador|supervisor|gerente|gerencia).*'))));
    }

    // Quien Talento Humano marcó "No opera en To-Do" no recibe tareas.
    function usuarioActivoParaTarea(empresaId, uid) {
      let path = /databases/$(database)/documents/TBL_USUARIOS/$(uid);
      let u = exists(path) ? get(path).data : {};
      let empresas = u.get('empresas', []);
      let detalle = u.get('empresasDetalle', {});
      let bloque = detalle is map ? detalle.get(empresaId, {}) : {};
      return uid is string && uid.size() > 0 && exists(path)
        && ((empresas is list && empresaId in empresas)
          || (detalle is map && empresaId in detalle)
          || u.get('empresaId', '') == empresaId
          || u.get('empresa', '') == empresaId)
        && !(bloque is map && bloque.get('soloTalentoHumano', false) == true)
        && habilitadaEn(u, empresaId);
    }

    function esResponsableTarea(data) {
      return data.get('asignado_uid', data.get('assignedTo', ''))
        == request.auth.token.userDocId;
    }

    function esAprobadorTarea(data) {
      let uid = request.auth.token.userDocId;
      return data.get('aprobador_uid', data.get('approverId', '')) == uid
        || data.get('jefe_uid', data.get('bossId', '')) == uid
        || data.get('creador_id', data.get('creatorId', '')) == uid;
    }

    function esParticipanteTarea(data) {
      let uid = request.auth.token.userDocId;
      // Sin `is list`: con esa guarda Firestore no puede demostrar la
      // consulta `participantes_uid array-contains` ("Antes asignadas").
      return esResponsableTarea(data) || esAprobadorTarea(data)
        || data.get('reasignada_desde_uid', '') == uid
        || uid in data.get('participantes_uid', []);
    }

    // Presupuesto (2 oct 2026): el tope es 1000 expresiones por petición y
    // `belongsToCompany` + la app cuestan cerca de 300. Cada regla de tareas
    // mira primero lo barato (quién es, qué evento, qué campos cambian) y la
    // empresa una sola vez, al final. Antes se evaluaba varias veces y toda
    // petición rechazada, y la reasignación, terminaban en "maximum of 1000".
    //
    // Desarrollo lee sin filtro de empresa: sus herramientas de Admin (cambio
    // de cédula, borrar usuario) buscan las tareas de una persona en todas.
    function puedeLeerTarea(data) {
      let empresaId = data.get('empresaId', '');
      let modulo = data.get('sourceModule', '');
      return (belongsToCompany(empresaId)
          && ((tieneAppTareasEn(empresaId)
              && (esParticipanteTarea(data) || puedeVerEquipoTareasEn(empresaId)))
            || ((modulo == 'interventoria' || esParticipanteTarea(data))
              && tieneAppOrigenTareaEn(empresaId, modulo))
            || tieneAppAdminEn(empresaId)
            || isDeveloperIn(empresaId)
            || (tieneAppsEn(empresaId, ['gerenciadashboard', 'gerencia'], true)
              && esGerenciaPorFicha(empresaId))))
        || isDeveloper();
    }

    // Tareas o Admin en una sola consulta de apps (lista fija: armarla con
    // `concat` cuesta tanto como otra consulta). En una tarea de otro módulo
    // se mira primero la app de ese módulo: quien opera una tarea de
    // Interventoría casi nunca tiene la app de Tareas.
    function puedeOperarTarea(data) {
      let empresaId = data.get('empresaId', '');
      let modulo = data.get('sourceModule', '');
      return belongsToCompany(empresaId)
        && ((modulo != 'tareas' && tieneAppOrigenTareaEn(empresaId, modulo))
          || tieneAppsEn(empresaId,
            ['tareasdashboard', 'tareas', 'admindashboard', 'admin'], true)
          || isDeveloper() || isDeveloperIn(empresaId));
    }

    // `cambios` = claves que cambia la escritura. Se calcula una vez en
    // `tareaActualizacionValida` y pasa a cada rama. Las ramas del flujo
    // (operativo, reasignación directa y aprobador) reciben `propios`: los
    // mismos cambios sin `updatedAt` ni `lastEvent*`, que todas permiten
    // (6 oct 2026: listas más cortas).
    // `numero` es el consecutivo por empresa que asigna el servidor
    // (`tareasAsignarNumero`, 3 oct 2026): la app no lo crea ni lo cambia.
    function tareaBaseConservada(antes, d, cambios) {
      return antes.get('empresaId', '') == d.get('empresaId', '')
        && !cambios.hasAny([
          'empresaId', 'empresas', 'creador_id', 'creatorId',
          'sourceModule', 'source',
          'sourceType', 'origen', 'hallazgoId', 'sourceEntityId', 'numero'
        ]);
    }

    function tareaNuevaValida() {
      let d = request.resource.data;
      let empresaId = d.get('empresaId', '');
      let modulo = d.get('sourceModule', '');
      return d.get('titulo', '') is string && d.titulo.size() > 0
        && !d.keys().hasAny(['numero'])
        && d.get('estado', '') in ['pendiente', 'en_progreso']
        && d.get('status', d.estado) == d.estado
        && d.get('creador_id', '') is string
        && d.creador_id.size() > 0
        && belongsToCompany(empresaId)
        && ((d.creador_id == request.auth.token.userDocId
            && tieneAppTareasEn(empresaId))
          || tieneAppOrigenTareaEn(empresaId, modulo)
          || tieneAppAdminEn(empresaId)
          || isDeveloper() || isDeveloperIn(empresaId))
        && usuarioActivoParaTarea(empresaId, d.get('asignado_uid', ''));
    }

    // Quien la tenía queda en `participantes_uid` para seguir viendo su
    // historial; nadie sale de la lista.
    function tareaConservaParticipantes(antes, d) {
      let anterior = antes.get('asignado_uid', '');
      let nuevo = d.get('asignado_uid', '');
      return anterior != nuevo
        && d.get('participantes_uid', []) is list
        && d.participantes_uid.hasAll(antes.get('participantes_uid', []))
        && anterior in d.participantes_uid
        && nuevo in d.participantes_uid;
    }

    // Además, el destino debe estar activo en la empresa de la tarea.
    function tareaCambioResponsable(antes, d) {
      return tareaConservaParticipantes(antes, d)
        && usuarioActivoParaTarea(antes.get('empresaId', ''),
          d.get('asignado_uid', ''));
    }

    function camposSolicitudReasignacion() {
      return ['solicitud_reasignacion_estado', 'solicitud_reasignacion_at',
        'solicitud_reasignacion_by_uid', 'solicitud_reasignacion_by_nombre',
        'solicitud_reasignacion_to_uid', 'solicitud_reasignacion_to_nombre',
        'solicitud_reasignacion_areaId', 'solicitud_reasignacion_areaNombre',
        'solicitud_reasignacion_cargoId',
        'solicitud_reasignacion_cargoNombre'];
    }

    // Lo que registra el responsable sin cambiar de responsable.
    function tareaCambioOperativo(antes, d, evento, propios) {
      let actual = antes.get('estado', antes.get('status', ''));
      return evento in ['task_avance', 'task_novedad',
          'solicitud_finalizacion', 'solicitud_reasignacion']
        && esResponsableTarea(antes)
        && !(actual in ['finalizado', 'por_aprobar'])
        // Con una reasignación en espera la tarea solo se consulta (4 oct
        // 2026): ni avance, ni novedad, ni finalización, ni otra solicitud.
        && antes.get('solicitud_reasignacion_estado', '') != 'pendiente'
        && d.get('asignado_uid', '') == antes.get('asignado_uid', '')
        && (
          (evento == 'task_avance'
            && d.get('estado', actual) in [actual, 'en_progreso']
            && propios.hasOnly(['estado', 'status', 'fecha_limite', 'dueDate',
              'fecha_actualizacion', 'actualizada_en']))
          || (evento == 'task_novedad'
            && d.get('estado', actual) in [actual, 'en_progreso']
            && propios.hasOnly(['estado', 'status', 'fecha_actualizacion',
              'actualizada_en']))
          || (evento == 'solicitud_finalizacion'
            && antes.get('solicitud_finalizacion_estado', '') != 'pendiente'
            && d.get('estado', '') == 'por_aprobar'
            && d.get('solicitud_finalizacion_estado', '') == 'pendiente'
            && d.get('solicitud_finalizacion_by_uid', '')
              == request.auth.token.userDocId
            && propios.hasOnly(['estado', 'status',
              'solicitud_finalizacion_estado', 'solicitud_finalizacion_at',
              'solicitud_finalizacion_by_uid',
              'solicitud_finalizacion_by_nombre', 'fecha_actualizacion',
              'actualizada_en', 'adjuntos', 'evidencias']))
          // Hacia cualquier área de la empresa: el destino se valida activo
          // en la empresa de la tarea, no en el área del responsable.
          || (evento == 'solicitud_reasignacion'
            && antes.get('solicitud_reasignacion_estado', '') != 'pendiente'
            && d.get('solicitud_reasignacion_estado', '') == 'pendiente'
            && d.get('solicitud_reasignacion_by_uid', '')
              == request.auth.token.userDocId
            && d.get('solicitud_reasignacion_to_uid', '')
              != antes.get('asignado_uid', '')
            && propios.hasOnly(camposSolicitudReasignacion())
            && usuarioActivoParaTarea(antes.get('empresaId', ''),
              d.get('solicitud_reasignacion_to_uid', '')))
        );
    }

    // Interventoría (y las tareas que lo permiten) reasigna sin aprobación:
    // el responsable la entrega a otra persona activa de la empresa, de
    // cualquier área. Estaba dentro de la rama que exige el mismo
    // responsable, así que nunca podía pasar.
    function tareaReasignacionDirecta(antes, d, evento, propios) {
      let actual = antes.get('estado', antes.get('status', ''));
      return evento == 'reasignacion_directa'
        && (antes.get('sourceModule', '') == 'interventoria'
          || antes.get('origen', '') == 'interventoria')
        && esResponsableTarea(antes)
        && !(actual in ['finalizado', 'por_aprobar'])
        && antes.get('solicitud_finalizacion_estado', '') != 'pendiente'
        && d.get('estado', '') == 'en_progreso'
        && d.get('reasignada_por_uid', '') == request.auth.token.userDocId
        && d.get('reasignada_desde_uid', '') == antes.get('asignado_uid', '')
        && propios.hasOnly(camposSolicitudReasignacion().concat([
          'asignado_uid', 'asignado_nombre', 'asignado_cargo_nombre',
          'areaId', 'estado', 'status', 'reasignado', 'reasignada_en',
          'reasignada_desde_uid', 'reasignada_desde_nombre',
          'reasignada_por_uid', 'participantes_uid', 'reasignacion_pendiente',
          'fecha_actualizacion', 'actualizada_en']))
        && tareaCambioResponsable(antes, d);
    }

    function tareaCambioAprobador(antes, d, evento, propios) {
      return evento in ['aprobada', 'task_devuelta', 'reasignacion_aprobada',
          'reasignacion_rechazada', 'task_avance_gestionado']
        && esAprobadorTarea(antes)
        && (
          (evento == 'aprobada'
            && antes.get('solicitud_finalizacion_estado', '') == 'pendiente'
            && d.get('estado', '') == 'finalizado'
            && d.get('solicitud_finalizacion_estado', '') == 'aprobado'
            && d.get('asignado_uid', '') == antes.get('asignado_uid', '')
            && propios.hasOnly(['estado', 'status', 'approved',
              'approvedAt', 'solicitud_finalizacion_estado']))
          || (evento == 'task_devuelta'
            && antes.get('solicitud_finalizacion_estado', '') == 'pendiente'
            && d.get('estado', '') == 'devuelta'
            && d.get('asignado_uid', '') == antes.get('asignado_uid', '')
            && propios.hasOnly(['estado', 'status', 'fecha_limite',
              'approved', 'approvedAt', 'solicitud_finalizacion_estado',
              'solicitud_finalizacion_at', 'solicitud_finalizacion_by_uid',
              'solicitud_finalizacion_by_nombre']))
          || (evento == 'reasignacion_aprobada'
            && antes.get('solicitud_reasignacion_estado', '') == 'pendiente'
            && d.get('solicitud_reasignacion_estado', '') == 'aprobada'
            && d.get('asignado_uid', '')
              == antes.get('solicitud_reasignacion_to_uid', '')
            && d.get('estado', '') == 'en_progreso'
            // El aprobador pasa al jefe inmediato del nuevo responsable
            // (`taskAprobadorTrasReasignar`, 4 oct 2026).
            && propios.hasOnly(['asignado_uid', 'asignado_nombre',
              'asignado_cargo_id', 'asignado_cargo_nombre', 'areaId',
              'estado', 'status', 'reasignado',
              'solicitud_reasignacion_estado', 'reasignacion_resuelta_at',
              'participantes_uid', 'jefe_uid', 'jefe_nombre',
              'aprobador_uid', 'aprobador_nombre', 'approverId',
              'approverName'])
            // El destino ya se validó activo al pedir la reasignación y la
            // aprobación solo puede llevar a ese destino: no se vuelve a leer.
            && tareaConservaParticipantes(antes, d))
          || (evento == 'reasignacion_rechazada'
            && antes.get('solicitud_reasignacion_estado', '') == 'pendiente'
            && d.get('solicitud_reasignacion_estado', '') == 'rechazada'
            && d.get('asignado_uid', '') == antes.get('asignado_uid', '')
            && propios.hasOnly(['solicitud_reasignacion_estado',
              'reasignacion_resuelta_at']))
          || (evento == 'task_avance_gestionado'
            && d.get('asignado_uid', '') == antes.get('asignado_uid', '')
            && propios.hasOnly(['fecha_limite']))
        );
    }

    // Interventoría cierra sus tareas desde el hallazgo. La aprobación de la
    // subsanación no exige una solicitud pendiente en la tarea: el
    // responsable puede haberla registrado en el hallazgo. El cambio de
    // aprobador va por servidor (`interventoriaCambiarAprobador`).
    function tareaCambioModulo(antes, d, cambios) {
      return antes.get('sourceModule', '') == 'interventoria'
        && (
          (antes.get('sourceType', '') == 'devolucion_acta'
            && esResponsableTarea(antes)
            && d.get('estado', '') == 'finalizado'
            && cambios.hasOnly(['estado', 'status',
              'solicitud_finalizacion_estado', 'updatedAt']))
          || (d.get('solicitud_finalizacion_resuelto_por', '')
              == request.auth.token.userDocId
            && esAprobadorTarea(antes)
            && d.get('estado', '') in ['finalizado', 'devuelta']
            && d.get('solicitud_finalizacion_estado', '')
              == (d.estado == 'finalizado' ? 'aprobado' : 'rechazado')
            && cambios.hasOnly(['estado', 'status',
              'solicitud_finalizacion_estado',
              'solicitud_finalizacion_resuelto_por', 'updatedAt']))
        )
        && tieneAppOrigenTareaEn(antes.get('empresaId', ''), 'interventoria');
    }

    function tareaVisto(antes, cambios) {
      return cambios.hasOnly(['visto'])
        && (esParticipanteTarea(antes)
          || puedeVerEquipoTareasEn(antes.get('empresaId', '')));
    }

    // Administración y Desarrollo, fuera del flujo: cierre administrativo por
    // módulo, herramientas de Admin (cambio de cédula) y, en Interventoría,
    // pasar al creador automático las tareas que asignó la matriz. Nunca
    // cambian la empresa. Va al final: solo lo paga quien no pasó arriba.
    function tareaMantenimiento(antes, d, evento, cambios) {
      let empresaId = antes.get('empresaId', '');
      return d.get('empresaId', '') == empresaId
        && belongsToCompany(empresaId)
        && (isDeveloper() || isDeveloperIn(empresaId)
          || (evento == 'admin_module_closeout' && tieneAppAdminEn(empresaId))
          || (antes.get('sourceModule', '') == 'interventoria'
            && d.get('creador_id', '') == 'interventoria_automatica'
            && cambios.hasOnly(['creador_id', 'creatorId', 'creador_nombre',
              'creatorName', 'ejecutadoPorId', 'ejecutadoPorNombre'])
            && rolEnTabla('TBL_INTERVENTORIA_ROLES', empresaId)
              in ['admin_interventoria', 'gerente_interventoria']));
    }

    function tareaActualizacionValida() {
      let antes = resource.data;
      let d = request.resource.data;
      let evento = d.get('lastEventType', '');
      let cambios = d.diff(antes).affectedKeys();
      // Sin la marca del último evento, que escribe toda acción del flujo.
      let propios = cambios.difference(['updatedAt', 'lastEventType',
        'lastEventAt', 'lastEventText'].toSet());
      return (tareaBaseConservada(antes, d, cambios)
          && (tareaCambioOperativo(antes, d, evento, propios)
            || tareaReasignacionDirecta(antes, d, evento, propios)
            || tareaCambioAprobador(antes, d, evento, propios)
            || tareaCambioModulo(antes, d, cambios)
            || tareaVisto(antes, cambios))
          && puedeOperarTarea(antes))
        || tareaMantenimiento(antes, d, evento, cambios);
    }

    function puedeLeerEventoTarea(taskId) {
      let path = /databases/$(database)/documents/TBL_TAREAS/$(taskId);
      return exists(path) && puedeLeerTarea(get(path).data);
    }

    // Bitácora: el comentario de cierre es obligatorio (2 oct 2026, "completar
    // tareas con comentario") y queda en el historial junto con novedades y
    // avances. `posterior` es la tarea al terminar el lote: el evento de
    // finalización solo existe si la tarea cambió de estado en la misma
    // escritura.
    function puedeCrearEventoTarea(taskId, tipo) {
      let path = /databases/$(database)/documents/TBL_TAREAS/$(taskId);
      let tarea = exists(path) ? get(path).data : {};
      let evento = request.resource.data;
      let uid = request.auth.token.userDocId;
      return exists(path)
        && ((tipo == 'avances'
            && evento.get('by', '') == uid
            && evento.get('message', '') is string
            && evento.message.size() > 0
            && esResponsableTarea(tarea))
          || (tipo == 'novedades'
            && ((evento.get('by', '') == uid && esResponsableTarea(tarea))
              || (evento.get('type', '') in ['devolucion', 'respuesta_avance']
                && esAprobadorTarea(tarea))
              // Retroalimentación de quien asignó o aprueba a una novedad
              // del responsable (4 oct 2026).
              || (evento.get('type', '') == 'respuesta_novedad'
                && evento.get('by', '') == uid
                && evento.get('message', '') is string
                && evento.message.size() > 0
                && esAprobadorTarea(tarea))))
          || (tipo == 'finalizacion'
            && evento.get('createdBy', '') == uid
            && ((evento.get('type', '') in ['solicitud_finalizacion', 'finalizacion']
                && evento.get('comment', '') is string
                && evento.comment.trim().size() > 0
                && esResponsableTarea(tarea)
                // El cambio de estado ocurre en la misma escritura: no se
                // agrega una finalización a una tarea ya cerrada o en espera.
                && (evento.type == 'solicitud_finalizacion'
                  ? (tarea.get('solicitud_finalizacion_estado', '') != 'pendiente'
                    && getAfter(path).data.get('solicitud_finalizacion_estado', '') == 'pendiente')
                  : (tarea.get('estado', '') != 'finalizado'
                    && getAfter(path).data.get('estado', '') == 'finalizado')))
              || (evento.get('type', '') == 'aprobacion_finalizacion'
                && esAprobadorTarea(tarea)
                && tarea.get('solicitud_finalizacion_estado', '') == 'pendiente'
                && getAfter(path).data.get('estado', '') == 'finalizado'
                && getAfter(path).data.get('solicitud_finalizacion_estado', '') == 'aprobado'))))
        && puedeOperarTarea(tarea);
    }

    match /TBL_TAREAS/{taskId} {
      allow get: if isSignedIn() && (resource == null || puedeLeerTarea(resource.data));
      allow list: if puedeLeerTarea(resource.data);
      allow create: if tareaNuevaValida();
      allow update: if tareaActualizacionValida();
      allow delete: if belongsToCompany(resource.data.get('empresaId', ''))
        && (tieneAppAdminEn(resource.data.empresaId)
          || isDeveloper() || isDeveloperIn(resource.data.empresaId)
          || (resource.data.get('sourceModule', '') == 'interventoria'
            && resource.data.get('estado', '') != 'finalizado'
            && tieneAppOrigenTareaEn(resource.data.empresaId, 'interventoria')
            && hasInterventoriaRole(resource.data.empresaId,
              ['admin_interventoria', 'gerente_interventoria'])));

      match /{tipo}/{eventoId} {
        allow read: if tipo in ['avances', 'novedades', 'finalizacion']
          && puedeLeerEventoTarea(taskId);
        allow create: if tipo in ['avances', 'novedades', 'finalizacion']
          && puedeCrearEventoTarea(taskId, tipo);
        allow update, delete: if false;
      }
    }

    // ── Colecciones agrupadas en un `match` con comodín ──────────────────
    // Van al final, justo antes de la regla general (6 oct 2026). Firestore
    // evalúa las reglas que coinciden en el orden del archivo y suma lo que
    // cuesta cada una hasta que alguna permite: en medio del archivo, el
    // filtro de cada comodín se le cobraba a toda colección con regla propia
    // que estuviera debajo (Tareas, Rutas, Facturación) contra el tope de
    // 1000 expresiones. Aquí solo lo pagan estas colecciones y las de la
    // regla general.
    // Compras: maestros y operación (`esColeccionCompras`).
    match /{collection}/{docId} {
      allow get: if esColeccionCompras(collection) && isSignedIn() && (resource == null || belongsToCompany(resource.data.empresaId));
      allow list: if esColeccionCompras(collection) && belongsToCompany(resource.data.empresaId);
      allow create: if esColeccionCompras(collection) && comprasEscrituraEn(request.resource.data.empresaId, ['admin','calidad','compras','bodega']);
      allow update: if esColeccionCompras(collection) && empresaSeConserva()
        && comprasEscrituraEn(resource.data.empresaId, ['admin','calidad','compras','bodega']);
      allow delete: if esColeccionCompras(collection) && comprasEscrituraEn(resource.data.empresaId, ['admin','compras','bodega']);
    }

    // Nutrición: las quince colecciones con el mismo contrato
    // (`esColeccionNutricion`).
    match /{collection}/{docId} {
      allow get: if esColeccionNutricion(collection) && (resource == null
        || (documentoDeSuEmpresa() && nutricionLee(resource.data.empresaId)));
      allow list: if esColeccionNutricion(collection)
        && documentoDeSuEmpresa() && nutricionLee(resource.data.empresaId);
      allow create: if esColeccionNutricion(collection) && documentoDeSuEmpresa()
        && nutricionEscribe(collection, request.resource.data.empresaId);
      allow update, delete: if esColeccionNutricion(collection)
        && documentoDeSuEmpresa()
        && nutricionEscribe(collection, resource.data.empresaId);
    }

    // Tablas de roles de Tokens DIAN, Talento Humano y Nutrición
    // (`esTablaDeRoles`).
    match /{collection}/{docId} {
      allow get: if esTablaDeRoles(collection) && isSignedIn()
        && (resource == null || belongsToCompany(resource.data.empresaId));
      allow list: if esTablaDeRoles(collection)
        && belongsToCompany(resource.data.empresaId);
      allow create: if esTablaDeRoles(collection)
        && asignacionDeTablaValida(docId, request.resource.data,
          nivelesDeModulo(moduloDeTablaDeRoles(collection)))
        && asignaEnTablaDeModulo(request.resource.data.empresaId,
          request.resource.data.userId, moduloDeTablaDeRoles(collection));
      allow update: if esTablaDeRoles(collection)
        && empresaSeConserva()
        && asignacionDeTablaValida(docId, request.resource.data,
          nivelesDeModulo(moduloDeTablaDeRoles(collection)))
        && asignaEnTablaDeModulo(resource.data.empresaId,
          request.resource.data.userId, moduloDeTablaDeRoles(collection));
      allow delete: if esTablaDeRoles(collection)
        && asignaEnTablaDeModulo(resource.data.empresaId,
          resource.data.userId, moduloDeTablaDeRoles(collection));
    }

    // Facturación y evaluaciones diagnósticas (`esColeccionDeSuEmpresa`).
    match /{collection}/{docId} {
      allow get: if esColeccionDeSuEmpresa(collection)
        && (resource == null || documentoDeSuEmpresa());
      allow list, create, update, delete: if esColeccionDeSuEmpresa(collection)
        && documentoDeSuEmpresa();
    }

    // Todo lo que no tiene regla propia. Las colecciones con regla propia se
    // excluyen aquí: si no, esta regla las volvería a abrir (Firestore deja
    // pasar si CUALQUIER regla que coincide lo permite). Una expresión
    // regular (`matches` compara el nombre completo) y no una lista con `in`:
    // cada elemento de una lista cuenta como una expresión contra el tope de
    // 1000 (6 oct 2026: la lista de cien colecciones costaba cien).
    match /{collection}/{document=**} {
      allow read, write: if isSignedIn()
        && !esColeccionCompras(collection)
        && !esColeccionNutricion(collection)
        && !esColeccionDeSuEmpresa(collection)
        && !esTablaDeRoles(collection)
        && !collection.matches('TBL_(TAREAS|TAREAS_CONTADORES'
          + '|COMPRAS_ROLES|COMPRAS_CONFIG'
          + '|WHATSAPP_CONFIG|WHATSAPP_AUDITORIA|WHATSAPP_META_ESTADOS'
          + '|CORREO_ALERTAS|CORREO_LISTADOS|CORREO_REGLAS|CORREO_ROLES'
          + '|GD_EXPEDIENTES|GD_TIPOS_DOCUMENTALES|GD_EXPEDIENTES_EVENTOS|GD_COLABORACION|GD_VINCULOS|GD_CONTADORES'
          + '|INTERVENTORIA_VISITAS|INTERVENTORIA_PLANES|INTERVENTORIA_PLAN_ITEMS|INTERVENTORIA_HALLAZGOS|INTERVENTORIA_ROLES|INTERVENTORIA_CONFIG|INTERVENTORIA_SOLICITUDES_ELIMINACION|INTERVENTORIA_CONCEPTOS_SANITARIOS'
          + '|VISITAS|VISITAS_FORMATOS|VISITAS_ROLES|VISITAS_UBICACIONES|VISITAS_GRUPOS|VISITAS_ESTABLECIMIENTOS|VISITAS_CONTADORES'
          + '|ROLES'
          + '|MIGRATIONS_LOGS'
          + '|DIAN_TOKENS|DIAN_TOKEN_ACCESOS|DIAN_TOKEN_CONFIG'
          + '|TH_REQUERIMIENTOS_PERSONAL|LLAMADOS_ATENCION|HISTORIAL_LLAMADOS_ATENCION'
          + '|AUTH_CREDENTIALS|AUTH_LOGIN_ATTEMPTS|AUTH_RECOVERY_CHALLENGES|AUTH_ADMIN_AUDIT'
          + '|LOGIN_SESIONES'
          + '|PAGOS_BENEFICIARIOS|PAGOS_BENEFICIARIOS_CUENTA'
          + '|RUTAS|RUTAS_ROLES|RUTAS_ESTABLECIMIENTOS|RUTAS_PLACAS|RUTAS_CONFIG|RUTAS_ASIGNACIONES|RUTAS_EVIDENCIAS|RUTAS_RESUMEN_DIARIO|RUTAS_UBICACIONES|RUTAS_MOV_CONFIG|RUTAS_MOV_HORARIOS|RUTAS_MOV_MEDICIONES|RUTAS_MOV_RUNS'
          + '|CITAS_NUTRICION|HISTORIAL_NUTRICION'
          + '|FAC_CONFIG'
          + ')');
    }
  }
}
