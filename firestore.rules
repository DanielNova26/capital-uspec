rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null
        && request.auth.token.authVersion == 2
        && request.auth.token.userDocId is string;
    }

    function currentUserPath() {
      return /databases/$(database)/documents/TBL_USUARIOS/$(request.auth.token.userDocId);
    }

    function currentUser() {
      return get(currentUserPath()).data;
    }

    // Espejo de `isDeveloperUser` en lib/utils/user_company.dart. La app
    // reconoce al desarrollador también por un `roleId` que TERMINA en
    // `_desarrollador` (el real es `EMPRESA_001_rutas_desarrollador`, y su
    // `role` es `rutas_desarrollador`, que no está en la lista corta). Sin
    // esto la app lo trataba como desarrollador y las reglas no: Admin le
    // decía "permission-denied" al cambiar un rol (11 sep 2026).
    function esRolDeDesarrollo(valor) {
      return valor is string
        && (valor in ['desarrollador', 'developer', 'superadmin', 'administrador_sistema']
          || valor.matches('.*_(desarrollador|developer)$'));
    }

    // `let` y no seis `currentUser()`: cada llamada cuenta como expresiones
    // evaluadas y las reglas tienen un tope de 1000 por petición. Con las
    // llamadas repetidas el emulador ya avisaba "maximum of 1000 expressions".
    function isDeveloper() {
      let u = currentUser();
      return isSignedIn()
        && (
          ('desarrollador' in u && u.desarrollador == true)
          || ('developer' in u && u.developer == true)
          || ('role' in u && esRolDeDesarrollo(u.role))
          || ('rol' in u && esRolDeDesarrollo(u.rol))
          || ('roleKey' in u && esRolDeDesarrollo(u.roleKey))
          || ('roleId' in u && esRolDeDesarrollo(u.roleId))
        );
    }

    // Una consulta de un módulo debe venir filtrada por empresa. Firestore
    // evalúa esta condición contra cada documento devuelto, por lo que una
    // consulta sin ese filtro falla en lugar de filtrar datos en el servidor.
    function belongsToCompany(empresaId) {
      let u = currentUser();
      return isSignedIn()
        && empresaId is string
        && empresaId.size() > 0
        && (
          ('empresas' in u && u.empresas is list && empresaId in u.empresas)
          || ('empresasDetalle' in u && u.empresasDetalle is map && empresaId in u.empresasDetalle)
          || ('empresaId' in u && u.empresaId == empresaId)
          || ('empresa' in u && u.empresa == empresaId)
          || isDeveloper()
        );
    }

    function interventoriaRolePath(empresaId) {
      return /databases/$(database)/documents/TBL_INTERVENTORIA_ROLES/$(empresaId + '_' + request.auth.token.userDocId);
    }

    function hasInterventoriaRole(empresaId, allowedRoles) {
      return belongsToCompany(empresaId)
        && exists(interventoriaRolePath(empresaId))
        && get(interventoriaRolePath(empresaId)).data.rol in allowedRoles;
    }

    function interventoriaConfigPath(empresaId) {
      return /databases/$(database)/documents/TBL_INTERVENTORIA_CONFIG/$(empresaId);
    }

    // Las empresas sin configuración conservan el flujo histórico. Cuando
    // Administración asigna programas y actas, el servidor exige que cada
    // acta nueva use una de esas plantillas; ocultarla en la UI no bastaría.
    function tipoActaInterventoriaPermitido(empresaId, data) {
      let path = interventoriaConfigPath(empresaId);
      return !exists(path)
        || !('tiposActaHabilitados' in get(path).data)
        || (
          get(path).data.tiposActaHabilitados is list
          && 'tipoActa' in data
          && data.tipoActa is string
          && data.tipoActa in get(path).data.tiposActaHabilitados
        );
    }

    function conservaTipoActaInterventoria(antes, despues) {
      return (
          !('tipoActa' in antes)
          && !('tipoActa' in despues)
        ) || (
          'tipoActa' in antes
          && 'tipoActa' in despues
          && antes.tipoActa == despues.tipoActa
        );
    }

    function visitasRolePath(empresaId) {
      return /databases/$(database)/documents/TBL_VISITAS_ROLES/$(empresaId + '_' + request.auth.token.userDocId);
    }

    function hasVisitasRole(empresaId, allowedRoles) {
      return belongsToCompany(empresaId)
        && exists(visitasRolePath(empresaId))
        && get(visitasRolePath(empresaId)).data.rol in allowedRoles;
    }

    function administraVisitas(empresaId) {
      return belongsToCompany(empresaId)
        && (isDeveloper() || isDeveloperIn(empresaId)
          || hasVisitasRole(empresaId, ['jefe']));
    }

    function areaVisitasUsuario(empresaId, userId) {
      let path = /databases/$(database)/documents/TBL_VISITAS_ROLES/$(empresaId + '_' + userId);
      return exists(path) && 'areaId' in get(path).data
        ? get(path).data.areaId : '';
    }

    function administraVisitasArea(empresaId, areaId) {
      return belongsToCompany(empresaId)
        && (isDeveloper() || isDeveloperIn(empresaId)
          || (areaId is string && areaId.size() > 0
            && hasVisitasRole(empresaId, ['jefe'])
            && areaVisitasUsuario(empresaId, request.auth.token.userDocId) == areaId));
    }

    function participaEnVisitas(empresaId) {
      return administraVisitas(empresaId)
        || hasVisitasRole(empresaId, ['profesional', 'consulta']);
    }

    // Rol del módulo de Planillas de Pago para la empresa activa.
    //
    // Vive en el propio usuario (`empresasDetalle[empresa].rolPlanillas`, o
    // `rolPlanillas` en la raíz), que es donde lo lee la aplicación.
    function planillasRole(empresaId) {
      return isSignedIn() && currentUser().empresasDetalle is map
          && empresaId in currentUser().empresasDetalle
          && currentUser().empresasDetalle[empresaId].rolPlanillas is string
        ? currentUser().empresasDetalle[empresaId].rolPlanillas
        : (currentUser().rolPlanillas is string ? currentUser().rolPlanillas : '');
    }

    // Desarrollador marcado DENTRO de la empresa (`empresasDetalle[e].roleKey`
    // o `roleId` terminado en `_desarrollador`), que es como lo reconoce la
    // aplicación. `isDeveloper()` solo mira la raíz del usuario, así que a
    // quien esté marcado por empresa el servidor le deniega aunque la pantalla
    // le enseñe el botón.
    //
    // Cada acceso va precedido de un `in`: en las reglas, leer un campo que no
    // existe lanza error, y el `&&` se detiene antes de llegar ahí.
    function isDeveloperIn(empresaId) {
      let u = currentUser();
      return isSignedIn()
        && 'empresasDetalle' in u
        && u.empresasDetalle is map
        && empresaId in u.empresasDetalle
        && u.empresasDetalle[empresaId] is map
        && (
          ('roleKey' in u.empresasDetalle[empresaId]
            && esRolDeDesarrollo(u.empresasDetalle[empresaId].roleKey))
          || ('roleId' in u.empresasDetalle[empresaId]
            && esRolDeDesarrollo(u.empresasDetalle[empresaId].roleId))
        );
    }

    function hasPlanillasRole(empresaId, allowedRoles) {
      return belongsToCompany(empresaId)
        && (
          isDeveloper()
          || isDeveloperIn(empresaId)
          || planillasRole(empresaId) in allowedRoles
        );
    }

    function correoRolePath(empresaId) {
      return /databases/$(database)/documents/TBL_CORREO_ROLES/$(empresaId + '_' + request.auth.token.userDocId);
    }

    function isCorreoAdmin(empresaId) {
      return belongsToCompany(empresaId)
        && exists(correoRolePath(empresaId))
        && get(correoRolePath(empresaId)).data.rol in [
          'administrador', 'admin', 'manager', 'gestor', 'superadmin',
          'desarrollador', 'developer'
        ];
    }

    // Credenciales, intentos y retos de recuperación son exclusivamente del
    // backend. Nunca se exponen al cliente, ni siquiera a administradores.
    match /TBL_AUTH_CREDENTIALS/{document=**} {
      allow read, write: if false;
    }
    match /TBL_AUTH_LOGIN_ATTEMPTS/{document=**} {
      allow read, write: if false;
    }
    match /TBL_AUTH_RECOVERY_CHALLENGES/{document=**} {
      allow read, write: if false;
    }
    match /TBL_AUTH_ADMIN_AUDIT/{document=**} {
      allow read, write: if false;
    }

    match /TBL_PACIENTES/{docId} {
      allow read, write: if isSignedIn();
    }
    match /TBL_VALORACIONES_NUTRICION/{docId} {
      allow read, write: if isSignedIn();
    }
    match /TBL_MEDICIONES_NUTRICION/{docId} {
      allow read, write: if isSignedIn();
    }
    match /TBL_PATOLOGIAS/{docId} {
      allow read, write: if isSignedIn();
    }
    match /TBL_DIETAS/{docId} {
      allow read, write: if isSignedIn();
    }
    match /TBL_ASIGNACIONES_DIETA/{docId} {
      allow read, write: if isSignedIn();
    }
    match /TBL_CARNETS_NUTRICION/{docId} {
      allow read, write: if isSignedIn();
    }
    match /TBL_MENUS/{docId} {
      allow read, write: if isSignedIn();
    }
    match /TBL_DERIVACIONES_NUTRICION/{docId} {
      allow read, write: if isSignedIn();
    }
    match /TBL_ALERTAS_NUTRICION/{docId} {
      allow read, write: if isSignedIn();
    }

    // Las credenciales de WhatsApp se administran exclusivamente mediante
    // Cloud Functions. Ni siquiera un cliente autenticado puede leer el
    // ciphertext ni alterar la URL, sesión o módulos habilitados.
    // Los listados conservan su colección histórica para no romper reglas de
    // Correo, pero sólo Administración puede modificarlos mediante Functions.
    match /TBL_CORREO_LISTADOS/{document=**} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Los enlaces Token DIAN y su auditoria solo se exponen mediante
    // Cloud Functions. Esto impide que un cliente lea incluso el ciphertext.
    match /TBL_DIAN_TOKENS/{document=**} {
      allow read, write: if false;
    }
    match /TBL_DIAN_TOKEN_ACCESOS/{document=**} {
      allow read, write: if false;
    }
    match /TBL_DIAN_TOKEN_CONFIG/{document=**} {
      allow read, write: if false;
    }

    // Las eliminaciones de Interventoría requieren una solicitud y aprobación
    // en Cloud Functions. El cliente puede crear/editar, pero nunca borrar.
    // `get` de un documento que NO existe: `resource` es nulo y la regla de
    // pertenencia falla con error, que Firestore convierte en denegado. El
    // registro de un acta lee su id nuevo dentro de una transacción para no
    // crearla dos veces, y con esa regla ningún registrador pudo guardar
    // actas desde el 11 sep 2026 (probado en interventoria_visitas.rules.js).
    // Leer un id inexistente no expone nada: solo dice que no existe.
    match /TBL_INTERVENTORIA_VISITAS/{docId} {
      allow get: if resource == null || belongsToCompany(resource.data.empresaId);
      allow list: if belongsToCompany(resource.data.empresaId);
      allow create: if belongsToCompany(request.resource.data.empresaId)
        && tipoActaInterventoriaPermitido(
          request.resource.data.empresaId,
          request.resource.data
        );
      allow update: if resource.data.empresaId == request.resource.data.empresaId
        && belongsToCompany(resource.data.empresaId)
        && (
          conservaTipoActaInterventoria(
            resource.data,
            request.resource.data
          )
          || tipoActaInterventoriaPermitido(
            request.resource.data.empresaId,
            request.resource.data
          )
        );
      allow delete: if false;
    }
    match /TBL_INTERVENTORIA_HALLAZGOS/{docId} {
      allow get: if resource == null || belongsToCompany(resource.data.empresaId);
      allow list: if belongsToCompany(resource.data.empresaId);
      allow create: if belongsToCompany(request.resource.data.empresaId);
      allow update: if resource.data.empresaId == request.resource.data.empresaId
        && belongsToCompany(resource.data.empresaId);
      // Guardar la revisión de un acta sincroniza sus hallazgos: crea los
      // nuevos y BORRA los que ya no tienen observación y nunca tuvieron
      // tarea. Con `delete: if false` ese batch entero fallaba y el borrador
      // no se guardaba ("permission-denied", 11 sep 2026). Solo se abre ese
      // caso: un hallazgo con tarea asignada sigue sin poderse borrar desde
      // el cliente (lo borra la función de eliminación con su aprobación).
      allow delete: if belongsToCompany(resource.data.empresaId)
        && 'fuente' in resource.data && resource.data.fuente == 'acta'
        && (!('tareaId' in resource.data) || resource.data.tareaId == '');
    }
    match /TBL_INTERVENTORIA_SOLICITUDES_ELIMINACION/{docId} {
      allow read: if belongsToCompany(resource.data.empresaId);
      allow write: if false;
    }

    // El módulo de visitas comparte empresa, pero cada profesional solo puede
    // responder sus propias visitas. Las asignaciones y formatos pertenecen
    // al jefe; el rol no se puede autoasignar usando el fallback general.
    // `get` de un doc que no existe: `resource` es null y evaluar
    // `resource.data` niega la lectura entera. La app pregunta por id si la
    // persona tiene rol, si existe el formato SST o la ubicación del
    // subcentro, y con la regla anterior recibía permission-denied cuando
    // la respuesta era "no existe" (21 sep 2026, "no me quiere cargar").
    // Mismo arreglo que Interventoría el 11 sep.
    match /TBL_VISITAS_ROLES/{docId} {
      allow get: if resource == null
        || (belongsToCompany(resource.data.empresaId)
          && (administraVisitas(resource.data.empresaId)
            || resource.data.userId == request.auth.token.userDocId));
      allow list: if belongsToCompany(resource.data.empresaId)
        && (administraVisitas(resource.data.empresaId)
          || resource.data.userId == request.auth.token.userDocId);
      allow create: if belongsToCompany(request.resource.data.empresaId)
        && docId == request.resource.data.empresaId + '_' + request.resource.data.userId
        && request.resource.data.rol in ['jefe', 'profesional', 'consulta']
        && request.resource.data.areaId is string
        && (isDeveloper() || isDeveloperIn(request.resource.data.empresaId)
          || (request.resource.data.rol == 'profesional'
            && administraVisitasArea(request.resource.data.empresaId,
              request.resource.data.areaId)));
      allow update: if resource.data.empresaId == request.resource.data.empresaId
        && resource.data.userId == request.resource.data.userId
        && belongsToCompany(resource.data.empresaId)
        && request.resource.data.rol in ['jefe', 'profesional', 'consulta']
        && request.resource.data.areaId is string
        && (isDeveloper() || isDeveloperIn(resource.data.empresaId)
          || (resource.data.rol == 'profesional'
            && request.resource.data.rol == 'profesional'
            && resource.data.areaId == request.resource.data.areaId
            && resource.data.userId != request.auth.token.userDocId
            && administraVisitasArea(resource.data.empresaId,
              resource.data.areaId)));
      allow delete: if belongsToCompany(resource.data.empresaId)
        && (isDeveloper() || isDeveloperIn(resource.data.empresaId)
          || (resource.data.rol == 'profesional'
            && resource.data.userId != request.auth.token.userDocId
            && administraVisitasArea(resource.data.empresaId,
              resource.data.areaId)));
    }

    match /TBL_VISITAS_FORMATOS/{docId} {
      allow get: if resource == null
        || participaEnVisitas(resource.data.empresaId);
      allow list: if belongsToCompany(resource.data.empresaId)
        && (isDeveloper() || isDeveloperIn(resource.data.empresaId)
          || hasVisitasRole(resource.data.empresaId, ['consulta'])
          || (hasVisitasRole(resource.data.empresaId, ['jefe', 'profesional'])
            && resource.data.areaId == areaVisitasUsuario(
              resource.data.empresaId, request.auth.token.userDocId)));
      allow create: if administraVisitasArea(request.resource.data.empresaId,
          request.resource.data.areaId);
      allow update: if resource.data.empresaId == request.resource.data.empresaId
        && resource.data.areaId == request.resource.data.areaId
        && administraVisitasArea(resource.data.empresaId, resource.data.areaId);
      allow delete: if false;
    }

    match /TBL_VISITAS/{docId} {
      allow get: if resource == null
        || (belongsToCompany(resource.data.empresaId)
          && (administraVisitasArea(resource.data.empresaId, resource.data.areaId)
            || hasVisitasRole(resource.data.empresaId, ['consulta'])
            || (hasVisitasRole(resource.data.empresaId, ['profesional'])
              && resource.data.profesionalId == request.auth.token.userDocId)));
      allow list: if belongsToCompany(resource.data.empresaId)
        && (administraVisitasArea(resource.data.empresaId, resource.data.areaId)
          || hasVisitasRole(resource.data.empresaId, ['consulta'])
          || (hasVisitasRole(resource.data.empresaId, ['profesional'])
            && resource.data.profesionalId == request.auth.token.userDocId));
      allow create: if administraVisitasArea(request.resource.data.empresaId,
          request.resource.data.areaId)
        && request.resource.data.asignadoPorId == request.auth.token.userDocId
        && request.resource.data.estado == 'programada'
        && asignacionVisitaValida();
      // 17 sep 2026: reprogramar (jefe cualquiera, profesional la suya),
      // encabezado del formato al iniciar, tablas y firmas mientras está en
      // curso. Las firmas van con la visita en curso y NO en el cierre: el
      // cierre solo cambia estado, fin y resultado, así una firma nunca se
      // estampa "al cerrar" sin que el profesional la haya visto antes.
      allow update: if resource.data.empresaId == request.resource.data.empresaId
        && resource.data.profesionalId == request.resource.data.profesionalId
        // Lo barato primero (estado, dueño): `administraVisitas` y
        // `hasVisitasRole` hacen get() y cuentan contra el tope de
        // expresiones; con el orden anterior un rechazo llegaba al límite.
        && (
          (resource.data.estado == 'programada'
            && (
              (request.resource.data.estado == 'cancelada'
                && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['estado', 'motivoCancelacion', 'updatedAt']))
              || esReprogramacionDeVisita()
            )
            && administraVisitasArea(resource.data.empresaId, resource.data.areaId))
          || (resource.data.profesionalId == request.auth.token.userDocId
            && hasVisitasRole(resource.data.empresaId, ['profesional'])
            && (
              (resource.data.estado == 'programada' && esReprogramacionDeVisita())
              || (resource.data.estado == 'programada'
                && request.resource.data.estado == 'en_curso'
                && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['estado', 'inicio', 'responsableEstablecimiento',
                    'ciudad', 'cargoProfesional', 'updatedAt']))
              || (resource.data.estado == 'en_curso'
                && request.resource.data.estado == 'en_curso'
                && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['respuestas', 'tablas', 'observacionGeneral',
                    'responsableEstablecimiento', 'ciudad', 'cargoProfesional',
                    'firmaProfesional', 'firmaEstablecimiento', 'updatedAt'])
                && firmaVisitaSinCambiosDeContenido())
              || (resource.data.estado == 'en_curso'
                && request.resource.data.estado == 'terminada'
                && request.resource.data.cerradaPor == request.auth.token.userDocId
                && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['estado', 'fin', 'cumplimiento', 'tareasCreadas',
                    'cerradaPor', 'updatedAt']))
            ))
        );
      allow delete: if false;
    }

    function asignacionVisitaValida() {
      let v = request.resource.data;
      let formato = /databases/$(database)/documents/TBL_VISITAS_FORMATOS/$(v.formatoId);
      let profesional = /databases/$(database)/documents/TBL_VISITAS_ROLES/$(v.empresaId + '_' + v.profesionalId);
      return v.formatoId is string && v.profesionalId is string
        && v.esPrueba is bool && v.formatoAsignado is map
        && exists(formato)
        && get(formato).data.empresaId == v.empresaId
        && get(formato).data.estado != 'retirado'
        && v.formatoAsignado.empresaId == v.empresaId
        && v.areaId == get(formato).data.areaId
        && v.formatoAsignado.areaId == v.areaId
        && v.formatoAsignado.version == get(formato).data.version
        && v.formatoAsignado.items == get(formato).data.items
        && v.formatoAsignado.partes == get(formato).data.partes
        && v.formatoAsignado.tablas == get(formato).data.tablas
        && (v.esPrueba || get(formato).data.estado == 'vigente')
        && ((exists(profesional)
          && get(profesional).data.rol == 'profesional'
          && areaVisitasUsuario(v.empresaId, v.profesionalId) == v.areaId)
          || (v.esPrueba && v.profesionalId == request.auth.token.userDocId));
    }

    // La primera firma solo se agrega cuando ya se guardó el contenido.
    // Desde entonces se puede añadir la otra firma, pero no reescribir el
    // acta ni sustituir una firma existente.
    function firmaVisitaSinCambiosDeContenido() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let firmada = ('firmaProfesional' in resource.data
          && resource.data.firmaProfesional != null)
        || ('firmaEstablecimiento' in resource.data
          && resource.data.firmaEstablecimiento != null);
      return firmada
        ? changed.hasOnly(['firmaProfesional', 'firmaEstablecimiento', 'updatedAt'])
          && (!('firmaProfesional' in resource.data)
            || resource.data.firmaProfesional == null
            || request.resource.data.firmaProfesional == resource.data.firmaProfesional)
          && (!('firmaEstablecimiento' in resource.data)
            || resource.data.firmaEstablecimiento == null
            || request.resource.data.firmaEstablecimiento == resource.data.firmaEstablecimiento)
        : (!changed.hasAny(['firmaProfesional', 'firmaEstablecimiento'])
          || changed.hasOnly(['firmaProfesional', 'firmaEstablecimiento', 'updatedAt']));
    }

    // Reprogramar solo mueve la fecha y añade al historial; el estado sigue
    // en 'programada'.
    function esReprogramacionDeVisita() {
      return request.resource.data.estado == 'programada'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['fechaProgramada', 'reprogramaciones', 'updatedAt']);
    }

    // Maestro de ubicaciones de los establecimientos: lo lee cualquiera
    // que participe en Visitas (el profesional lo necesita para iniciar),
    // lo escribe solo Desarrollo. No es un rol del módulo a propósito.
    match /TBL_VISITAS_UBICACIONES/{docId} {
      allow get: if resource == null
        || participaEnVisitas(resource.data.empresaId);
      allow list: if participaEnVisitas(resource.data.empresaId);
      allow create: if belongsToCompany(request.resource.data.empresaId)
        && (isDeveloper() || isDeveloperIn(request.resource.data.empresaId));
      allow update: if resource.data.empresaId == request.resource.data.empresaId
        && (isDeveloper() || isDeveloperIn(resource.data.empresaId));
      allow delete: if isDeveloper() || isDeveloperIn(resource.data.empresaId);
    }

    // La colección de roles no puede quedar en el fallback general: de otro
    // modo un usuario autenticado podría ascenderse a sí mismo. La primera
    // asignación de administrador la hace Desarrollo; después administra el
    // rol admin_interventoria de esa empresa.
    // `isDeveloperIn` además de `isDeveloper`: el desarrollador real está
    // marcado dentro de `empresasDetalle[empresa]` y no en la raíz, y sin esto
    // Administración le decía "permission-denied" al cambiar un rol
    // (11 sep 2026). Probado en functions/test/interventoria_roles.rules.js.
    function administraInterventoria(empresaId) {
      return isDeveloper()
        || isDeveloperIn(empresaId)
        || hasInterventoriaRole(empresaId, ['admin_interventoria']);
    }

    match /TBL_INTERVENTORIA_ROLES/{docId} {
      allow read: if belongsToCompany(resource.data.empresaId);
      allow create: if administraInterventoria(request.resource.data.empresaId);
      allow update: if resource.data.empresaId == request.resource.data.empresaId
        && administraInterventoria(resource.data.empresaId);
      allow delete: if administraInterventoria(resource.data.empresaId);
    }

    // La matriz de responsables cambia quién recibe tareas reales. Solo la
    // administra el rol funcional del módulo; el resto conserva lectura.
    match /TBL_INTERVENTORIA_CONFIG/{docId} {
      allow read: if belongsToCompany(docId);
      allow create, update: if administraInterventoria(docId);
      allow delete: if false;
    }

    // ── Maestro de datos bancarios de beneficiarios de pago ──────────────
    //
    // Son DOS colecciones y no dos campos porque Firestore no tiene seguridad
    // por campo: una regla decide si se lee el documento entero. Si Talento
    // Humano pudiera leer el documento para ver el banco, leería el número de
    // cuenta con él, y el enmascarado de la pantalla no lo impediría — basta
    // con abrir la consola.
    //
    // Aquí va todo MENOS el número: nombre, banco, tipo y forma de pago.
    //
    // Hoy solo entra Tesorería, porque el maestro se usa para pagos a
    // proveedores. Cuando Talento Humano gestione la nómina desde su propio
    // módulo, darles acceso será añadir 'talento_humano' a ESTA lista y a
    // ninguna otra: podrán ver y corregir el banco y seguirán sin poder leer el
    // número. Esa es toda la razón de que sean dos colecciones y no dos campos,
    // y por eso el corte se hace ahora aunque el segundo lector no exista
    // todavía: hacerlo después sería una migración.
    match /TBL_PAGOS_BENEFICIARIOS/{docId} {
      allow read: if belongsToCompany(resource.data.empresaId)
        && hasPlanillasRole(resource.data.empresaId, [
          'tesoreria', 'admin_doc', 'desarrollador'
        ]);
      allow create, update: if belongsToCompany(request.resource.data.empresaId)
        && hasPlanillasRole(request.resource.data.empresaId, [
          'tesoreria', 'admin_doc', 'desarrollador'
        ])
        // El número de cuenta no puede colarse aquí ni por descuido ni a
        // propósito: si se admitiera, quedaría legible para Talento Humano y
        // el corte entre las dos colecciones no serviría de nada.
        && !('numeroCuenta' in request.resource.data);
      allow delete: if hasPlanillasRole(resource.data.empresaId, [
        'tesoreria', 'admin_doc', 'desarrollador'
      ]);
    }

    // Y aquí, solo el número de cuenta. Tesorería y la administración
    // documental. Talento Humano NO entra: no le hace falta para su trabajo, y
    // un dato que no se necesita no se expone.
    match /TBL_PAGOS_BENEFICIARIOS_CUENTA/{docId} {
      allow read: if belongsToCompany(resource.data.empresaId)
        && hasPlanillasRole(resource.data.empresaId, [
          'tesoreria', 'admin_doc', 'desarrollador'
        ]);
      allow create, update: if belongsToCompany(request.resource.data.empresaId)
        && hasPlanillasRole(request.resource.data.empresaId, [
          'tesoreria', 'admin_doc', 'desarrollador'
        ]);
      allow delete: if hasPlanillasRole(resource.data.empresaId, [
        'tesoreria', 'admin_doc', 'desarrollador'
      ]);
    }

    match /TBL_CORREO_ROLES/{docId} {
      // Mismo caso: quien no tiene rol asignado lee un documento inexistente.
      allow get: if resource == null || belongsToCompany(resource.data.empresaId);
      allow list: if belongsToCompany(resource.data.empresaId);
      allow create: if isDeveloper() || isCorreoAdmin(request.resource.data.empresaId);
      allow update: if resource.data.empresaId == request.resource.data.empresaId
        && (isDeveloper() || isCorreoAdmin(resource.data.empresaId));
      allow delete: if isDeveloper() || isCorreoAdmin(resource.data.empresaId);
    }

    match /TBL_GD_TIPOS_DOCUMENTALES/{docId} {
      allow read: if belongsToCompany(resource.data.empresaId);
      allow create: if isDeveloper() || isCorreoAdmin(request.resource.data.empresaId);
      allow update: if resource.data.empresaId == request.resource.data.empresaId
        && (isDeveloper() || isCorreoAdmin(resource.data.empresaId));
      allow delete: if false;
    }

    // La declaración con soporte se valida y registra únicamente en Functions.
    match /TBL_GD_EXPEDIENTES/{docId} {
      allow read, delete: if belongsToCompany(resource.data.empresaId);
      allow create: if belongsToCompany(request.resource.data.empresaId)
        && !request.resource.data.keys().hasAny([
        'respuestaExternaRegistrada', 'respuestaExternaRegistradaPor',
        'respuestaExternaRegistradaAt', 'soportesRespuestaExterna'
      ]);
      allow update: if resource.data.empresaId == request.resource.data.empresaId
        && belongsToCompany(resource.data.empresaId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'respuestaExternaRegistrada', 'respuestaExternaRegistradaPor',
          'respuestaExternaRegistradaAt', 'soportesRespuestaExterna'
        ]);
    }

    match /TBL_GD_EXPEDIENTES_EVENTOS/{docId} {
      allow read: if belongsToCompany(resource.data.empresaId);
      allow create: if belongsToCompany(request.resource.data.empresaId);
      allow update, delete: if false;
    }

    match /TBL_GD_COLABORACION/{docId} {
      allow read: if belongsToCompany(resource.data.empresaId);
      allow create: if belongsToCompany(request.resource.data.empresaId);
      allow update: if resource.data.empresaId == request.resource.data.empresaId
        && belongsToCompany(resource.data.empresaId);
      allow delete: if false;
    }

    match /TBL_GD_VINCULOS/{docId} {
      allow read: if belongsToCompany(resource.data.empresaId);
      allow create: if belongsToCompany(request.resource.data.empresaId);
      allow update: if resource.data.empresaId == request.resource.data.empresaId
        && belongsToCompany(resource.data.empresaId);
      allow delete: if belongsToCompany(resource.data.empresaId);
    }

    // Contadores y códigos internos se escriben exclusivamente en Functions.
    match /TBL_GD_CONTADORES/{docId} {
      allow read, write: if false;
    }

    match /{collection}/{document=**} {
      allow read, write: if isSignedIn()
        && collection != 'TBL_WHATSAPP_CONFIG'
        && collection != 'TBL_CORREO_LISTADOS'
        && collection != 'TBL_GD_EXPEDIENTES'
        && collection != 'TBL_INTERVENTORIA_VISITAS'
        && collection != 'TBL_INTERVENTORIA_HALLAZGOS'
        && collection != 'TBL_INTERVENTORIA_ROLES'
        && collection != 'TBL_INTERVENTORIA_CONFIG'
        && collection != 'TBL_INTERVENTORIA_SOLICITUDES_ELIMINACION'
        && collection != 'TBL_VISITAS'
        && collection != 'TBL_VISITAS_FORMATOS'
        && collection != 'TBL_VISITAS_ROLES'
        && collection != 'TBL_VISITAS_UBICACIONES'
        && collection != 'TBL_CORREO_ROLES'
        && collection != 'TBL_GD_TIPOS_DOCUMENTALES'
        && collection != 'TBL_GD_EXPEDIENTES_EVENTOS'
        && collection != 'TBL_GD_COLABORACION'
        && collection != 'TBL_GD_VINCULOS'
        && collection != 'TBL_GD_CONTADORES'
        && collection != 'TBL_DIAN_TOKENS'
        && collection != 'TBL_DIAN_TOKEN_ACCESOS'
        && collection != 'TBL_DIAN_TOKEN_CONFIG'
        && collection != 'TBL_AUTH_CREDENTIALS'
        && collection != 'TBL_AUTH_LOGIN_ATTEMPTS'
        && collection != 'TBL_AUTH_RECOVERY_CHALLENGES'
        && collection != 'TBL_AUTH_ADMIN_AUDIT'
        && collection != 'TBL_PAGOS_BENEFICIARIOS'
        && collection != 'TBL_PAGOS_BENEFICIARIOS_CUENTA';
    }
  }
}
