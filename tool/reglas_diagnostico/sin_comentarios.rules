            'revisor_interventoria', 'gerente_interventoria',
            'directivo_interventoria']);
    }
    function conceptoSanitarioValido(d) {
      return d.get('centroCostoId', '') is string
        && d.centroCostoId.size() > 0
        && d.get('fecha', null) is timestamp
        && d.get('puntaje', -1) is number
        && d.puntaje >= 0 && d.puntaje <= 100
