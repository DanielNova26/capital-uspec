rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null
        && request.auth.token.authVersion == 2
        && request.auth.token.userDocId is string;
    }
    function currentUserPath() {
      return /databases/$(database)/documents/TBL_USUARIOS/$(request.auth.token.userDocId);
    }
    function currentUser() {
      return get(currentUserPath()).data;
    }
    function esRolDeDesarrollo(valor) {
      return valor is string
        && (valor in ['desarrollador', 'developer', 'superadmin', 'administrador_sistema']
          || valor.matches('.*_(desarrollador|developer)$'));
    }
    function isDeveloper() {
      let u = currentUser();
      return isSignedIn()
        && (
          ('desarrollador' in u && u.desarrollador == true)
          || ('developer' in u && u.developer == true)
          || ('role' in u && esRolDeDesarrollo(u.role))
          || ('rol' in u && esRolDeDesarrollo(u.rol))
          || ('roleKey' in u && esRolDeDesarrollo(u.roleKey))
          || ('roleId' in u && esRolDeDesarrollo(u.roleId))
        )
        && !cuentaInhabilitada(u);
    }
    function isDeveloperFor(empresaId) {
      return isDeveloper() && habilitadaEn(currentUser(), empresaId);
    }
    function estadoTexto(valor) {
      return valor is string ? valor.trim().lower() : '';
    }
    function cuentaInhabilitada(u) {
      let estado = estadoTexto(u.get('estado', ''));
      let global = estado != '' ? estado : estadoTexto(u.get('status', ''));
      return u.get('activo', true) == false
        || !(global in ['', 'activo', 'active']);
    }
    function apagadaEnEmpresa(u, empresaId) {
      let detalle = u.get('empresasDetalle', {});
      let bloque = detalle is map ? detalle.get(empresaId, {}) : {};
      let b = bloque is map ? bloque : {};
      let laboral = estadoTexto(b.get('estadoLaboral', ''));
      return b.get('activo', true) == false
        || (laboral != '' ? laboral : estadoTexto(b.get('estado', ''))) == 'inactivo';
    }
    function habilitadaEn(u, empresaId) {
      return !cuentaInhabilitada(u)
        && (!(empresaId is string) || !apagadaEnEmpresa(u, empresaId));
    }
    function belongsToCompany(empresaId) {
      let u = currentUser();
      return isSignedIn()
        && empresaId is string
        && empresaId.size() > 0
        && (
          ('empresas' in u && u.empresas is list && empresaId in u.empresas)
          || ('empresasDetalle' in u && u.empresasDetalle is map && empresaId in u.empresasDetalle)
          || ('empresaId' in u && u.empresaId == empresaId)
          || ('empresa' in u && u.empresa == empresaId)
          || isDeveloper()
        )
        && habilitadaEn(u, empresaId);
    }
    function interventoriaRolePath(empresaId) {
      return /databases/$(database)/documents/TBL_INTERVENTORIA_ROLES/$(empresaId + '_' + request.auth.token.userDocId);
    }
    function hasInterventoriaRole(empresaId, allowedRoles) {
      return belongsToCompany(empresaId)
        && exists(interventoriaRolePath(empresaId))
        && get(interventoriaRolePath(empresaId)).data.rol in allowedRoles;
    }
    function interventoriaConfigPath(empresaId) {
      return /databases/$(database)/documents/TBL_INTERVENTORIA_CONFIG/$(empresaId);
    }
    function tipoActaInterventoriaPermitido(empresaId, data) {
      let path = interventoriaConfigPath(empresaId);
      return !exists(path)
        || !('tiposActaHabilitados' in get(path).data)
        || (
          get(path).data.tiposActaHabilitados is list
          && 'tipoActa' in data
          && data.tipoActa is string
          && data.tipoActa in get(path).data.tiposActaHabilitados
        );
    }
    function conservaTipoActaInterventoria(antes, despues) {
      return (
          !('tipoActa' in antes)
          && !('tipoActa' in despues)
        ) || (
          'tipoActa' in antes
          && 'tipoActa' in despues
          && antes.tipoActa == despues.tipoActa
        );
    }
    function visitasRolePath(empresaId) {
      return /databases/$(database)/documents/TBL_VISITAS_ROLES/$(empresaId + '_' + request.auth.token.userDocId);
    }
    function rolVisitasEn(empresaId, allowedRoles) {
      return exists(visitasRolePath(empresaId))
        && get(visitasRolePath(empresaId)).data.rol in allowedRoles;
    }
    function hasVisitasRole(empresaId, allowedRoles) {
      return belongsToCompany(empresaId)
        && rolVisitasEn(empresaId, allowedRoles);
    }
    function administraVisitasEn(empresaId) {
      return isDeveloper() || isDeveloperIn(empresaId)
        || rolVisitasEn(empresaId, ['jefe', 'gerencia'])
        || esGerenciaPorFicha(empresaId);
    }
    function administraVisitas(empresaId) {
      return belongsToCompany(empresaId) && administraVisitasEn(empresaId);
    }
    function gerenciaVisitasEn(empresaId) {
      return rolVisitasEn(empresaId, ['gerencia'])
        || esGerenciaPorFicha(empresaId);
    }
    function esGerenciaVisitas(empresaId) {
      return belongsToCompany(empresaId) && gerenciaVisitasEn(empresaId);
    }
    function esCargoGerencia(valor) {
      return valor is string
        && valor.trim().lower().matches('(gerente|gerencia).*');
    }
    function primerTexto(a, b) {
      return a is string && a.trim().size() > 0 ? a : b;
    }
    function raizEsDeEmpresa(u, empresaId) {
      return u.get('empresaId', '') == empresaId
        || u.get('empresaId', '') == '';
    }
    function esGerenciaPorFicha(empresaId) {
      let u = currentUser();
      let d = u.get('empresasDetalle', {}).get(empresaId, {});
      let cargoRaiz = raizEsDeEmpresa(u, empresaId)
        ? primerTexto(u.get('cargoNombre', ''), u.get('cargo', ''))
        : '';
      return esCargoGerencia(primerTexto(d.get('cargoNombre', ''),
          primerTexto(d.get('cargo', ''), cargoRaiz)))
        || d.get('roleKey', '') in ['gerencia', 'gerente']
        || (raizEsDeEmpresa(u, empresaId)
          && (u.get('roleKey', '') in ['gerencia', 'gerente']
            || u.get('role', '') in ['gerencia', 'gerente']));
    }
    function areaVisitasUsuario(empresaId, userId) {
      let path = /databases/$(database)/documents/TBL_VISITAS_ROLES/$(empresaId + '_' + userId);
      return exists(path) && 'areaId' in get(path).data
        ? get(path).data.areaId : '';
    }
    function administraVisitasAreaEn(empresaId, areaId) {
      return isDeveloper() || isDeveloperIn(empresaId)
        || (areaId is string && areaId.size() > 0
          && rolVisitasEn(empresaId, ['jefe'])
          && areaVisitasUsuario(empresaId, request.auth.token.userDocId) == areaId)
        || gerenciaVisitasEn(empresaId);
    }
    function administraVisitasArea(empresaId, areaId) {
      return belongsToCompany(empresaId)
        && administraVisitasAreaEn(empresaId, areaId);
    }
    function participaEnVisitas(empresaId) {
      return belongsToCompany(empresaId)
        && (rolVisitasEn(empresaId,
            ['jefe', 'gerencia', 'profesional', 'consulta', 'firmante'])
          || isDeveloper() || isDeveloperIn(empresaId)
          || esGerenciaPorFicha(empresaId));
    }
    function planillasRole(empresaId) {
      let u = currentUser();
      let detalle = u.get('empresasDetalle', {});
      let bloque = detalle is map ? detalle.get(empresaId, {}) : {};
      let propio = bloque is map ? bloque.get('rolPlanillas', null) : null;
      let raiz = u.get('rolPlanillas', '');
      return isSignedIn() && propio is string
        ? propio
        : (raizEsDeEmpresa(u, empresaId) && raiz is string ? raiz : '');
    }
    function isDeveloperIn(empresaId) {
      let u = currentUser();
      return isSignedIn()
        && 'empresasDetalle' in u
        && u.empresasDetalle is map
        && empresaId in u.empresasDetalle
        && u.empresasDetalle[empresaId] is map
        && (
          ('roleKey' in u.empresasDetalle[empresaId]
            && esRolDeDesarrollo(u.empresasDetalle[empresaId].roleKey))
          || ('roleId' in u.empresasDetalle[empresaId]
            && esRolDeDesarrollo(u.empresasDetalle[empresaId].roleId))
        )
        && habilitadaEn(u, empresaId);
    }
    function hasPlanillasRole(empresaId, allowedRoles) {
      return belongsToCompany(empresaId)
        && (
          isDeveloper()
          || isDeveloperIn(empresaId)
          || planillasRole(empresaId) in allowedRoles
        );
    }
    function correoRolePath(empresaId) {
      return /databases/$(database)/documents/TBL_CORREO_ROLES/$(empresaId + '_' + request.auth.token.userDocId);
    }
    function tieneAppAdminEn(empresaId) {
      let u = currentUser();
      let detalle = u.get('empresasDetalle', {});
      let bloque = detalle is map ? detalle.get(empresaId, {}) : {};
      let propias = bloque is map ? bloque.get('apps', null) : null;
      let raiz = u.get('apps', []);
      let admin = ['admindashboard', 'admin'];
      return u.get('appsPorEmpresa', false) == true
        ? (propias is list
          ? propias.hasAny(admin)
          : (raizEsDeEmpresa(u, empresaId) && raiz is list && raiz.hasAny(admin)))
        : ((raiz is list && raiz.hasAny(admin))
          || (propias is list && propias.hasAny(admin)));
    }
    function tieneAppCorreoEn(empresaId) {
      let u = currentUser();
      let detalle = u.get('empresasDetalle', {});
      let bloque = detalle is map ? detalle.get(empresaId, {}) : {};
      let propias = bloque is map ? bloque.get('apps', null) : null;
      let raiz = u.get('apps', []);
      let correo = ['correodashboard', 'correo'];
      return u.get('appsPorEmpresa', false) == true
        ? (propias is list
          ? propias.hasAny(correo)
          : (raizEsDeEmpresa(u, empresaId) && raiz is list && raiz.hasAny(correo)))
        : ((raiz is list && raiz.hasAny(correo))
          || (propias is list && propias.hasAny(correo)));
    }
    function tieneAppTokensDianEn(empresaId) {
      let u = currentUser();
      let detalle = u.get('empresasDetalle', {});
      let bloque = detalle is map ? detalle.get(empresaId, {}) : {};
      let propias = bloque is map ? bloque.get('apps', null) : null;
      let raiz = u.get('apps', []);
      let apps = ['tokensdiandashboard', 'tokensdian', 'tokens'];
      return u.get('appsPorEmpresa', false) == true
        ? (propias is list ? propias.hasAny(apps)
          : (raizEsDeEmpresa(u, empresaId) && raiz is list && raiz.hasAny(apps)))
        : ((raiz is list && raiz.hasAny(apps))
          || (propias is list && propias.hasAny(apps)));
    }
    function tieneAppTalentoEn(empresaId) {
      let u = currentUser();
      let detalle = u.get('empresasDetalle', {});
      let bloque = detalle is map ? detalle.get(empresaId, {}) : {};
      let propias = bloque is map ? bloque.get('apps', null) : null;
      let raiz = u.get('apps', []);
      let apps = ['talentohumanodashboard', 'talentohumano', 'talento'];
      return u.get('appsPorEmpresa', false) == true
        ? (propias is list ? propias.hasAny(apps)
          : (raizEsDeEmpresa(u, empresaId) && raiz is list && raiz.hasAny(apps)))
        : ((raiz is list && raiz.hasAny(apps))
          || (propias is list && propias.hasAny(apps)));
    }
    function tieneAppNutricionEn(empresaId) {
      let u = currentUser();
      let detalle = u.get('empresasDetalle', {});
      let bloque = detalle is map ? detalle.get(empresaId, {}) : {};
      let propias = bloque is map ? bloque.get('apps', null) : null;
      let raiz = u.get('apps', []);
      let apps = ['nutriciondashboard', 'nutricion'];
      return u.get('appsPorEmpresa', false) == true
        ? (propias is list ? propias.hasAny(apps)
          : (raizEsDeEmpresa(u, empresaId) && raiz is list && raiz.hasAny(apps)))
        : ((raiz is list && raiz.hasAny(apps))
          || (propias is list && propias.hasAny(apps)));
    }
    function esAdminCorreoEn(empresaId) {
      return exists(correoRolePath(empresaId))
        && get(correoRolePath(empresaId)).data.rol in [
          'administrador', 'admin', 'manager', 'gestor', 'superadmin',
          'desarrollador', 'developer'
        ];
    }
    function rolEnTabla(coleccion, empresaId) {
      let path = /databases/$(database)/documents/$(coleccion)/$(empresaId + '_' + request.auth.token.userDocId);
      return exists(path) ? estadoTexto(get(path).data.get('rol', '')) : '';
    }
    function adminDeModuloTablaEn(empresaId, moduleId) {
      return (moduleId == 'comprasdashboard' && esAdminComprasEn(empresaId))
        || (moduleId == 'rutasdashboard'
          && rolEnTabla('TBL_RUTAS_ROLES', empresaId) in ['admin', 'admin_calidad'])
        || (moduleId == 'interventoriadashboard'
          && rolEnTabla('TBL_INTERVENTORIA_ROLES', empresaId) == 'admin_interventoria')
        || (moduleId == 'visitasdashboard'
          && rolEnTabla('TBL_VISITAS_ROLES', empresaId) == 'gerencia')
        || (moduleId == 'tokensdiandashboard'
          && tieneAppTokensDianEn(empresaId)
          && rolEnTabla('TBL_DIAN_TOKEN_ROLES', empresaId) == 'administrador')
        || (moduleId == 'talentohumanodashboard'
          && tieneAppTalentoEn(empresaId)
          && rolEnTabla('TBL_TALENTO_HUMANO_ROLES', empresaId) == 'administrador')
        || (moduleId == 'nutriciondashboard'
          && tieneAppNutricionEn(empresaId)
          && rolEnTabla('TBL_NUTRICION_ROLES', empresaId) == 'administrador');
    }
    function esAdminComprasEn(empresaId) {
      let rolePath = comprasRolePath(empresaId);
      return tieneAppComprasEn(empresaId) && exists(rolePath)
        && get(rolePath).data.get('empresaId', '') == empresaId
        && get(rolePath).data.get('userId', '') == request.auth.token.userDocId
        && get(rolePath).data.get('rol', '') == 'admin';
    }
    function comprasRolePath(empresaId) {
      return /databases/$(database)/documents/TBL_COMPRAS_ROLES/$(empresaId + '_' + request.auth.token.userDocId);
    }
    function tieneAppComprasEn(empresaId) {
      let u = currentUser();
      let detalle = u.get('empresasDetalle', {});
      let bloque = detalle is map ? detalle.get(empresaId, {}) : {};
      let propias = bloque is map ? bloque.get('apps', null) : null;
      let raiz = u.get('apps', []);
      let apps = ['comprasdashboard', 'compras'];
      return u.get('appsPorEmpresa', false) == true
        ? (propias is list ? propias.hasAny(apps)
          : (raizEsDeEmpresa(u, empresaId) && raiz is list && raiz.hasAny(apps)))
        : ((raiz is list && raiz.hasAny(apps)) || (propias is list && propias.hasAny(apps)));
    }
    function comprasEscrituraEn(empresaId, niveles) {
      let path = comprasRolePath(empresaId);
      return belongsToCompany(empresaId) && ((tieneAppComprasEn(empresaId)
          && (!exists(path) || (
          get(path).data.get('empresaId', '') == empresaId
          && get(path).data.get('userId', '') == request.auth.token.userDocId
          && get(path).data.get('rol', '') in niveles)))
        || tieneAppAdminEn(empresaId) || isDeveloper() || isDeveloperIn(empresaId));
    }
    function gestionaRolesDeModulo(empresaId, moduleId) {
      return belongsToCompany(empresaId)
        && (tieneAppAdminEn(empresaId)
          || (moduleId == 'correodashboard' && esAdminCorreoEn(empresaId))
          || adminDeModuloTablaEn(empresaId, moduleId)
          || isDeveloper() || isDeveloperIn(empresaId));
    }
    function asignaEnTablaDeModulo(empresaId, userId, moduleId) {
      return belongsToCompany(empresaId)
        && (tieneAppAdminEn(empresaId)
          || (userId != request.auth.token.userDocId
            && adminDeModuloTablaEn(empresaId, moduleId))
          || isDeveloper() || isDeveloperIn(empresaId));
    }
    function asignacionDeTablaValida(docId, data, niveles) {
      return data.get('empresaId', '') is string
        && data.get('userId', '') is string
        && data.userId.size() > 0
        && docId == data.empresaId + '_' + data.userId
        && data.get('rol', '') in niveles;
    }
    function esRolDeModulo(data) {
      return data.get('type', '') == 'module_role';
    }
    function rolDeModuloValido(docId, data) {
      return data.get('empresaId', '') is string
        && data.empresaId.size() > 0
        && docId.size() > data.empresaId.size() + 5
        && docId[0:data.empresaId.size() + 5] == data.empresaId + '_mod_'
        && data.get('moduleId', '') in ['correodashboard',
          'planillaspagodashboard', 'bibliotecadocumentaldashboard',
          'tareasdashboard', 'comprasdashboard', 'rutasdashboard',
          'interventoriadashboard', 'visitasdashboard',
          'tokensdiandashboard', 'talentohumanodashboard',
          'nutriciondashboard', 'facturaciondashboard',
          'gerenciadashboard']
        && (data.moduleId != 'comprasdashboard' || data.get('baseRole', '') in ['admin','calidad','compras','bodega','consultas'])
        && (data.moduleId != 'tokensdiandashboard' || data.get('baseRole', '') in ['consulta','operador','administrador'])
        && (data.moduleId != 'talentohumanodashboard' || data.get('baseRole', '') in ['consulta','solicitante','reclutador','gestor','administrador'])
        && (data.moduleId != 'nutriciondashboard' || data.get('baseRole', '') in ['consulta','clinico','menus','coordinador','administrador'])
        && data.get('enabled', null) is bool
        && data.get('revision', null) is int && data.revision >= 1
        && data.get('nombre', '') is string
        && data.nombre.size() > 0 && data.nombre.size() <= 120;
    }
    function asignacionCorreoValida(docId, data) {
      return data.get('empresaId', '') is string
        && data.get('usuarioId', '') is string
        && docId == data.empresaId + '_' + data.usuarioId
        && data.get('rol', '') in ['visor', 'operador', 'clasificador',
          'administrador'];
    }
    function isCorreoAdmin(empresaId) {
      return belongsToCompany(empresaId)
        && exists(correoRolePath(empresaId))
        && get(correoRolePath(empresaId)).data.rol in [
          'administrador', 'admin', 'manager', 'gestor', 'superadmin',
          'desarrollador', 'developer'
        ];
    }
    match /TBL_AUTH_CREDENTIALS/{document=**} {
      allow read, write: if false;
    }
    match /TBL_AUTH_LOGIN_ATTEMPTS/{document=**} {
      allow read, write: if false;
    }
    match /TBL_AUTH_RECOVERY_CHALLENGES/{document=**} {
      allow read, write: if false;
    }
    match /TBL_AUTH_ADMIN_AUDIT/{document=**} {
      allow read, write: if false;
    }
    match /TBL_LOGIN_SESIONES/{sesionId} {
      allow read: if isDeveloperFor(resource.data.get('empresaId', ''))
        || (belongsToCompany(resource.data.get('empresaId', ''))
          && tieneAppAdminEn(resource.data.empresaId));
      allow create: if isSignedIn()
        && request.resource.data.get('userId', '')
          == request.auth.token.userDocId
        && request.resource.data.get('empresaId', '') is string
        && request.resource.data.empresaId.size() > 0;
      allow update, delete: if false;
    }
    match /TBL_WHATSAPP_AUDITORIA/{auditId} {
      allow read: if isDeveloperFor(resource.data.get('empresaId', ''))
        || (belongsToCompany(resource.data.get('empresaId', ''))
          && tieneAppAdminEn(resource.data.empresaId));
      allow write: if false;
    }
    match /TBL_WHATSAPP_META_ESTADOS/{statusId} {
      allow read, write: if false;
    }
    match /TBL_CORREO_ALERTAS/{alertId} {
      allow read: if isDeveloperFor(resource.data.get('empresaId', ''))
        || (belongsToCompany(resource.data.get('empresaId', ''))
          && (tieneAppAdminEn(resource.data.empresaId)
            || tieneAppCorreoEn(resource.data.empresaId)));
      allow write: if false;
    }
    function documentoDeSuEmpresa() {
      return request.method == 'create'
        ? belongsToCompany(request.resource.data.empresaId)
        : belongsToCompany(resource.data.empresaId)
          && (request.method != 'update'
            || request.resource.data.empresaId == resource.data.empresaId);
    }
    match /TBL_PACIENTES/{docId} {
      allow get: if resource == null || (documentoDeSuEmpresa() && nutricionLee(resource.data.empresaId));
      allow list: if documentoDeSuEmpresa() && nutricionLee(resource.data.empresaId);
      allow create: if documentoDeSuEmpresa() && nutricionEscribeClinica(request.resource.data.empresaId);
      allow update, delete: if documentoDeSuEmpresa() && nutricionEscribeClinica(resource.data.empresaId);
    }
    match /TBL_VALORACIONES_NUTRICION/{docId} {
      allow get: if resource == null || (documentoDeSuEmpresa() && nutricionLee(resource.data.empresaId));
      allow list: if documentoDeSuEmpresa() && nutricionLee(resource.data.empresaId);
      allow create: if documentoDeSuEmpresa() && nutricionEscribeClinica(request.resource.data.empresaId);
      allow update, delete: if documentoDeSuEmpresa() && nutricionEscribeClinica(resource.data.empresaId);
    }
    match /TBL_MEDICIONES_NUTRICION/{docId} {
      allow get: if resource == null || (documentoDeSuEmpresa() && nutricionLee(resource.data.empresaId));
      allow list: if documentoDeSuEmpresa() && nutricionLee(resource.data.empresaId);
      allow create: if documentoDeSuEmpresa() && nutricionEscribeClinica(request.resource.data.empresaId);
      allow update, delete: if documentoDeSuEmpresa() && nutricionEscribeClinica(resource.data.empresaId);
    }
    match /TBL_PATOLOGIAS/{docId} {
      allow get: if resource == null || (documentoDeSuEmpresa() && nutricionLee(resource.data.empresaId));
      allow list: if documentoDeSuEmpresa() && nutricionLee(resource.data.empresaId);
      allow create: if documentoDeSuEmpresa() && nutricionEscribeClinica(request.resource.data.empresaId);
      allow update, delete: if documentoDeSuEmpresa() && nutricionEscribeClinica(resource.data.empresaId);
    }
    match /TBL_DIETAS/{docId} {
      allow get: if resource == null || (documentoDeSuEmpresa() && nutricionLee(resource.data.empresaId));
      allow list: if documentoDeSuEmpresa() && nutricionLee(resource.data.empresaId);
      allow create: if documentoDeSuEmpresa() && nutricionEscribeMenus(request.resource.data.empresaId);
      allow update, delete: if documentoDeSuEmpresa() && nutricionEscribeMenus(resource.data.empresaId);
    }
    match /TBL_ASIGNACIONES_DIETA/{docId} {
      allow get: if resource == null || (documentoDeSuEmpresa() && nutricionLee(resource.data.empresaId));
      allow list: if documentoDeSuEmpresa() && nutricionLee(resource.data.empresaId);
