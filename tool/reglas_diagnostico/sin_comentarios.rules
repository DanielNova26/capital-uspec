    function nivelNutricionEn(empresaId) {
      let rolePath = /databases/$(database)/documents/TBL_NUTRICION_ROLES/$(empresaId + '_' + request.auth.token.userDocId);
      return !belongsToCompany(empresaId) ? ''
        : (isDeveloper() || isDeveloperIn(empresaId)
            || tieneAppAdminEn(empresaId)) ? 'administrador'
        : !tieneAppNutricionEn(empresaId) ? ''
        : exists(rolePath) ? estadoTexto(get(rolePath).data.get('rol', ''))
            : 'administrador';
    }
    function nutricionLee(empresaId) {
      return nivelNutricionEn(empresaId) in
        ['consulta','clinico','menus','coordinador','administrador'];
    }
    function nutricionEscribeClinica(empresaId) {
      return nivelNutricionEn(empresaId) in
        ['clinico','coordinador','administrador'];
    }
    function nutricionEscribeMenus(empresaId) {
      return nivelNutricionEn(empresaId) in
        ['menus','coordinador','administrador'];
