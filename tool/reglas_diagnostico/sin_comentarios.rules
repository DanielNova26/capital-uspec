              || (resource.data.estado == 'en_curso'
                && request.resource.data.estado == 'en_curso'
                && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['respuestas', 'tablas', 'observacionGeneral',
                    'responsableEstablecimiento', 'ciudad', 'cargoProfesional',
                    'firmaProfesional', 'firmaEstablecimiento',
                    'firmanteEstablecimientoId', 'evidenciasAdicionales',
                    'updatedAt'])
                && firmaVisitaSinCambiosDeContenido())
              || (resource.data.estado == 'en_curso'
                && request.resource.data.estado == 'terminada'
                && enElDiaDeLaVisita()
                && request.resource.data.cerradaPor == request.auth.token.userDocId
                && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['estado', 'fin', 'cumplimiento', 'tareasCreadas',
                    'cerradaPor', 'updatedAt']))
            ))
          || ((
            (resource.data.estado == 'programada'
              && (
                (request.resource.data.estado == 'cancelada'
                  && request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['estado', 'motivoCancelacion', 'updatedAt']))
                || esReprogramacionDeVisita()
                || esRespuestaDeSolicitudFecha()
              ))
            || (resource.data.estado == 'en_curso'
              && (esRespuestaDeSolicitudFecha()
                || esAprobacionDeFechaEnCurso()))
          )
            && administraVisitasAreaEn(resource.data.empresaId, resource.data.areaId))
          || (resource.data.estado == 'en_curso'
            && request.resource.data.estado == 'en_curso'
            && esFirmanteDeVisita()
            && (!('firmaEstablecimiento' in resource.data)
              || resource.data.firmaEstablecimiento == null)
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['firmaEstablecimiento', 'updatedAt']))
        );
      allow delete: if false;
    }
    function esVisitaPropiaDelProfesional() {
      return resource.data.profesionalId == request.auth.token.userDocId
        && rolVisitasEn(resource.data.empresaId, ['profesional'])
        && belongsToCompany(resource.data.empresaId);
    }
    function esFirmanteDeVisita() {
      return 'firmanteEstablecimientoId' in resource.data
        && resource.data.firmanteEstablecimientoId is string
        && resource.data.firmanteEstablecimientoId.size() > 0
        && resource.data.firmanteEstablecimientoId == request.auth.token.userDocId;
    }
    function asignacionVisitaValida() {
      let v = request.resource.data;
      let profesional = /databases/$(database)/documents/TBL_VISITAS_ROLES/$(v.empresaId + '_' + v.profesionalId);
      return v.profesionalId is string && v.esPrueba is bool
        && ((v.get('formatoId', '') == '' && v.get('formatoAsignado', null) == null)
          || formatoDeVisitaValido(v))
        && ((exists(profesional)
          && get(profesional).data.rol == 'profesional'
          && areaVisitasUsuario(v.empresaId, v.profesionalId) == v.areaId)
          || (v.esPrueba && v.profesionalId == request.auth.token.userDocId));
    }
    function formatoDeVisitaValido(v) {
      let formato = /databases/$(database)/documents/TBL_VISITAS_FORMATOS/$(v.formatoId);
      return v.formatoId is string && v.formatoId.size() > 0
        && v.formatoAsignado is map
        && exists(formato)
        && get(formato).data.empresaId == v.empresaId
        && get(formato).data.estado != 'retirado'
        && v.formatoAsignado.empresaId == v.empresaId
        && v.areaId == get(formato).data.areaId
        && v.formatoAsignado.areaId == v.areaId
        && v.formatoAsignado.version == get(formato).data.version
        && v.formatoAsignado.items == get(formato).data.items
        && v.formatoAsignado.partes == get(formato).data.partes
        && v.formatoAsignado.tablas == get(formato).data.tablas
        && (v.get('esPrueba', false) == true || get(formato).data.estado == 'vigente');
    }
    function enElDiaDeLaVisita() {
      return resource.data.get('esPrueba', false) == true
        || (request.time >= resource.data.fechaProgramada
          && request.time < resource.data.fechaProgramada + duration.value(1, 'd'));
    }
    function esSolicitudFechaDelProfesional() {
      let s = request.resource.data.get('solicitudCambioFecha', null);
      return request.resource.data.estado == resource.data.estado
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['solicitudCambioFecha', 'updatedAt'])
        && s is map
        && s.get('estado', '') == 'pendiente'
        && s.get('porId', '') == request.auth.token.userDocId
        && s.get('fecha', null) is timestamp
        && resource.data.get('solicitudCambioFecha', {}).get('estado', '') != 'pendiente';
    }
    function esRespuestaDeSolicitudFecha() {
      return request.resource.data.estado == resource.data.estado
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['solicitudCambioFecha', 'updatedAt'])
        && resource.data.get('solicitudCambioFecha', {}).get('estado', '') == 'pendiente';
    }
    function esAprobacionDeFechaEnCurso() {
      return request.resource.data.estado == 'programada'
        && resource.data.get('solicitudCambioFecha', {}).get('estado', '') == 'pendiente'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['estado', 'fechaProgramada', 'reprogramaciones',
            'solicitudCambioFecha', 'inicio', 'firmaProfesional',
            'firmaEstablecimiento', 'firmanteEstablecimientoId', 'updatedAt'])
        && request.resource.data.get('inicio', null) == null
        && request.resource.data.get('firmaProfesional', null) == null
        && request.resource.data.get('firmaEstablecimiento', null) == null;
    }
    function firmaVisitaSinCambiosDeContenido() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let firmada = ('firmaProfesional' in resource.data
          && resource.data.firmaProfesional != null)
        || ('firmaEstablecimiento' in resource.data
          && resource.data.firmaEstablecimiento != null);
      let firmaEstPendiente = !('firmaEstablecimiento' in resource.data)
        || resource.data.firmaEstablecimiento == null;
      return firmada
        ? (changed.hasOnly(['firmaProfesional', 'firmaEstablecimiento', 'updatedAt'])
            || (firmaEstPendiente
              && changed.hasOnly(['firmanteEstablecimientoId',
                'responsableEstablecimiento', 'updatedAt'])))
          && (!('firmaProfesional' in resource.data)
            || resource.data.firmaProfesional == null
            || request.resource.data.firmaProfesional == resource.data.firmaProfesional)
          && (!('firmaEstablecimiento' in resource.data)
            || resource.data.firmaEstablecimiento == null
            || request.resource.data.firmaEstablecimiento == resource.data.firmaEstablecimiento)
        : (!changed.hasAny(['firmaProfesional', 'firmaEstablecimiento'])
          || changed.hasOnly(['firmaProfesional', 'firmaEstablecimiento', 'updatedAt']));
    }
    function esReprogramacionDeVisita() {
      return request.resource.data.estado == 'programada'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['fechaProgramada', 'reprogramaciones',
            'solicitudCambioFecha', 'updatedAt'])
        && (resource.data.get('esPrueba', false) == true
          || request.time < resource.data.fechaProgramada + duration.value(1, 'd')
          || resource.data.get('solicitudCambioFecha', {}).get('estado', '') == 'pendiente');
    }
    match /TBL_VISITAS_UBICACIONES/{docId} {
      allow get: if resource == null
        || participaEnVisitas(resource.data.empresaId);
      allow list: if belongsToCompany(resource.data.empresaId)
        && administraVisitasEn(resource.data.empresaId);
      allow create: if belongsToCompany(request.resource.data.empresaId)
        && (isDeveloper() || isDeveloperIn(request.resource.data.empresaId)
          || esGerenciaVisitas(request.resource.data.empresaId));
      allow update: if resource.data.empresaId == request.resource.data.empresaId
        && (isDeveloperFor(resource.data.empresaId)
          || isDeveloperIn(resource.data.empresaId)
          || esGerenciaVisitas(resource.data.empresaId));
      allow delete: if isDeveloperFor(resource.data.empresaId)
        || isDeveloperIn(resource.data.empresaId)
        || esGerenciaVisitas(resource.data.empresaId);
    }
    match /TBL_VISITAS_ESTABLECIMIENTOS/{docId} {
      allow get: if resource == null
        || leeEstablecimientosVisitas(resource.data.empresaId);
      allow list: if leeEstablecimientosVisitas(resource.data.empresaId);
      allow create: if establecimientoVisitasValido(docId, request.resource.data)
        && belongsToCompany(request.resource.data.empresaId)
        && editaEstablecimientosVisitasEn(request.resource.data.empresaId);
      allow update: if resource.data.empresaId == request.resource.data.empresaId
        && resource.data.centroId == request.resource.data.centroId
        && establecimientoVisitasValido(docId, request.resource.data)
        && belongsToCompany(resource.data.empresaId)
        && editaEstablecimientosVisitasEn(resource.data.empresaId);
      allow delete: if false;
    }
    function establecimientoVisitasValido(docId, d) {
      return d.empresaId is string && d.empresaId.size() > 0
        && docId.matches('^' + d.empresaId + '_est_[a-z0-9_]+$')
        && d.centroId == docId
        && d.nombre is string
        && d.nombre.trim().size() >= 2 && d.nombre.size() <= 120
        && d.get('ciudad', '') is string && d.get('ciudad', '').size() <= 80
        && d.enabled is bool;
    }
    function leeEstablecimientosVisitas(empresaId) {
      return belongsToCompany(empresaId)
        && (rolVisitasEn(empresaId,
            ['jefe', 'gerencia', 'profesional', 'consulta', 'firmante'])
          || tieneAppAdminEn(empresaId)
          || isDeveloper() || isDeveloperIn(empresaId)
          || esGerenciaPorFicha(empresaId));
    }
    function editaEstablecimientosVisitasEn(empresaId) {
      return isDeveloper() || isDeveloperIn(empresaId)
        || tieneAppAdminEn(empresaId)
        || gerenciaVisitasEn(empresaId);
    }
    function administraInterventoria(empresaId) {
      return isDeveloperFor(empresaId)
        || isDeveloperIn(empresaId)
        || hasInterventoriaRole(empresaId, ['admin_interventoria']);
    }
    match /TBL_INTERVENTORIA_ROLES/{docId} {
      allow get: if resource == null || belongsToCompany(resource.data.empresaId);
      allow list: if belongsToCompany(resource.data.empresaId);
      allow create: if gestionaRolesInterventoria(request.resource.data.empresaId,
        asignacionDeTablaValida(docId, request.resource.data,
          nivelesInterventoria()));
      allow update: if resource.data.empresaId == request.resource.data.empresaId
        && gestionaRolesInterventoria(resource.data.empresaId,
          asignacionDeTablaValida(docId, request.resource.data,
            nivelesInterventoria()));
      allow delete: if gestionaRolesInterventoria(resource.data.empresaId, true);
    }
    function gestionaRolesInterventoria(empresaId, contratoValido) {
      return belongsToCompany(empresaId)
        && (rolEnTabla('TBL_INTERVENTORIA_ROLES', empresaId) == 'admin_interventoria'
          || (contratoValido && tieneAppAdminEn(empresaId))
          || isDeveloper() || isDeveloperIn(empresaId));
    }
    function nivelesInterventoria() {
      return ['', 'admin_interventoria', 'registrador_interventoria',
        'revisor_interventoria', 'calidad_interventoria',
        'gerente_interventoria', 'directivo_interventoria'];
    }
    match /TBL_INTERVENTORIA_CONFIG/{docId} {
      allow read: if belongsToCompany(docId);
      allow create, update: if administraInterventoria(docId);
      allow delete: if false;
    }
    match /TBL_PAGOS_BENEFICIARIOS/{docId} {
      allow read: if hasPlanillasRole(resource.data.empresaId, [
          'tesoreria', 'admin_doc', 'desarrollador'
        ]);
      allow create, update: if hasPlanillasRole(request.resource.data.empresaId, [
          'tesoreria', 'admin_doc', 'desarrollador'
        ])
        && !('numeroCuenta' in request.resource.data);
      allow delete: if hasPlanillasRole(resource.data.empresaId, [
        'tesoreria', 'admin_doc', 'desarrollador'
      ]);
    }
    match /TBL_PAGOS_BENEFICIARIOS_CUENTA/{docId} {
      allow read: if hasPlanillasRole(resource.data.empresaId, [
          'tesoreria', 'admin_doc', 'desarrollador'
        ]);
      allow create, update: if hasPlanillasRole(request.resource.data.empresaId, [
          'tesoreria', 'admin_doc', 'desarrollador'
        ]);
      allow delete: if hasPlanillasRole(resource.data.empresaId, [
        'tesoreria', 'admin_doc', 'desarrollador'
      ]);
    }
    match /TBL_CORREO_ROLES/{docId} {
      allow get: if resource == null || belongsToCompany(resource.data.empresaId);
      allow list: if belongsToCompany(resource.data.empresaId);
      allow create: if isDeveloperFor(request.resource.data.get('empresaId', null))
        || isCorreoAdmin(request.resource.data.empresaId)
        || (asignacionCorreoValida(docId, request.resource.data)
          && gestionaRolesDeModulo(request.resource.data.empresaId, 'correodashboard'));
      allow update: if resource.data.empresaId == request.resource.data.empresaId
        && (isDeveloperFor(resource.data.empresaId)
          || isCorreoAdmin(resource.data.empresaId)
          || (asignacionCorreoValida(docId, request.resource.data)
            && gestionaRolesDeModulo(resource.data.empresaId, 'correodashboard')));
      allow delete: if isDeveloperFor(resource.data.get('empresaId', null))
        || isCorreoAdmin(resource.data.empresaId);
    }
    function asignacionComprasValida(docId, data) {
      return data.get('empresaId', '') is string && data.get('userId', '') is string
        && data.empresaId.size() > 0 && data.userId.size() > 0
        && docId == data.empresaId + '_' + data.userId
        && data.get('rol', '') in ['admin','calidad','compras','bodega','consultas'];
    }
    match /TBL_COMPRAS_ROLES/{docId} {
      allow get: if isSignedIn() && (resource == null || belongsToCompany(resource.data.empresaId));
      allow list: if belongsToCompany(resource.data.empresaId);
      allow create: if asignacionComprasValida(docId,request.resource.data)
        && asignaEnTablaDeModulo(request.resource.data.empresaId, request.resource.data.userId, 'comprasdashboard');
      allow update: if resource.data.empresaId == request.resource.data.empresaId
        && asignacionComprasValida(docId,request.resource.data)
        && asignaEnTablaDeModulo(resource.data.empresaId, request.resource.data.userId, 'comprasdashboard');
      allow delete: if false;
    }
    function esColeccionCompras(collection) {
      return collection in ['TBL_COMPRAS_PRODUCTOS','TBL_COMPRAS_PROVEEDORES',
        'TBL_COMPRAS_MARCAS','TBL_COMPRAS_RECEPCIONES','TBL_COMPRAS_APROBACIONES',
        'TBL_COMPRAS_FICHAS_TECNICAS','TBL_COMPRAS_BODEGAS','TBL_COMPRAS_GRUPOS',
        'TBL_COMPRAS_REQ_DOCUMENTOS','TBL_COMPRAS_ABASTECIMIENTO',
        'TBL_COMPRAS_ABASTECIMIENTO_REPORTES','TBL_COMPRAS_AUDITORIA_DOCUMENTOS'];
    }
    match /{collection}/{docId} {
      allow get: if esColeccionCompras(collection) && isSignedIn() && (resource == null || belongsToCompany(resource.data.empresaId));
      allow list: if esColeccionCompras(collection) && belongsToCompany(resource.data.empresaId);
      allow create: if esColeccionCompras(collection) && comprasEscrituraEn(request.resource.data.empresaId, ['admin','calidad','compras','bodega']);
      allow update: if esColeccionCompras(collection) && resource.data.empresaId == request.resource.data.empresaId
        && comprasEscrituraEn(resource.data.empresaId, ['admin','calidad','compras','bodega']);
      allow delete: if esColeccionCompras(collection) && comprasEscrituraEn(resource.data.empresaId, ['admin','compras','bodega']);
    }
    function periodoConsumoValido(data) {
      let p = data.get('abastecimientoPeriodo', null);
      return p == null || (p is map && (
        (p.keys().hasOnly(['modo']) && p.get('modo', '') == 'mensual')
        || (p.keys().hasOnly(['modo', 'inicioReferencia', 'duracionDias'])
          && p.get('modo', '') == 'ciclo'
          && p.get('inicioReferencia', '') is string
          && p.inicioReferencia.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && p.get('duracionDias', 0) is int
          && p.duracionDias >= 1 && p.duracionDias <= 62)));
    }
    match /TBL_COMPRAS_CONFIG/{empresaId} {
      allow get: if belongsToCompany(empresaId);
      allow list: if belongsToCompany(resource.data.empresaId);
      allow create: if (request.resource.data.keys().hasOnly(['marcaSeq']) && request.resource.data.marcaSeq == 1
          && comprasEscrituraEn(empresaId, ['admin','calidad','compras','bodega']))
        || (gestionaRolesDeModulo(empresaId,'comprasdashboard')
          && periodoConsumoValido(request.resource.data));
      allow update: if (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['marcaSeq'])
          && request.resource.data.marcaSeq == resource.data.get('marcaSeq', 0) + 1
          && comprasEscrituraEn(empresaId, ['admin','calidad','compras','bodega']))
        || (gestionaRolesDeModulo(empresaId,'comprasdashboard')
          && periodoConsumoValido(request.resource.data));
      allow delete: if gestionaRolesDeModulo(empresaId,'comprasdashboard');
    }
    match /TBL_MIGRATIONS_LOGS/{logId} {
      allow read: if isDeveloperFor(resource.data.get('empresaId', ''))
        || (belongsToCompany(resource.data.get('empresaId', ''))
          && tieneAppAdminEn(resource.data.empresaId));
      allow create: if isSignedIn()
        && !cuentaInhabilitada(currentUser())
        && request.resource.data.get('adminUserId', '')
          == request.auth.token.userDocId
        && request.resource.data.get('action', '') is string
        && request.resource.data.action.size() > 0
        && request.resource.data.get('empresaId', '') is string
        && request.resource.data.get('createdAt', null) == request.time;
      allow update, delete: if false;
    }
    match /TBL_ROLES/{docId} {
      allow read: if isSignedIn();
      allow create: if esRolDeModulo(request.resource.data)
        ? (rolDeModuloValido(docId, request.resource.data)
          && gestionaRolesDeModulo(request.resource.data.empresaId,
            request.resource.data.moduleId))
        : isSignedIn();
      allow update: if (esRolDeModulo(resource.data)
          || esRolDeModulo(request.resource.data))
        ? (esRolDeModulo(resource.data) && esRolDeModulo(request.resource.data)
          && resource.data.empresaId == request.resource.data.empresaId
          && resource.data.moduleId == request.resource.data.moduleId
          && rolDeModuloValido(docId, request.resource.data)
          && gestionaRolesDeModulo(resource.data.empresaId, resource.data.moduleId))
        : isSignedIn();
      allow delete: if esRolDeModulo(resource.data)
        ? gestionaRolesDeModulo(resource.data.empresaId, resource.data.moduleId)
        : isSignedIn();
    }
    match /TBL_GD_TIPOS_DOCUMENTALES/{docId} {
      allow read: if belongsToCompany(resource.data.empresaId);
      allow create: if isDeveloperFor(request.resource.data.get('empresaId', null))
        || isCorreoAdmin(request.resource.data.empresaId);
      allow update: if resource.data.empresaId == request.resource.data.empresaId
        && (isDeveloperFor(resource.data.empresaId)
          || isCorreoAdmin(resource.data.empresaId));
      allow delete: if false;
    }
    match /TBL_GD_EXPEDIENTES/{docId} {
      allow read, delete: if belongsToCompany(resource.data.empresaId);
      allow create: if belongsToCompany(request.resource.data.empresaId)
        && !request.resource.data.keys().hasAny([
        'respuestaExternaRegistrada', 'respuestaExternaRegistradaPor',
        'respuestaExternaRegistradaAt', 'soportesRespuestaExterna'
      ]);
      allow update: if resource.data.empresaId == request.resource.data.empresaId
        && belongsToCompany(resource.data.empresaId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'respuestaExternaRegistrada', 'respuestaExternaRegistradaPor',
          'respuestaExternaRegistradaAt', 'soportesRespuestaExterna'
        ]);
    }
    match /TBL_GD_EXPEDIENTES_EVENTOS/{docId} {
      allow read: if belongsToCompany(resource.data.empresaId);
      allow create: if belongsToCompany(request.resource.data.empresaId);
      allow update, delete: if false;
    }
    match /TBL_GD_COLABORACION/{docId} {
      allow read: if belongsToCompany(resource.data.empresaId);
      allow create: if belongsToCompany(request.resource.data.empresaId);
      allow update: if resource.data.empresaId == request.resource.data.empresaId
        && belongsToCompany(resource.data.empresaId);
      allow delete: if false;
    }
    match /TBL_GD_VINCULOS/{docId} {
      allow read: if belongsToCompany(resource.data.empresaId);
      allow create: if belongsToCompany(request.resource.data.empresaId);
      allow update: if resource.data.empresaId == request.resource.data.empresaId
        && belongsToCompany(resource.data.empresaId);
      allow delete: if belongsToCompany(resource.data.empresaId);
    }
    match /TBL_GD_CONTADORES/{docId} {
      allow read, write: if false;
    }
    match /TBL_TAREAS_CONTADORES/{docId} {
      allow read, write: if false;
    }
    match /TBL_VISITAS_CONTADORES/{docId} {
      allow read, write: if false;
    }
    match /TBL_FAC_CONFIG/{empresaId} {
      allow read, write: if belongsToCompany(empresaId);
    }
    match /TBL_FAC_OBLIGACIONES/{docId} {
      allow get: if resource == null || documentoDeSuEmpresa();
      allow list, create, update, delete: if documentoDeSuEmpresa();
    }
    match /TBL_FAC_ESTABLECIMIENTOS/{docId} {
      allow get: if resource == null || documentoDeSuEmpresa();
      allow list, create, update, delete: if documentoDeSuEmpresa();
    }
    match /TBL_FAC_REVISIONES/{docId} {
      allow get: if resource == null || documentoDeSuEmpresa();
      allow list, create, update, delete: if documentoDeSuEmpresa();
    }
    match /TBL_FAC_OBSERVACIONES/{docId} {
      allow get: if resource == null || documentoDeSuEmpresa();
      allow list, create, update, delete: if documentoDeSuEmpresa();
    }
    match /TBL_FAC_AUTORIZACIONES/{docId} {
      allow get: if resource == null || documentoDeSuEmpresa();
      allow list, create, update, delete: if documentoDeSuEmpresa();
    }
    function rolRutas(empresaId) {
      let path = /databases/$(database)/documents/TBL_RUTAS_ROLES/$(empresaId + '_' + request.auth.token.userDocId);
      return exists(path) ? estadoTexto(get(path).data.get('rol', '')) : '';
    }
    function rutasConRol(empresaId, roles) {
      return belongsToCompany(empresaId)
        && (rolRutas(empresaId) in roles
          || isDeveloper() || isDeveloperIn(empresaId));
    }
    function participaEnRutas(empresaId) {
      return rutasConRol(empresaId, ['conductor', 'calidad', 'admin',
        'admin_calidad', 'desarrollador', 'developer']);
    }
    function administraRutas(empresaId) {
      return rutasConRol(empresaId,
        ['admin', 'admin_calidad', 'desarrollador', 'developer']);
    }
    function revisaRutas(empresaId) {
      return rutasConRol(empresaId,
        ['calidad', 'admin_calidad', 'desarrollador', 'developer']);
    }
    function conduceRutas(empresaId) {
      return rutasConRol(empresaId, ['conductor', 'desarrollador', 'developer']);
    }
    function desarrolloRutas(empresaId) {
      return rutasConRol(empresaId, ['desarrollador', 'developer']);
    }
    function asignaRolRutas(empresaId, userId, antes, despues) {
      return belongsToCompany(empresaId)
        && ((!(antes in ['desarrollador', 'developer'])
            && !(despues in ['desarrollador', 'developer'])
            && (tieneAppAdminEn(empresaId)
              || (userId != request.auth.token.userDocId
                && rolRutas(empresaId) in ['admin', 'admin_calidad'])))
          || isDeveloper() || isDeveloperIn(empresaId));
    }
    function empresaSeConserva() {
      return resource.data.empresaId == request.resource.data.empresaId;
    }
    match /TBL_RUTAS_ROLES/{docId} {
      allow get: if resource == null || belongsToCompany(resource.data.empresaId);
      allow list: if belongsToCompany(resource.data.empresaId);
      allow create: if docId == request.resource.data.empresaId + '_'
          + request.resource.data.userId
        && request.resource.data.rol in ['', 'conductor', 'calidad', 'admin',
          'admin_calidad', 'desarrollador']
        && asignaRolRutas(request.resource.data.empresaId,
          request.resource.data.userId, request.resource.data.rol,
          request.resource.data.rol);
      allow update: if empresaSeConserva()
        && resource.data.get('userId', '') == request.resource.data.userId
        && request.resource.data.rol in ['', 'conductor', 'calidad', 'admin',
          'admin_calidad', 'desarrollador']
        && asignaRolRutas(resource.data.empresaId, request.resource.data.userId,
          resource.data.get('rol', ''), request.resource.data.rol);
      allow delete: if asignaRolRutas(resource.data.empresaId,
        resource.data.get('userId', ''), resource.data.get('rol', ''),
        resource.data.get('rol', ''));
    }
    match /TBL_RUTAS/{docId} {
      allow get: if resource == null || belongsToCompany(resource.data.empresaId);
      allow list: if belongsToCompany(resource.data.empresaId);
      allow create: if administraRutas(request.resource.data.empresaId);
      allow update: if empresaSeConserva()
        && administraRutas(resource.data.empresaId);
      allow delete: if administraRutas(resource.data.empresaId);
    }
    match /TBL_RUTAS_ESTABLECIMIENTOS/{docId} {
      allow get: if resource == null || belongsToCompany(resource.data.empresaId);
      allow list: if belongsToCompany(resource.data.empresaId);
      allow create: if administraRutas(request.resource.data.empresaId);
      allow update: if empresaSeConserva()
        && administraRutas(resource.data.empresaId);
      allow delete: if administraRutas(resource.data.empresaId);
    }
    match /TBL_RUTAS_PLACAS/{docId} {
      allow get: if resource == null || belongsToCompany(resource.data.empresaId);
      allow list: if belongsToCompany(resource.data.empresaId);
      allow create: if administraRutas(request.resource.data.empresaId);
      allow update: if empresaSeConserva()
        && administraRutas(resource.data.empresaId);
      allow delete: if false;
    }
    match /TBL_RUTAS_CONFIG/{empresaId} {
      allow get: if resource == null || belongsToCompany(empresaId);
      allow create: if belongsToCompany(empresaId)
        && request.resource.data.empresaId == empresaId;
      allow update: if request.resource.data.empresaId == empresaId
        && administraRutas(empresaId);
      allow delete: if false;
    }
    function cierreDeAsignacionPorRetiro() {
      let cambios = request.resource.data.diff(resource.data).affectedKeys();
      let d = request.resource.data;
      return (d.activa == false
          && d.get('cerradaPor', '') == 'inhabilitacion_talento_humano'
          && cambios.hasOnly(['activa', 'vigenteHasta', 'cerradaPor',
            'cerradaCedula']))
        || (d.get('ayudanteCedula', '') == ''
          && d.get('ayudanteRetiradoPor', '') == 'inhabilitacion_talento_humano'
          && cambios.hasOnly(['ayudanteCedula', 'ayudanteNombre',
            'ayudanteRetiradoPor', 'ayudanteRetiradoAt']));
    }
    match /TBL_RUTAS_ASIGNACIONES/{docId} {
      allow get: if resource == null || belongsToCompany(resource.data.empresaId);
      allow list: if belongsToCompany(resource.data.empresaId);
      allow create: if administraRutas(request.resource.data.empresaId);
      allow update: if empresaSeConserva()
        && ((cierreDeAsignacionPorRetiro()
            && belongsToCompany(resource.data.empresaId))
          || administraRutas(resource.data.empresaId));
      allow delete: if false;
    }
    function evidenciaDelConductor() {
      return request.resource.data.estado == 'pendiente'
        && request.resource.data.createdBy == request.auth.token.userDocId;
    }
    function revisionDeEvidencia() {
      return request.resource.data.estado in ['aprobada', 'rechazada']
        && request.resource.data.revisadoPor == request.auth.token.userDocId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['estado', 'revisadoPor', 'revisadoEn', 'motivoRechazo']);
    }
    match /TBL_RUTAS_EVIDENCIAS/{docId} {
      allow get: if resource == null || participaEnRutas(resource.data.empresaId);
      allow list: if participaEnRutas(resource.data.empresaId);
      allow create: if evidenciaDelConductor()
        && conduceRutas(request.resource.data.empresaId);
      allow update: if empresaSeConserva()
        && ((resource.data.estado == 'rechazada'
            && evidenciaDelConductor()
            && conduceRutas(resource.data.empresaId))
          || (revisionDeEvidencia() && revisaRutas(resource.data.empresaId)));
      allow delete: if desarrolloRutas(resource.data.empresaId);
    }
    match /TBL_RUTAS_RESUMEN_DIARIO/{docId} {
      allow get: if resource == null || participaEnRutas(resource.data.empresaId);
      allow list: if participaEnRutas(resource.data.empresaId);
      allow create, update: if false;
      allow delete: if desarrolloRutas(resource.data.empresaId);
    }
    match /TBL_RUTAS_UBICACIONES/{docId} {
      allow get: if resource == null
        || (resource.data.userId == request.auth.token.userDocId
          && belongsToCompany(resource.data.empresaId))
        || administraRutas(resource.data.empresaId);
      allow list: if administraRutas(resource.data.empresaId);
      allow create, update: if request.resource.data.userId == request.auth.token.userDocId
        && docId == request.resource.data.empresaId + '_'
          + request.auth.token.userDocId
        && (resource == null || empresaSeConserva())
        && participaEnRutas(request.resource.data.empresaId);
      allow delete: if false;
    }
    match /TBL_RUTAS_MOV_CONFIG/{empresaId} {
      allow get: if resource == null || administraRutas(empresaId);
      allow create, update: if request.resource.data.empresaId == empresaId
        && administraRutas(empresaId);
      allow delete: if false;
    }
    match /TBL_RUTAS_MOV_HORARIOS/{docId} {
      allow get: if resource == null || administraRutas(resource.data.empresaId);
      allow list: if administraRutas(resource.data.empresaId);
      allow create: if administraRutas(request.resource.data.empresaId);
      allow update: if empresaSeConserva()
        && administraRutas(resource.data.empresaId);
      allow delete: if administraRutas(resource.data.empresaId);
    }
    match /TBL_RUTAS_MOV_MEDICIONES/{docId} {
      allow get: if resource == null || administraRutas(resource.data.empresaId);
      allow list: if administraRutas(resource.data.empresaId);
      allow create, update: if false;
      allow delete: if administraRutas(resource.data.empresaId);
    }
    match /TBL_RUTAS_MOV_RUNS/{docId} {
      allow get: if resource == null || administraRutas(resource.data.empresaId);
      allow list: if administraRutas(resource.data.empresaId);
      allow create, update: if false;
      allow delete: if administraRutas(resource.data.empresaId);
    }
    function tieneAppDeListaEn(empresaId, apps) {
      let u = currentUser();
      let detalle = u.get('empresasDetalle', {});
      let bloque = detalle is map ? detalle.get(empresaId, {}) : {};
      let propias = bloque is map ? bloque.get('apps', null) : null;
      let raiz = u.get('apps', []);
      return !(bloque is map && bloque.get('soloTalentoHumano', false) == true)
        && (u.get('appsPorEmpresa', false) == true
          ? (propias is list ? propias.hasAny(apps)
            : (raizEsDeEmpresa(u, empresaId) && raiz is list && raiz.hasAny(apps)))
          : ((raiz is list && raiz.hasAny(apps))
            || (propias is list && propias.hasAny(apps))));
    }
    function tieneAppTareasEn(empresaId) {
      return tieneAppDeListaEn(empresaId, ['tareasdashboard', 'tareas']);
    }
    function tieneAppOrigenTareaEn(empresaId, modulo) {
      return (modulo == 'interventoria'
          && tieneAppDeListaEn(empresaId, ['interventoriadashboard', 'interventoria']))
        || (modulo == 'compras' && tieneAppComprasEn(empresaId))
        || (modulo == 'facturacion'
          && tieneAppDeListaEn(empresaId, ['facturaciondashboard', 'facturacion']))
        || (modulo in ['visita', 'visitas']
          && tieneAppDeListaEn(empresaId, ['visitasdashboard', 'visitas']))
        || (modulo in ['correo', 'gestion_documental']
          && tieneAppCorreoEn(empresaId));
    }
    function puedeVerEquipoTareasEn(empresaId) {
      let u = currentUser();
      let detalle = u.get('empresasDetalle', {});
      let bloque = detalle is map ? detalle.get(empresaId, {}) : {};
      let propio = bloque is map ? bloque.get('puedeVerEquipo', null) : null;
      let raiz = raizEsDeEmpresa(u, empresaId)
        ? u.get('puedeVerEquipo', null) : null;
      let cargo = bloque is map ? bloque.get('cargo', '') : '';
      return propio is bool ? propio
        : (raiz is bool ? raiz
          : (esGerenciaPorFicha(empresaId)
            || (cargo is string && cargo.lower().matches('.*(director|jefe|coordinador|supervisor|gerente|gerencia).*'))));
    }
    function usuarioActivoParaTarea(empresaId, uid) {
      let path = /databases/$(database)/documents/TBL_USUARIOS/$(uid);
      let u = exists(path) ? get(path).data : {};
      let empresas = u.get('empresas', []);
      let detalle = u.get('empresasDetalle', {});
      let bloque = detalle is map ? detalle.get(empresaId, {}) : {};
      return uid is string && uid.size() > 0 && exists(path)
        && ((empresas is list && empresaId in empresas)
          || (detalle is map && empresaId in detalle)
          || u.get('empresaId', '') == empresaId
          || u.get('empresa', '') == empresaId)
        && !(bloque is map && bloque.get('soloTalentoHumano', false) == true)
        && habilitadaEn(u, empresaId);
    }
    function esResponsableTarea(data) {
      return data.get('asignado_uid', data.get('assignedTo', ''))
        == request.auth.token.userDocId;
    }
    function esAprobadorTarea(data) {
      let uid = request.auth.token.userDocId;
      return data.get('aprobador_uid', data.get('approverId', '')) == uid
        || data.get('jefe_uid', data.get('bossId', '')) == uid
        || data.get('creador_id', data.get('creatorId', '')) == uid;
    }
    function esParticipanteTarea(data) {
      let uid = request.auth.token.userDocId;
      return esResponsableTarea(data) || esAprobadorTarea(data)
        || data.get('reasignada_desde_uid', '') == uid
        || uid in data.get('participantes_uid', []);
    }
    function puedeLeerTarea(data) {
      let empresaId = data.get('empresaId', '');
      let modulo = data.get('sourceModule', '');
      return (belongsToCompany(empresaId)
          && ((tieneAppTareasEn(empresaId)
              && (esParticipanteTarea(data) || puedeVerEquipoTareasEn(empresaId)))
            || (modulo == 'interventoria'
              && tieneAppOrigenTareaEn(empresaId, modulo))
            || (esParticipanteTarea(data)
              && tieneAppOrigenTareaEn(empresaId, modulo))
            || tieneAppAdminEn(empresaId)
            || isDeveloperIn(empresaId)
            || (tieneAppDeListaEn(empresaId, ['gerenciadashboard', 'gerencia'])
              && esGerenciaPorFicha(empresaId))))
        || isDeveloper();
    }
    function puedeOperarTarea(data) {
      let empresaId = data.get('empresaId', '');
      let modulo = data.get('sourceModule', '');
      return belongsToCompany(empresaId)
        && ((modulo != 'tareas' && tieneAppOrigenTareaEn(empresaId, modulo))
          || tieneAppDeListaEn(empresaId,
            ['tareasdashboard', 'tareas', 'admindashboard', 'admin'])
          || isDeveloper() || isDeveloperIn(empresaId));
    }
    function tareaBaseConservada(antes, d, cambios) {
      return antes.get('empresaId', '') == d.get('empresaId', '')
        && !cambios.hasAny([
          'empresaId', 'empresas', 'creador_id', 'creatorId',
          'sourceModule', 'source',
          'sourceType', 'origen', 'hallazgoId', 'sourceEntityId', 'numero'
        ]);
    }
    function tareaNuevaValida() {
      let d = request.resource.data;
      let empresaId = d.get('empresaId', '');
      let modulo = d.get('sourceModule', '');
      return d.get('titulo', '') is string && d.titulo.size() > 0
        && !d.keys().hasAny(['numero'])
        && d.get('estado', '') in ['pendiente', 'en_progreso']
        && d.get('status', d.estado) == d.estado
        && d.get('creador_id', '') is string
        && d.creador_id.size() > 0
        && belongsToCompany(empresaId)
        && ((d.creador_id == request.auth.token.userDocId
            && tieneAppTareasEn(empresaId))
          || tieneAppOrigenTareaEn(empresaId, modulo)
          || tieneAppAdminEn(empresaId)
          || isDeveloper() || isDeveloperIn(empresaId))
        && usuarioActivoParaTarea(empresaId, d.get('asignado_uid', ''));
    }
    function tareaConservaParticipantes(antes, d) {
      let anterior = antes.get('asignado_uid', '');
      let nuevo = d.get('asignado_uid', '');
      return anterior != nuevo
        && d.get('participantes_uid', []) is list
        && d.participantes_uid.hasAll(antes.get('participantes_uid', []))
        && anterior in d.participantes_uid
        && nuevo in d.participantes_uid;
    }
    function tareaCambioResponsable(antes, d) {
      return tareaConservaParticipantes(antes, d)
        && usuarioActivoParaTarea(antes.get('empresaId', ''),
          d.get('asignado_uid', ''));
    }
    function tareaCambioOperativo(antes, d, evento, cambios) {
      let actual = antes.get('estado', antes.get('status', ''));
      return evento in ['task_avance', 'task_novedad',
          'solicitud_finalizacion', 'solicitud_reasignacion']
        && esResponsableTarea(antes)
        && !(actual in ['finalizado', 'por_aprobar'])
        && antes.get('solicitud_reasignacion_estado', '') != 'pendiente'
        && d.get('asignado_uid', '') == antes.get('asignado_uid', '')
        && (
          (evento == 'task_avance'
            && d.get('estado', actual) in [actual, 'en_progreso']
            && cambios.hasOnly(['estado', 'status', 'fecha_limite', 'dueDate',
              'updatedAt', 'fecha_actualizacion', 'actualizada_en',
              'lastEventType', 'lastEventAt', 'lastEventText']))
          || (evento == 'task_novedad'
            && d.get('estado', actual) in [actual, 'en_progreso']
            && cambios.hasOnly(['estado', 'status', 'updatedAt',
              'fecha_actualizacion', 'actualizada_en', 'lastEventType',
              'lastEventAt', 'lastEventText']))
          || (evento == 'solicitud_finalizacion'
            && antes.get('solicitud_finalizacion_estado', '') != 'pendiente'
            && d.get('estado', '') == 'por_aprobar'
            && d.get('solicitud_finalizacion_estado', '') == 'pendiente'
            && d.get('solicitud_finalizacion_by_uid', '')
              == request.auth.token.userDocId
            && cambios.hasOnly(['estado', 'status',
              'solicitud_finalizacion_estado', 'solicitud_finalizacion_at',
              'solicitud_finalizacion_by_uid',
              'solicitud_finalizacion_by_nombre', 'lastEventType',
              'lastEventAt', 'lastEventText', 'fecha_actualizacion',
              'updatedAt', 'actualizada_en', 'adjuntos', 'evidencias']))
          || (evento == 'solicitud_reasignacion'
            && antes.get('solicitud_reasignacion_estado', '') != 'pendiente'
            && d.get('solicitud_reasignacion_estado', '') == 'pendiente'
            && d.get('solicitud_reasignacion_by_uid', '')
              == request.auth.token.userDocId
            && d.get('solicitud_reasignacion_to_uid', '')
              != antes.get('asignado_uid', '')
            && cambios.hasOnly(['solicitud_reasignacion_estado',
              'solicitud_reasignacion_at', 'solicitud_reasignacion_by_uid',
              'solicitud_reasignacion_by_nombre',
              'solicitud_reasignacion_to_uid',
              'solicitud_reasignacion_to_nombre',
              'solicitud_reasignacion_areaId',
              'solicitud_reasignacion_areaNombre',
              'solicitud_reasignacion_cargoId',
              'solicitud_reasignacion_cargoNombre', 'updatedAt',
              'lastEventType', 'lastEventAt', 'lastEventText'])
            && usuarioActivoParaTarea(antes.get('empresaId', ''),
              d.get('solicitud_reasignacion_to_uid', '')))
        );
    }
    function tareaReasignacionDirecta(antes, d, evento, cambios) {
      let actual = antes.get('estado', antes.get('status', ''));
      return evento == 'reasignacion_directa'
        && (antes.get('sourceModule', '') == 'interventoria'
          || antes.get('origen', '') == 'interventoria')
        && esResponsableTarea(antes)
        && !(actual in ['finalizado', 'por_aprobar'])
        && antes.get('solicitud_finalizacion_estado', '') != 'pendiente'
        && d.get('estado', '') == 'en_progreso'
        && d.get('reasignada_por_uid', '') == request.auth.token.userDocId
        && d.get('reasignada_desde_uid', '') == antes.get('asignado_uid', '')
        && cambios.hasOnly(['asignado_uid', 'asignado_nombre',
          'asignado_cargo_nombre', 'areaId', 'estado', 'status',
          'reasignado', 'reasignada_en', 'reasignada_desde_uid',
          'reasignada_desde_nombre', 'reasignada_por_uid',
          'participantes_uid', 'reasignacion_pendiente',
          'solicitud_reasignacion_estado', 'solicitud_reasignacion_at',
          'solicitud_reasignacion_by_uid',
          'solicitud_reasignacion_by_nombre',
          'solicitud_reasignacion_to_uid',
          'solicitud_reasignacion_to_nombre',
          'solicitud_reasignacion_areaId',
          'solicitud_reasignacion_areaNombre',
          'solicitud_reasignacion_cargoId',
          'solicitud_reasignacion_cargoNombre', 'updatedAt',
          'fecha_actualizacion', 'actualizada_en', 'lastEventType',
          'lastEventAt', 'lastEventText'])
        && tareaCambioResponsable(antes, d);
    }
    function tareaCambioAprobador(antes, d, evento, cambios) {
      return evento in ['aprobada', 'task_devuelta', 'reasignacion_aprobada',
          'reasignacion_rechazada', 'task_avance_gestionado']
        && esAprobadorTarea(antes)
        && (
          (evento == 'aprobada'
            && antes.get('solicitud_finalizacion_estado', '') == 'pendiente'
            && d.get('estado', '') == 'finalizado'
            && d.get('solicitud_finalizacion_estado', '') == 'aprobado'
            && d.get('asignado_uid', '') == antes.get('asignado_uid', '')
            && cambios.hasOnly(['estado', 'status', 'approved',
              'approvedAt', 'solicitud_finalizacion_estado',
              'updatedAt', 'lastEventType', 'lastEventAt', 'lastEventText']))
          || (evento == 'task_devuelta'
            && antes.get('solicitud_finalizacion_estado', '') == 'pendiente'
            && d.get('estado', '') == 'devuelta'
            && d.get('asignado_uid', '') == antes.get('asignado_uid', '')
            && cambios.hasOnly(['estado', 'status', 'fecha_limite',
              'approved', 'approvedAt', 'solicitud_finalizacion_estado',
              'solicitud_finalizacion_at', 'solicitud_finalizacion_by_uid',
              'solicitud_finalizacion_by_nombre', 'updatedAt',
              'lastEventType', 'lastEventAt', 'lastEventText']))
          || (evento == 'reasignacion_aprobada'
            && antes.get('solicitud_reasignacion_estado', '') == 'pendiente'
            && d.get('solicitud_reasignacion_estado', '') == 'aprobada'
            && d.get('asignado_uid', '')
              == antes.get('solicitud_reasignacion_to_uid', '')
            && d.get('estado', '') == 'en_progreso'
            && cambios.hasOnly(['asignado_uid', 'asignado_nombre',
              'asignado_cargo_id', 'asignado_cargo_nombre', 'areaId',
              'estado', 'status', 'reasignado',
              'solicitud_reasignacion_estado', 'reasignacion_resuelta_at',
              'participantes_uid', 'lastEventType', 'lastEventAt',
              'updatedAt', 'lastEventText', 'jefe_uid', 'jefe_nombre',
              'aprobador_uid', 'aprobador_nombre', 'approverId',
              'approverName'])
            && tareaConservaParticipantes(antes, d))
          || (evento == 'reasignacion_rechazada'
            && antes.get('solicitud_reasignacion_estado', '') == 'pendiente'
            && d.get('solicitud_reasignacion_estado', '') == 'rechazada'
            && d.get('asignado_uid', '') == antes.get('asignado_uid', '')
            && cambios.hasOnly(['solicitud_reasignacion_estado',
              'reasignacion_resuelta_at', 'lastEventType',
              'lastEventAt', 'updatedAt', 'lastEventText']))
          || (evento == 'task_avance_gestionado'
            && d.get('asignado_uid', '') == antes.get('asignado_uid', '')
            && cambios.hasOnly(['fecha_limite', 'updatedAt',
              'lastEventType', 'lastEventAt', 'lastEventText']))
        );
    }
    function tareaCambioModulo(antes, d, cambios) {
      return antes.get('sourceModule', '') == 'interventoria'
        && (
          (antes.get('sourceType', '') == 'devolucion_acta'
            && esResponsableTarea(antes)
            && d.get('estado', '') == 'finalizado'
            && cambios.hasOnly(['estado', 'status',
              'solicitud_finalizacion_estado', 'updatedAt']))
          || (d.get('solicitud_finalizacion_resuelto_por', '')
              == request.auth.token.userDocId
            && esAprobadorTarea(antes)
            && d.get('estado', '') in ['finalizado', 'devuelta']
            && d.get('solicitud_finalizacion_estado', '')
              == (d.estado == 'finalizado' ? 'aprobado' : 'rechazado')
            && cambios.hasOnly(['estado', 'status',
              'solicitud_finalizacion_estado',
              'solicitud_finalizacion_resuelto_por', 'updatedAt']))
        )
        && tieneAppOrigenTareaEn(antes.get('empresaId', ''), 'interventoria');
    }
    function tareaVisto(antes, cambios) {
      return cambios.hasOnly(['visto'])
        && (esParticipanteTarea(antes)
          || puedeVerEquipoTareasEn(antes.get('empresaId', '')));
    }
    function tareaMantenimiento(antes, d, evento, cambios) {
      let empresaId = antes.get('empresaId', '');
      return d.get('empresaId', '') == empresaId
        && belongsToCompany(empresaId)
        && (isDeveloper() || isDeveloperIn(empresaId)
          || (evento == 'admin_module_closeout' && tieneAppAdminEn(empresaId))
          || (antes.get('sourceModule', '') == 'interventoria'
            && d.get('creador_id', '') == 'interventoria_automatica'
            && cambios.hasOnly(['creador_id', 'creatorId', 'creador_nombre',
              'creatorName', 'ejecutadoPorId', 'ejecutadoPorNombre'])
            && rolEnTabla('TBL_INTERVENTORIA_ROLES', empresaId)
              in ['admin_interventoria', 'gerente_interventoria']));
    }
    function tareaActualizacionValida() {
      let antes = resource.data;
      let d = request.resource.data;
      let evento = d.get('lastEventType', '');
      let cambios = d.diff(antes).affectedKeys();
      return (tareaBaseConservada(antes, d, cambios)
          && (tareaCambioOperativo(antes, d, evento, cambios)
            || tareaReasignacionDirecta(antes, d, evento, cambios)
            || tareaCambioAprobador(antes, d, evento, cambios)
            || tareaCambioModulo(antes, d, cambios)
            || tareaVisto(antes, cambios))
          && puedeOperarTarea(antes))
        || tareaMantenimiento(antes, d, evento, cambios);
    }
    function puedeLeerEventoTarea(taskId) {
      let path = /databases/$(database)/documents/TBL_TAREAS/$(taskId);
      return exists(path) && puedeLeerTarea(get(path).data);
    }
    function puedeCrearEventoTarea(taskId, tipo) {
      let path = /databases/$(database)/documents/TBL_TAREAS/$(taskId);
      let tarea = exists(path) ? get(path).data : {};
      let evento = request.resource.data;
      let uid = request.auth.token.userDocId;
      return exists(path)
        && ((tipo == 'avances'
            && evento.get('by', '') == uid
            && evento.get('message', '') is string
            && evento.message.size() > 0
            && esResponsableTarea(tarea))
          || (tipo == 'novedades'
            && ((evento.get('by', '') == uid && esResponsableTarea(tarea))
              || (evento.get('type', '') in ['devolucion', 'respuesta_avance']
                && esAprobadorTarea(tarea))
              || (evento.get('type', '') == 'respuesta_novedad'
                && evento.get('by', '') == uid
                && evento.get('message', '') is string
                && evento.message.size() > 0
                && esAprobadorTarea(tarea))))
          || (tipo == 'finalizacion'
            && evento.get('createdBy', '') == uid
            && ((evento.get('type', '') in ['solicitud_finalizacion', 'finalizacion']
                && evento.get('comment', '') is string
                && evento.comment.trim().size() > 0
                && esResponsableTarea(tarea)
                && (evento.type == 'solicitud_finalizacion'
                  ? (tarea.get('solicitud_finalizacion_estado', '') != 'pendiente'
                    && getAfter(path).data.get('solicitud_finalizacion_estado', '') == 'pendiente')
                  : (tarea.get('estado', '') != 'finalizado'
                    && getAfter(path).data.get('estado', '') == 'finalizado')))
              || (evento.get('type', '') == 'aprobacion_finalizacion'
                && esAprobadorTarea(tarea)
                && tarea.get('solicitud_finalizacion_estado', '') == 'pendiente'
                && getAfter(path).data.get('estado', '') == 'finalizado'
                && getAfter(path).data.get('solicitud_finalizacion_estado', '') == 'aprobado'))))
        && puedeOperarTarea(tarea);
    }
    match /TBL_TAREAS/{taskId} {
      allow get: if isSignedIn() && (resource == null || puedeLeerTarea(resource.data));
      allow list: if puedeLeerTarea(resource.data);
      allow create: if tareaNuevaValida();
      allow update: if tareaActualizacionValida();
      allow delete: if belongsToCompany(resource.data.get('empresaId', ''))
        && (tieneAppAdminEn(resource.data.empresaId)
          || isDeveloper() || isDeveloperIn(resource.data.empresaId)
          || (resource.data.get('sourceModule', '') == 'interventoria'
            && resource.data.get('estado', '') != 'finalizado'
            && tieneAppOrigenTareaEn(resource.data.empresaId, 'interventoria')
            && hasInterventoriaRole(resource.data.empresaId,
              ['admin_interventoria', 'gerente_interventoria'])));
      match /{tipo}/{eventoId} {
        allow read: if tipo in ['avances', 'novedades', 'finalizacion']
          && puedeLeerEventoTarea(taskId);
        allow create: if tipo in ['avances', 'novedades', 'finalizacion']
          && puedeCrearEventoTarea(taskId, tipo);
        allow update, delete: if false;
      }
    }
    match /{collection}/{document=**} {
      allow read, write: if isSignedIn()
        && !esColeccionCompras(collection)
        && !(collection in [
          'TBL_TAREAS',
          'TBL_TAREAS_CONTADORES',
          'TBL_COMPRAS_ROLES','TBL_COMPRAS_CONFIG',
          'TBL_WHATSAPP_CONFIG',
          'TBL_WHATSAPP_AUDITORIA','TBL_WHATSAPP_META_ESTADOS',
          'TBL_CORREO_ALERTAS',
          'TBL_CORREO_LISTADOS',
          'TBL_CORREO_REGLAS',
          'TBL_GD_EXPEDIENTES',
          'TBL_INTERVENTORIA_VISITAS',
          'TBL_INTERVENTORIA_PLANES',
          'TBL_INTERVENTORIA_PLAN_ITEMS',
          'TBL_INTERVENTORIA_HALLAZGOS',
          'TBL_INTERVENTORIA_ROLES',
          'TBL_INTERVENTORIA_CONFIG',
          'TBL_INTERVENTORIA_SOLICITUDES_ELIMINACION',
          'TBL_INTERVENTORIA_CONCEPTOS_SANITARIOS',
          'TBL_VISITAS',
          'TBL_VISITAS_FORMATOS',
          'TBL_VISITAS_ROLES',
          'TBL_VISITAS_UBICACIONES',
          'TBL_VISITAS_GRUPOS',
          'TBL_VISITAS_ESTABLECIMIENTOS',
          'TBL_VISITAS_CONTADORES',
          'TBL_CORREO_ROLES',
          'TBL_ROLES',
          'TBL_MIGRATIONS_LOGS',
          'TBL_GD_TIPOS_DOCUMENTALES',
          'TBL_GD_EXPEDIENTES_EVENTOS',
          'TBL_GD_COLABORACION',
          'TBL_GD_VINCULOS',
          'TBL_GD_CONTADORES',
          'TBL_DIAN_TOKENS',
          'TBL_DIAN_TOKEN_ACCESOS',
          'TBL_DIAN_TOKEN_CONFIG',
          'TBL_DIAN_TOKEN_ROLES',
          'TBL_TALENTO_HUMANO_ROLES',
          'TBL_NUTRICION_ROLES',
          'TBL_TH_REQUERIMIENTOS_PERSONAL',
          'TBL_LLAMADOS_ATENCION',
          'TBL_HISTORIAL_LLAMADOS_ATENCION',
          'TBL_AUTH_CREDENTIALS',
          'TBL_AUTH_LOGIN_ATTEMPTS',
          'TBL_AUTH_RECOVERY_CHALLENGES',
          'TBL_AUTH_ADMIN_AUDIT',
          'TBL_LOGIN_SESIONES',
          'TBL_PAGOS_BENEFICIARIOS',
          'TBL_PAGOS_BENEFICIARIOS_CUENTA',
          'TBL_RUTAS',
          'TBL_RUTAS_ROLES',
          'TBL_RUTAS_ESTABLECIMIENTOS',
          'TBL_RUTAS_PLACAS',
          'TBL_RUTAS_CONFIG',
          'TBL_RUTAS_ASIGNACIONES',
          'TBL_RUTAS_EVIDENCIAS',
          'TBL_RUTAS_RESUMEN_DIARIO',
          'TBL_RUTAS_UBICACIONES',
          'TBL_RUTAS_MOV_CONFIG',
          'TBL_RUTAS_MOV_HORARIOS',
          'TBL_RUTAS_MOV_MEDICIONES',
          'TBL_RUTAS_MOV_RUNS',
          'TBL_PACIENTES',
          'TBL_VALORACIONES_NUTRICION',
          'TBL_MEDICIONES_NUTRICION',
          'TBL_PATOLOGIAS',
          'TBL_DIETAS',
          'TBL_ASIGNACIONES_DIETA',
          'TBL_CARNETS_NUTRICION',
          'TBL_MENUS',
          'TBL_DERIVACIONES_NUTRICION',
          'TBL_ALERTAS_NUTRICION',
          'TBL_FIRMAS',
          'TBL_EVIDENCIAS_NUTRICION',
          'TBL_PLANTILLAS_MENUS',
          'TBL_INGREDIENTES',
          'TBL_DIRECTORIO_NUTRICION',
          'TBL_CITAS_NUTRICION',
          'TBL_EVALUACIONES_DIAGNOSTICAS',
           'TBL_HISTORIAL_NUTRICION',
          'TBL_FAC_CONFIG',
          'TBL_FAC_OBLIGACIONES',
          'TBL_FAC_ESTABLECIMIENTOS',
          'TBL_FAC_REVISIONES',
          'TBL_FAC_OBSERVACIONES',
          'TBL_FAC_AUTORIZACIONES'
        ]);
    }
  }
}
