<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ===== Permisos base ===== -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- ===== ID de publicidad: se elimina a proposito =====
         La cadena de medicion que arrastra firebase_messaging fusiona estos
         permisos en el manifiesto final aunque nunca los declaremos. La app no
         tiene publicidad ni atribucion, asi que se quitan para poder declarar
         "no usa ID de publicidad" en Play Console.
         Si algun dia se agrega Analytics o Ads, hay que borrar este bloque y
         actualizar la declaracion en Play. -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
        tools:node="remove" />

    <!-- ===== Permisos de medios de Android 13+: se eliminan a proposito =====
         file_picker e image_picker los fusionan en el manifiesto final aunque
         nunca los declaremos. En Android no hacen falta:
         - Las fotos se toman o se eligen con image_picker, que en Android 13+
           usa el selector de fotos del sistema y no requiere permiso.
         - Los dos FileType.image que quedan estan dentro de ramas if (kIsWeb),
           asi que en Android no se ejecutan nunca.
         - La app no maneja video ni archivos de audio en ningun flujo.
         Dejarlos obligaria a justificar el acceso a fotos y video ante Play sin
         que la app lo necesite. READ_EXTERNAL_STORAGE SI se conserva: sigue
         haciendo falta en Android 12 y anteriores, que es hasta donde baja
         minSdk 24. -->
    <uses-permission
        android:name="android.permission.READ_MEDIA_IMAGES"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_VIDEO"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_AUDIO"
        tools:node="remove" />

    <!-- Ubicación -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <!-- Cámara (image_picker) -->
    <uses-permission android:name="android.permission.CAMERA"/>

    <!-- Biometría (huella / rostro) para inicio de sesión -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>

    <!-- Micrófono (dictado de observaciones) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>

    <!-- Almacenamiento (solo para Android 28 o menos) -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"/>

    <!-- Notificaciones (Android 13+) -->
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS"
        tools:targetApi="33" />

    <!-- Recomendado para alarmas/servicios en background -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Sugerido por Google Maps (aceleración) -->
    <uses-feature
        android:glEsVersion="0x00020000"
        android:required="true" />

    <!-- Cámara opcional -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false"/>

    <application
        android:name="${applicationName}"
        android:label="To-Do Gestión"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="false">

        <!-- Precarga el flujo nativo de escaneo documental de ML Kit. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="document_ui" />

        <!-- ===== Flutter / Lanzador ===== -->
        <!-- OJO: nombre COMPLETO del Activity (ya no .MainActivity) -->
        <activity
            android:name="com.todogestion.app.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"/>

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <intent-filter>
                <action android:name="FLUTTER_NOTIFICATION_CLICK" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- ===== Notificaciones: canal por defecto (FCM) ===== -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="tasks_high" />

        <!-- ===== Google Maps SDK: API KEY ===== -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyD8posdo50hmD8PLPD9kR6IebNYfi6PkPs" />
    </application>

    <!-- ===== Consultas opcionales ===== -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>
</manifest>
