{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "integra360-94704",
          "appId": "1:379551786878:android:5ff74c61ef72e7ad84352f",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "integra360-94704",
          "configurations": {
            "android": "1:379551786878:android:5ff74c61ef72e7ad84352f",
            "ios": "1:379551786878:ios:1cc01e3191fe96af84352f",
            "macos": "1:379551786878:ios:b2f6d4777de370c884352f",
            "web": "1:379551786878:web:bfdce56a6b9454b984352f",
            "windows": "1:379551786878:web:54070bc61d206bb284352f"
          }
        }
      }
    }
  },
  "hosting": [
    {
      "site": "to-do-gestion",
      "public": "build/web",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/correo/procesar",
          "function": {
            "functionId": "correoProcesarHttp",
            "region": "us-central1"
          }
        },
        {
          "source": "/carnet/**",
          "function": {
            "functionId": "carnetPublico",
            "region": "us-central1"
          }
        },
        {
          "source": "/acerca",
          "destination": "/acerca.html"
        },
        {
          "source": "/privacidad",
          "destination": "/privacidad.html"
        },
        {
          "source": "/soporte",
          "destination": "/soporte.html"
        },
        {
          "source": "/terminos",
          "destination": "/terminos.html"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "/legal.css",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, max-age=0, must-revalidate"
            }
          ]
        },
        {
          "source": "/index.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/flutter_bootstrap.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, max-age=0, must-revalidate"
            }
          ]
        },
        {
          "source": "/flutter_service_worker.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, max-age=0, must-revalidate"
            }
          ]
        },
        {
          "source": "/main.dart.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, max-age=0, must-revalidate"
            }
          ]
        },
        {
          "source": "/firebase-messaging-sw.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, max-age=0, must-revalidate"
            }
          ]
        }
      ]
    }
  ],
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
